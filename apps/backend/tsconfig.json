{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2020",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@common/*": ["src/common/*"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "useDefineForClassFields": false,
    // [print-editor-dsk P1.6] Necesario para que el shim
    // `domains/store/print-formats/lib/page-geometry.ts` importe su JSON
    // hermano (`page-geometry.json`) bajo `module: commonjs`. Mobile ya
    // hereda esta flag de expo/tsconfig.base; frontend la activa en
    // `tsconfig.app.json`.
    "resolveJsonModule": true
  },
  "watchOptions": {
    "watchFile": "dynamicPriorityPolling",
    "watchDirectory": "dynamicPriorityPolling",
    "fallbackPolling": "fixedinterval",
    "synchronousWatchDirectory": false
  }
}
