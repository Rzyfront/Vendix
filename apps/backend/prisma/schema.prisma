// ===== DIAN ELECTRONIC INVOICING =====

enum dian_nit_type_enum {
  NIT
  CC
  CE
  TI
  PP
  NIT_EXTRANJERIA
}

enum dian_configuration_type_enum {
  invoicing
  support_document
  payroll
  /// Habilitación del software para documento equivalente electrónico
  /// (Res. 000165/2023). Separate from `invoicing` because the DIAN authorizes it
  /// with its own set de pruebas and its own enablement_status — one status must
  /// not speak for two independent authorizations.
  equivalent_document
}

enum dian_operation_mode_enum {
  own_software
  technological_provider
}

enum certificate_source_enum {
  manual_upload_validated
  issuer_adapter
}

/// QUI-657 — estado del certificado de firma EN NUESTRA MANO.
///
/// ORTOGONAL a `dian_enablement_status_enum`, que describe el estado ante la
/// DIAN. Un tenant puede estar `documents_submitted` acá y `not_started` allá:
/// son dos hechos independientes y mezclarlos hacía que "no tengo cert" se
/// leyera como "la DIAN me rechazó".
///
/// - `not_required`   → el tenant trae su propio `.p12` (rama "tengo cert").
///                      Es el default de toda fila histórica.
/// - `documents_pending`   → eligió la rama "no tengo cert", aún no envía docs.
/// - `documents_submitted` → cargó RUT + id (+ cert de existencia si jurídica)
///                           y está en la cola del superadmin.
/// - `issuing`        → superadmin tramita el cert ante la entidad emisora.
/// - `issued`         → cert cargado por el superadmin (`certificate_source =
///                      issuer_adapter`). Recién acá la emisión se desbloquea.
/// - `rejected`       → documentación insuficiente; el tenant debe reenviar.
enum certificate_provisioning_status_enum {
  not_required
  documents_pending
  documents_submitted
  issuing
  issued
  rejected
}

/// store_id is nullable to support organizations.fiscal_scope=ORGANIZATION,
/// where the DIAN config is anchored to the organization only (store_id IS NULL).
/// When fiscal_scope=STORE, store_id is required. The DB enforces:
///   - CHECK dian_configurations_scope_org_chk (organization_id NOT NULL)
///   - partial unique idx dian_configurations_store_scope_uq
///     (store_id, nit, configuration_type) WHERE store_id IS NOT NULL
///   - partial unique idx dian_configurations_org_scope_uq
///     (organization_id, nit, configuration_type) WHERE store_id IS NULL
/// configuration_type is part of the uniqueness key so the same accounting
/// entity may hold sibling rows for invoicing + support_document + payroll
/// without collisions. These partial unique indexes cannot be represented as
/// @@unique in Prisma; they live in migrations
/// 20260511160000_relax_dian_store_id_for_org_scope (original shape) and
/// 20260612120000_dian_configurations_uq_per_configuration_type
/// (configuration_type added to the key).
///
/// CONSEQUENCE FOR CALLERS: any "does this config already exist?" lookup made
/// before a create MUST filter by the same axis as the index above — never by
/// accounting_entity_id, which is narrower. A row written under a different
/// accounting entity stays invisible to an entity-filtered read while remaining
/// visible to the index: the caller concludes "does not exist", creates, and
/// Postgres answers P2002, which reaches the client as an opaque 500. This bit
/// all four create paths (platform upsert, vendor-support clone, store create,
/// org create) before 2026-08-05.
model dian_configurations {
  id                                   Int                                  @id @default(autoincrement())
  organization_id                      Int
  store_id                             Int?
  accounting_entity_id                 Int
  name                                 String                               @db.VarChar(100)
  nit                                  String                               @db.VarChar(20)
  nit_type                             dian_nit_type_enum                   @default(NIT)
  nit_dv                               String?                              @db.VarChar(1)
  is_default                           Boolean                              @default(false)
  configuration_type                   dian_configuration_type_enum         @default(invoicing)
  operation_mode                       dian_operation_mode_enum             @default(own_software)
  software_id                          String                               @db.VarChar(100)
  software_pin_encrypted               String                               @db.Text
  certificate_s3_key                   String?                              @db.Text
  certificate_password_encrypted       String?                              @db.Text
  /// ARN (or key-id) of the AWS KMS asymmetric RSA key holding the certificate's
  /// private half, non-exportable inside the HSM. When set, the XAdES signature is
  /// produced by KMS and the `.p12` private key is never touched. NULL keeps the
  /// historical custody: private key read from the `.p12` in process memory.
  /// Per-entity on purpose — a platform migrates one fiscal entity at a time.
  certificate_kms_key_id               String?                              @db.Text
  certificate_expiry                   DateTime?                            @db.Timestamp(6)
  certificate_fingerprint              String?                              @db.VarChar(128)
  certificate_subject                  String?                              @db.Text
  certificate_issuer                   String?                              @db.Text
  certificate_serial_number            String?                              @db.VarChar(128)
  certificate_nit                      String?                              @db.VarChar(20)
  certificate_source                   certificate_source_enum              @default(manual_upload_validated)
  /// QUI-657. Ver `certificate_provisioning_status_enum`. Ortogonal a
  /// `enablement_status`: este dice si TENEMOS el cert; aquel, si la DIAN
  /// habilitó la operación. El gate de emisión exige AMBOS.
  certificate_provisioning_status      certificate_provisioning_status_enum @default(not_required)
  certificate_uploaded_at              DateTime?                            @db.Timestamp(6)
  /// QUI-679 (review fix #6): id of the sibling `dian_configurations` row whose
  /// cert this row inherited. NULL means the cert was uploaded directly into
  /// THIS row (the historical case) — `certificate_source = manual_upload_validated`
  /// continues to mean "validated by a human". Self-reference is forbidden at the
  /// application layer (`id !== inherited_from_dian_configuration_id`); the DB
  /// does NOT enforce it because a row's id is assigned AFTER insert and a
  /// circular self-FK is a chicken-and-egg problem Postgres can't express in a
  /// CHECK. Nullable on purpose so every historical row stays at NULL.
  inherited_from_dian_configuration_id Int?
  environment                          dian_environment_enum                @default(test)
  enablement_status                    dian_enablement_status_enum          @default(not_started)
  test_set_id                          String?                              @db.VarChar(100)
  enablement_evidence                  Json?
  enabled_at                           DateTime?                            @db.Timestamp(6)
  last_test_result                     Json?
  created_at                           DateTime?                            @default(now()) @db.Timestamp(6)
  updated_at                           DateTime?                            @default(now()) @db.Timestamp(6)

  organization          organizations                  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  store                 stores?                        @relation(fields: [store_id], references: [id], onDelete: Cascade)
  accounting_entity     accounting_entities            @relation(fields: [accounting_entity_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  dian_audit_logs       dian_audit_logs[]
  fiscal_transmissions  fiscal_transmissions[]
  identity_documents    dian_configuration_documents[]
  /// SELF-FK with `ON DELETE SET NULL`: deleting the source row drops the
  /// pointer but NEVER deletes the inheritor (a cert copy must outlive the
  /// metadata of the row it was copied from). Cascade would be wrong — the
  /// inheritor has its OWN cert bytes in S3 and its OWN enablement_status.
  inherited_from_config dian_configurations?           @relation("dian_config_inheritance", fields: [inherited_from_dian_configuration_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  inherited_by_configs  dian_configurations[]          @relation("dian_config_inheritance")

  @@index([store_id])
  @@index([organization_id])
  @@index([accounting_entity_id, configuration_type])
  @@index([operation_mode, environment, enablement_status])
  @@index([inherited_from_dian_configuration_id])
}

/// QUI-657 — documentos de identidad que un tenant SIN certificado de firma
/// entrega para que la plataforma le tramite uno ante la entidad emisora.
///
/// CUELGA DE `dian_configurations`, NO DE `stores`, a propósito: `store_id` es
/// nullable por diseño (`organizations.fiscal_scope = 'ORGANIZATION'` ancla la
/// identidad fiscal a la organización y deja la tienda en NULL). Colgar de
/// `stores` dejaría sin hogar justo a las organizaciones de alcance-org, que
/// son las que más probablemente tramitan el cert de forma centralizada.
///
/// RETENCIÓN INDEFINIDA (decisión de producto, 2026-08-13): los documentos se
/// conservan en S3 sin TTL de limpieza. Son el respaldo de la identidad con la
/// que se expidió un certificado de firma; borrarlos rompería la trazabilidad
/// de una emisión fiscal que la DIAN puede auditar años después.
///
/// Se guarda la CLAVE S3, nunca una URL firmada (`vendix-s3-storage`): las URLs
/// se firman en cada lectura con vida corta.
model dian_configuration_documents {
  id                    Int      @id @default(autoincrement())
  dian_configuration_id Int
  /// `rut` | `id` | `certificate_of_existence`. Texto y no enum: el juego de
  /// documentos exigidos por la entidad emisora cambia por trámite y no merece
  /// una migración de enum cada vez.
  document_type         String   @db.VarChar(50)
  s3_key                String   @db.Text
  uploaded_by_user_id   Int?
  uploaded_at           DateTime @default(now()) @db.Timestamp(6)
  original_filename     String?  @db.VarChar(255)
  size_bytes            BigInt?
  mime_type             String?  @db.VarChar(100)

  dian_configuration dian_configurations @relation(fields: [dian_configuration_id], references: [id], onDelete: Cascade)
  uploaded_by        users?              @relation(fields: [uploaded_by_user_id], references: [id], onDelete: SetNull)

  @@index([dian_configuration_id])
  @@index([dian_configuration_id, document_type])
  @@map("dian_configuration_documents")
}

model dian_audit_logs {
  id                    Int       @id @default(autoincrement())
  dian_configuration_id Int
  action                String    @db.VarChar(100)
  document_type         String?   @db.VarChar(50)
  document_number       String?   @db.VarChar(50)
  request_xml           String?   @db.Text
  response_xml          String?   @db.Text
  status                String    @db.VarChar(20)
  error_message         String?   @db.Text
  cufe                  String?   @db.VarChar(255)
  duration_ms           Int?
  created_at            DateTime? @default(now()) @db.Timestamp(6)

  dian_configuration dian_configurations @relation(fields: [dian_configuration_id], references: [id], onDelete: Cascade)

  @@index([dian_configuration_id])
  @@index([action])
  @@index([created_at])
}

/// RADIAN / DIAN document events transmitted as `ApplicationResponse` through
/// `SendEventUpdateStatus`. One row per event emitted for a document:
/// 030 acuse de recibo, 031 reclamo, 032 recibo del bien/servicio,
/// 033 aceptación expresa, 034 aceptación tácita.
model dian_document_events {
  id                    Int       @id @default(autoincrement())
  organization_id       Int
  store_id              Int?
  invoice_id            Int
  dian_configuration_id Int?
  event_code            String    @db.VarChar(3)
  event_number          String?   @db.VarChar(50)
  /// CUDE of the ApplicationResponse itself.
  cude                  String?   @db.VarChar(255)
  /// CUFE of the referenced invoice, denormalized so the event stays diagnosable.
  referenced_cufe       String?   @db.VarChar(255)
  status                String    @default("pending") @db.VarChar(20)
  dian_status_code      String?   @db.VarChar(20)
  dian_status_message   String?
  request_xml           String?
  response_xml          String?
  issued_at             DateTime? @db.Timestamp(6)
  created_at            DateTime? @default(now()) @db.Timestamp(6)
  updated_at            DateTime? @default(now()) @db.Timestamp(6)

  invoice      invoices      @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  store        stores?       @relation(fields: [store_id], references: [id], onDelete: SetNull)

  @@index([invoice_id, event_code])
  @@index([status, created_at])
  @@index([organization_id, store_id])
}

/// Traza de reenvíos/entregas de una factura ya emitida (E.6, POST /:id/deliver).
/// Deliberadamente NO reutiliza `dian_document_events`: `event_code` ahí es el
/// vocabulario normativo RADIAN (Res. 000085/2022: 030/031/032/033/034) y mezclar
/// una entrega por correo en esa tabla contaminaría el histórico fiscal que el
/// panel RADIAN lee tal cual. `invoice_id` usa `onDelete: Cascade` a propósito:
/// `invoices.remove()` sólo permite borrar facturas en `draft`, y esta tabla sólo
/// se escribe para facturas fuera de `draft` (`INVOICING_DELIVERY_002` bloquea el
/// reenvío de un borrador) — los dos estados son mutuamente excluyentes, así que
/// el CASCADE nunca se dispara sobre una fila con historial de entrega real.
model invoice_delivery_events {
  id              Int       @id @default(autoincrement())
  invoice_id      Int
  organization_id Int
  store_id        Int?
  channel         String    @db.VarChar(20)
  recipient       String    @db.VarChar(320)
  zip_name        String?   @db.VarChar(255)
  status          String    @default("sent") @db.VarChar(20)
  provider_error  String?
  created_by      Int?
  created_at      DateTime? @default(now()) @db.Timestamp(6)

  invoice      invoices      @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  store        stores?       @relation(fields: [store_id], references: [id], onDelete: SetNull)

  @@index([invoice_id, created_at])
  @@index([status, created_at])
}

model fiscal_transmissions {
  id                    Int                             @id @default(autoincrement())
  organization_id       Int
  store_id              Int?
  accounting_entity_id  Int
  dian_configuration_id Int?
  document_type         fiscal_document_type_enum
  source_type           String                          @db.VarChar(50)
  source_id             Int
  document_number       String                          @db.VarChar(50)
  idempotency_key       String                          @db.VarChar(160)
  request_hash          String?                         @db.VarChar(128)
  xml_hash              String?                         @db.VarChar(128)
  zip_hash              String?                         @db.VarChar(128)
  tracking_id           String?                         @db.VarChar(255)
  cufe                  String?                         @db.VarChar(255)
  cude                  String?                         @db.VarChar(255)
  cuds                  String?                         @db.VarChar(255)
  cune                  String?                         @db.VarChar(255)
  qr_code               String?
  xml_document          String?                         @db.Text
  pdf_url               String?                         @db.Text
  transmission_status   fiscal_transmission_status_enum @default(queued)
  dian_status           dian_document_status_enum       @default(pending)
  accounting_status     fiscal_accounting_status_enum   @default(blocked)
  provider_response     Json?
  error_code            String?                         @db.VarChar(100)
  error_message         String?                         @db.Text
  retry_count           Int                             @default(0)
  last_retry_at         DateTime?                       @db.Timestamp(6)
  sent_at               DateTime?                       @db.Timestamp(6)
