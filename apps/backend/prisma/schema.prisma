generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model users {
  id                         Int                          @id @default(autoincrement())
  username                   String                       @unique @db.VarChar(50)
  email                      String?                      @db.VarChar(255)
  password                   String
  state                      user_state_enum              @default(pending_verification)
  last_login                 DateTime?                    @db.Timestamp(6)
  failed_login_attempts      Int                          @default(0)
  locked_until               DateTime?                    @db.Timestamp(6)
  email_verified             Boolean                      @default(false)
  two_factor_enabled         Boolean                      @default(false)
  two_factor_secret          String?
  created_at                 DateTime?                    @default(now()) @db.Timestamp(6)
  updated_at                 DateTime?                    @default(now()) @db.Timestamp(6)
  first_name                 String                       @db.VarChar(100)
  last_name                  String                       @db.VarChar(100)
  avatar_url                 String?                      @db.Text
  organization_id            Int
  phone                      String?                      @db.VarChar(50)
  document_number            String?                      @db.VarChar(50)
  document_type              identification_type_enum?
  // Dígito de verificación (DV) del NIT colombiano. Se almacena separado del
  // `document_number` para que el builder UBL DIAN Anexo 19 pueda emitir
  // `<cbc:ID schemeID="31">NIT</cbc:ID>` y DV como atributo independiente
  // sin ambigüedad. Aplica solo cuando `document_type='NIT'`.
  verification_digit         String?                      @db.VarChar(1)
  // Razón social — obligatoria cuando `person_type='JURIDICA'`. Para personas
  // naturales permanece NULL. La validación cruzada (jurídica ↔ legal_name)
  // vive en el DTO via `JuridicaNameRule`.
  legal_name                 String?                      @db.VarChar(255)
  tax_regime                 tax_regime_enum?
  person_type                persona_type_enum?
  is_withholding_agent       Boolean                      @default(false)
  // Responsabilidades fiscales del RUT (DIAN). Persistidas como array
  // nativo de PostgreSQL — más simple que una tabla join y consultables
  // directamente por el builder UBL (`O-13;O-15` con `;` como separador).
  // Catálogo canónico en `common/constants/fiscal-responsibilities.ts`.
  fiscal_responsibilities    String[]                     @default([])
  // Código CIIU de actividad económica del cliente (4 dígitos, RUT rev. 4
  // AC). La descripción oficial se resuelve client-side desde un catálogo
  // estático; aquí solo se persiste el código.
  ciiu_code                  String?                      @db.VarChar(10)
  main_store_id              Int?
  addresses                  addresses[]                  @relation("user_addresses")
  api_keys                   api_keys[]
  audit_logs                 audit_logs[]
  email_verification_tokens  email_verification_tokens[]
  inventory_adjustments1     inventory_adjustments[]      @relation("inventory_adjustments_approved_by")
  inventory_adjustments      inventory_adjustments[]      @relation("inventory_adjustments_created_by")
  expenses1                  expenses[]                   @relation("expenses_approved_by")
  expenses                   expenses[]                   @relation("expenses_created_by")
  expenses2                  expenses[]                   @relation("expenses_refunded_by")
  inventory_movements        inventory_movements[]
  inventory_transactions     inventory_transactions[]
  password_reset_tokens      password_reset_tokens[]
  purchase_orders1           purchase_orders[]            @relation("purchase_orders_approved_by")
  purchase_orders            purchase_orders[]            @relation("purchase_orders_created_by")
  refresh_tokens             refresh_tokens[]
  refunds                    refunds[]
  refundsResolvedBy          refunds[]                    @relation("refunds_resolved_by")
  reviews                    reviews[]
  // Review system
  review_responses_created   review_responses[]           @relation("review_responses_user")
  review_votes_cast          review_votes[]               @relation("review_votes_user")
  review_reports_filed       review_reports[]             @relation("review_reports_user")
  sales_orders1              sales_orders[]               @relation("sales_orders_approved_by")
  sales_orders               sales_orders[]               @relation("sales_orders_created_by")
  stock_reservations         stock_reservations[]
  stock_transfers1           stock_transfers[]            @relation("stock_transfers_approved_by")
  stock_transfers            stock_transfers[]            @relation("stock_transfers_created_by")
  stock_transfers_dispatched stock_transfers[]            @relation("stock_transfers_dispatched_by")
  stock_transfers_cancelled  stock_transfers[]            @relation("stock_transfers_cancelled_by")
  store_users                store_users[]
  user_roles                 user_roles[]
  user_sessions              user_sessions[]
  user_settings              user_settings?
  carts                      carts[]
  wishlists                  wishlists[]
  orders                     orders[]
  main_store                 stores?                      @relation("main_store", fields: [main_store_id], references: [id], onUpdate: NoAction)
  organizations              organizations                @relation(fields: [organization_id], references: [id], onUpdate: NoAction)
  document_acceptances       document_acceptances[]
  notification_subscriptions notification_subscriptions[]
  push_subscriptions         push_subscriptions[]
  created_tickets            support_tickets[]            @relation("ticket_creator")
  assigned_tickets           support_tickets[]            @relation("ticket_assigned")
  uploaded_attachments       support_attachments[]        @relation("attachment_uploaded_by")
  comments                   support_comments[]           @relation("comment_author")
  status_changes             support_status_history[]     @relation("status_changed_by")
  support_notifications      support_notifications[]      @relation("notification_user")
  help_articles_authored     help_articles[]              @relation("help_article_author")

  // Quotation relations
  quotations_as_customer quotations[] @relation("quotations_customer")
  quotations_created     quotations[] @relation("quotations_created_by")

  // Coupons
  coupon_uses coupon_uses[]

  // Cash Register
  cash_register_sessions_opened cash_register_sessions[]         @relation("cash_register_sessions_opened_by")
  cash_register_sessions_closed cash_register_sessions[]         @relation("cash_register_sessions_closed_by")
  kds_sessions_opened           kds_sessions[]                   @relation("kds_sessions_opened_by")
  kds_sessions_closed           kds_sessions[]                   @relation("kds_sessions_closed_by")
  order_items_delivered         order_items[]                    @relation("order_items_delivered_by")
  order_item_exclusions_created order_item_exclusions[]          @relation("order_item_exclusions_created_by")
  kti_exclusions_excluded       kitchen_ticket_item_exclusions[] @relation("kti_exclusions_excluded_by")
  cash_register_movements       cash_register_movements[]

  // Promotions
  order_promotions_customer order_promotions[]       @relation("order_promotions_customer")
  marketing_ad_creatives    marketing_ad_creatives[] @relation("marketing_ad_creatives_created_by")

  // Invoicing, Accounting & Payroll relations
  invoices_created           invoices[]           @relation("invoices_created_by")
  invoice_profiles_created         invoice_profiles[]         @relation("invoice_profiles_created_by")
  invoice_profile_versions_created invoice_profile_versions[] @relation("invoice_profile_versions_created_by")
  invoices_as_customer       invoices[]           @relation("invoices_customer")
  fiscal_periods_closed      fiscal_periods[]     @relation("fiscal_periods_closed_by")
  accounting_entries_created accounting_entries[] @relation("accounting_entries_created_by")
  accounting_entries_posted  accounting_entries[] @relation("accounting_entries_posted_by")
  employees_link             employees[]          @relation("employees_user")
  payroll_runs_approved      payroll_runs[]       @relation("payroll_runs_approved_by")
  payroll_runs_created       payroll_runs[]       @relation("payroll_runs_created_by")

  // Purchase order improvement relations
  po_attachments_uploaded purchase_order_attachments[] @relation("po_attachment_uploader")
  po_payments_created     purchase_order_payments[]    @relation("po_payment_creator")
  po_receptions_received  purchase_order_receptions[]  @relation("po_reception_receiver")

  // Layaway
  layaway_plans_as_customer layaway_plans[]    @relation("layaway_customer")
  layaway_plans_created     layaway_plans[]    @relation("layaway_created_by")
  layaway_payments_received layaway_payments[] @relation("layaway_payment_received_by")

  // Bank Reconciliation & Advanced Accounting
  bank_reconciliations_created      bank_reconciliations[]        @relation("bank_reconciliations_created_by")
  bank_reconciliation_matches       bank_reconciliation_matches[] @relation("bank_reconciliation_matches_matched_by")
  fixed_assets_created              fixed_assets[]                @relation("fixed_assets_created_by")
  budgets_approved                  budgets[]                     @relation("budgets_approved_by")
  budgets_created                   budgets[]                     @relation("budgets_created_by")
  consolidation_sessions_created    consolidation_sessions[]      @relation("consolidation_created_by")
  consolidation_adjustments_created consolidation_adjustments[]   @relation("consolidation_adj_created_by")

  // Payroll Settlements & Advances
  settlements_approved      payroll_settlements[] @relation("settlements_approved_by")
  settlements_created       payroll_settlements[] @relation("settlements_created_by")
  advances_approved         employee_advances[]   @relation("advance_approved_by")
  payroll_novelties_created payroll_novelties[]   @relation("payroll_novelties_created_by")

  // Campos de tracking de términos
  terms_accepted_version String?   @db.VarChar(20)
  terms_accepted_at      DateTime? @db.Timestamp(6)
  requires_terms_update  Boolean   @default(false)

  // Bookings
  bookings_as_customer            bookings[]                    @relation("bookings_customer")
  bookings_created                bookings[]                    @relation("bookings_created_by")
  // Appointment redesign phase 2 — `booking_reschedule_requests`
  // back-relations. Three named FKs because a single user can be
  // requester, customer-portal requester, and decider in different
  // requests (and even within the same one).
  reschedule_requests_as_user     booking_reschedule_requests[] @relation("reschedule_req_user")
  reschedule_requests_as_customer booking_reschedule_requests[] @relation("reschedule_req_customer")
  reschedule_requests_as_decider  booking_reschedule_requests[] @relation("reschedule_req_decided")

  // Dispatch Notes
  dispatch_notes_as_customer  dispatch_notes[] @relation("dispatch_notes_customer")
  dispatch_notes_created_by   dispatch_notes[] @relation("dispatch_notes_created_by")
  dispatch_notes_confirmed_by dispatch_notes[] @relation("dispatch_notes_confirmed_by")
  dispatch_notes_delivered_by dispatch_notes[] @relation("dispatch_notes_delivered_by")
  dispatch_notes_voided_by    dispatch_notes[] @relation("dispatch_notes_voided_by")

  // Dispatch Routes (Planillas de Despacho)
  dispatch_routes_as_driver          dispatch_routes[]             @relation("dispatch_routes_driver")
  dispatch_routes_as_dispatcher      dispatch_routes[]             @relation("dispatch_routes_dispatcher")
  dispatch_routes_as_voided_by       dispatch_routes[]             @relation("dispatch_routes_voided_by")
  dispatch_routes_as_closed_by       dispatch_routes[]             @relation("dispatch_routes_closed_by")
  dispatch_routes_as_released_by     dispatch_route_stop_history[] @relation("dispatch_route_stop_history_released_by")
  // Carrier Pool (Repartos Fase B4) — órdenes reclamadas por este repartidor.
  orders_claimed_by_carrier          orders[]                      @relation("orders_claimed_by_carrier")
  vehicles_as_primary_driver         vehicles[]                    @relation("vehicles_primary_driver")
  vehicles_as_created_by             vehicles[]                    @relation("vehicles_created_by")
  dispatch_route_stops_settled_by    dispatch_route_stops[]        @relation("dispatch_route_stops_settled_by")
  // Plan Despacho Economía — FASE 2 paso 8. Contraparte de
  // shipping_methods.default_driver_user_id → users.id.
  shipping_methods_as_default_driver shipping_methods[]            @relation("shipping_methods_default_driver")

  // Accounts Receivable
  accounts_receivable_as_customer accounts_receivable[] @relation("ar_customer")

  // Wallet
  wallets wallets[] @relation("wallet_owner")

  // Data Collection & Consultation
  data_collection_submissions    data_collection_submissions[] @relation("submission_customer")
  metadata_snapshots             booking_metadata_snapshots[]  @relation("metadata_snapshot_customer")
  consultation_notes_as_customer customer_consultation_notes[] @relation("consultation_notes_customer")
  consultation_notes_created     customer_consultation_notes[] @relation("consultation_notes_created_by")

  // Operating scope audit trail (Phase 4 wizard)
  operating_scope_audit_changes    operating_scope_audit_log[] @relation("operating_scope_audit_changed_by")
  fiscal_scope_audit_changes       fiscal_scope_audit_log[]    @relation("fiscal_scope_audit_changed_by")
  fiscal_status_audit_changes      fiscal_status_audit_log[]   @relation("fiscal_status_audit_changed_by")
  fiscal_obligations_assigned      fiscal_obligations[]        @relation("fiscal_obligations_assigned_to")
  fiscal_obligations_approved      fiscal_obligations[]        @relation("fiscal_obligations_approved_by")
  fiscal_obligations_created       fiscal_obligations[]        @relation("fiscal_obligations_created_by")
  vendor_support_documents_created vendor_support_documents[]  @relation("vendor_doc_created_by")
  tax_declarations_approved        tax_declaration_drafts[]    @relation("tax_declarations_approved_by")
  tax_declarations_created         tax_declaration_drafts[]    @relation("tax_declarations_created_by")
  pila_submissions_exported        pila_submissions[]          @relation("pila_submissions_exported_by")
  pila_submissions_voided          pila_submissions[]          @relation("pila_submissions_voided_by")
  pila_submissions_created         pila_submissions[]          @relation("pila_submissions_created_by")
  fiscal_close_sessions_started    fiscal_close_sessions[]     @relation("fiscal_close_sessions_started_by")
  fiscal_close_sessions_approved   fiscal_close_sessions[]     @relation("fiscal_close_sessions_approved_by")
  fiscal_close_sessions_closed     fiscal_close_sessions[]     @relation("fiscal_close_sessions_closed_by")
  fiscal_close_checks_resolved     fiscal_close_checks[]       @relation("fiscal_close_checks_resolved_by")
  fiscal_rule_sets_created         fiscal_rule_sets[]          @relation("fiscal_rule_sets_created_by")
  fiscal_operation_events_actor    fiscal_operation_events[]   @relation("fiscal_operation_events_actor")
  customer_withholdings            withholding_calculations[]  @relation("customer_withholdings")

  // Restaurant Suite Foundation (Fase A) — back-relations
  table_sessions_opened table_sessions[] @relation("table_sessions_opened_by")
  table_waiters         table_waiters[]

  // QUI-657 — documentos de identidad subidos por este usuario para tramitar
  // un certificado de firma. `onDelete: SetNull`: el documento sobrevive al
  // usuario que lo cargó (retención indefinida, ver el modelo).
  dian_configuration_documents_uploaded dian_configuration_documents[]
  print_templates_created               print_templates[]             @relation("print_templates_created_by")

  @@index([email_verified])
  @@index([state])
  @@index([document_number])
  @@index([requires_terms_update])
}

model user_settings {
  id      Int @id @default(autoincrement())
  user_id Int @unique

  // NUEVO: app_type determina a qué app tiene acceso el usuario (override post-login)
  app_type app_type_enum @default(STORE_ADMIN)

  config     Json?     @default("{}")
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  user       users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([app_type])
}

/// Relación flexible entre usuarios y tiendas (clientes, staff, managers, etc)
model store_users {
  id        Int      @id @default(autoincrement())
  store_id  Int
  user_id   Int
  createdAt DateTime @default(now())
  store     stores   @relation(fields: [store_id], references: [id])
  user      users    @relation(fields: [user_id], references: [id])

  @@unique([store_id, user_id])
}

model roles {
  id               Int                @id @default(autoincrement())
  name             String             @db.VarChar(50)
  description      String?
  is_system_role   Boolean            @default(false)
  organization_id  Int?
  store_id         Int?
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  updated_at       DateTime?          @default(now()) @db.Timestamp(6)
  role_permissions role_permissions[]
  user_roles       user_roles[]
  organizations    organizations?     @relation(fields: [organization_id], references: [id], onUpdate: NoAction)
  stores           stores?            @relation(fields: [store_id], references: [id], onUpdate: NoAction)

  // QUI-473: composite unique on (organization_id, name) replaces the legacy
  // global `@@unique([name])` so two organizations can each have their own
  // 'Preventista' role. The matching SQL migration is
  // `prisma/migrations/20260724233150_roles_composite_unique/migration.sql`
  // (consolidated into `..._nulls_not_distinct/migration.sql`).
  //
  // System roles (is_system_role=true, organization_id=null) are enforced
  // unique by Postgres `NULLS NOT DISTINCT` on that composite index — without
  // that modifier PostgreSQL would treat `(NULL, name)` rows as distinct and
  // let two system roles share a name.
  //
  // ⚠️ Prisma cannot express `NULLS NOT DISTINCT` in `@@unique(...)`, so any
  // future `prisma migrate diff` / schema regeneration that drops the manual
  // migration will silently re-create the index WITHOUT the modifier. Verify
  // after any schema regeneration:
  //
  //   SELECT indnullsnotdistinct FROM pg_index
  //   WHERE indexrelid = '"roles_organization_id_name_key"'::regclass;
  //   -- must be `true`
  //
  // If you ever need to enforce a system-vs-org invariant at the SQL layer
  // (e.g. a CHECK constraint), prefer a separate follow-up migration.
  //
  // QUI-72: `store_id` adds the missing store dimension. The scope of a role is
  // DERIVED from the two FKs, never stored as a redundant type column:
  //
  //   is_system_role | organization_id | store_id | scope
  //   ---------------+-----------------+----------+--------------
  //   true           | NULL            | NULL     | system
  //   false          | set             | NULL     | organization
  //   false          | set             | set      | store
  //
  // `store_id` set with `organization_id` NULL is invalid and is rejected by the
  // CHECK constraint `roles_store_requires_organization` (see migration
  // `20260727120000_qui72_roles_store_scope`). The unique index grows to
  // (organization_id, store_id, name) and KEEPS `NULLS NOT DISTINCT` — verify:
  //
  //   SELECT indnullsnotdistinct FROM pg_index
  //   WHERE indexrelid = '"roles_organization_id_store_id_name_key"'::regclass;
  //   -- must be `true`
  @@unique([organization_id, store_id, name])
  @@index([organization_id])
  @@index([store_id])
}

model permissions {
  id                   Int                    @id @default(autoincrement())
  name                 String                 @unique @db.VarChar(100)
  description          String?
  path                 String                 @db.VarChar(255)
  method               http_method_enum
  status               permission_status_enum @default(active)
  is_system_permission Boolean                @default(false)
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  updated_at           DateTime?              @default(now()) @db.Timestamp(6)
  role_permissions     role_permissions[]

  @@unique([path, method])
}

model user_roles {
  id       Int     @id @default(autoincrement())
  user_id  Int?
  role_id  Int?
  store_id Int?
  roles    roles?  @relation(fields: [role_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  users    users?  @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  stores   stores? @relation(fields: [store_id], references: [id], onUpdate: NoAction)

  // QUI-72: `store_id` NULL means the assignment applies across the whole
  // organization; a value means it applies ONLY in that store. This is what
  // lets the same user be Cajero in store A and not in store B.
  //
  // ⚠️ The unique index needs `NULLS NOT DISTINCT` for the same reason as
  // `roles`: with the Postgres default, two org-wide assignments
  // (user, role, NULL) would NOT collide and the row could be duplicated.
  // Prisma cannot express it, so it is written by hand in the migration
  // `20260727120000_qui72_roles_store_scope`. Verify:
  //
  //   SELECT indnullsnotdistinct FROM pg_index
  //   WHERE indexrelid = '"user_roles_user_id_role_id_store_id_key"'::regclass;
  //   -- must be `true`
  @@unique([user_id, role_id, store_id])
  @@index([store_id])
}

model role_permissions {
  id            Int         @id @default(autoincrement())
  role_id       Int
  permission_id Int
  granted       Boolean     @default(true)
  created_at    DateTime?   @default(now()) @db.Timestamp(6)
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([role_id, permission_id])
}

model refresh_tokens {
  id                 Int       @id @default(autoincrement())
  user_id            Int?
  token              String
  device_info        String?
  expires_at         DateTime  @db.Timestamp(6)
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  device_fingerprint String?   @db.VarChar(255)
  ip_address         String?   @db.VarChar(45)
  last_used          DateTime? @db.Timestamp(6)
  revoked            Boolean   @default(false)
  revoked_at         DateTime? @db.Timestamp(6)
  revoked_reason     String?   @db.VarChar(255)
  updated_at         DateTime? @default(now()) @db.Timestamp(6)
  user_agent         String?
  users              users?    @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([user_id, revoked])
  @@index([expires_at])
  @@index([revoked])
  @@index([ip_address])
  @@index([last_used])
}

model user_sessions {
  id            Int       @id @default(autoincrement())
  user_id       Int
  session_id    String    @unique
  ip_address    String?   @db.VarChar(45)
  user_agent    String?
  device_info   String?
  location      String?   @db.VarChar(100)
  is_active     Boolean   @default(true)
  last_activity DateTime? @db.Timestamp(6)
  expires_at    DateTime  @db.Timestamp(6)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model login_attempts {
  id             Int       @id @default(autoincrement())
  email          String    @db.VarChar(255)
  ip_address     String?   @db.VarChar(45)
  user_agent     String?
  success        Boolean
  failure_reason String?   @db.VarChar(100)
  attempted_at   DateTime? @default(now()) @db.Timestamp(6)
  store_id       Int?
  stores         stores?   @relation(fields: [store_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

model password_reset_tokens {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token      String    @unique
  expires_at DateTime  @db.Timestamp(6)
  used       Boolean   @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model email_verification_tokens {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token      String    @unique
  expires_at DateTime  @db.Timestamp(6)
  verified   Boolean   @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model audit_logs {
  id              Int            @id @default(autoincrement())
  user_id         Int?
  action          String         @db.VarChar(100)
  resource        String         @db.VarChar(100)
  resource_id     Int?
  old_values      Json?
  new_values      Json?
  /// CP-POS-CREAR-EDITAR-COBRAR-001 — F.2 · Round 2 BLOCKER B1.
  /// Aditiva: nullable JSON para que cada caller persista contexto extra
  /// (request_id, transaction_id, error_code, before/after_totals, etc.) sin
  /// tener que inventar columnas por evento. Estándar bajo `metadata` para que
  /// la consulta de timeline no se acople a un catálogo volátil de columnas.
  metadata        Json?
  /// CP-PURCHASE-TRANSPARENCY C.10 — token de correlación de la petición que
  /// produjo esta entrada. `request-context.interceptor.ts` ya lo genera o lo
  /// HEREDA del header `X-Request-Id` y lo sella en el ALS, pero la tabla no
  /// tenía dónde guardarlo (y un comentario en `http-exception.filter.ts`
  /// afirmaba falsamente que la auditoría ya lo llevaba).
  /// TEXTO, no `uuid`: el interceptor acepta el header entrante tal cual, así
  /// que el valor puede no ser un UUID válido y una columna `uuid` reventaría
  /// la escritura de auditoría por culpa de un header de un tercero.
  request_id      String?        @db.VarChar(100)
  ip_address      String?        @db.VarChar(45)
  user_agent      String?
  created_at      DateTime?      @default(now()) @db.Timestamp(6)
  organization_id Int?
  store_id        Int?
  organizations   organizations? @relation(fields: [organization_id], references: [id], onUpdate: NoAction)
  stores          stores?        @relation(fields: [store_id], references: [id], onUpdate: NoAction)
  users           users?         @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([store_id, created_at])
  @@index([organization_id, created_at])
  @@index([user_id, created_at])
  @@index([created_at])
  /// CP-PURCHASE-TRANSPARENCY C.10 — `getTimeline` (única pantalla forense por
  /// orden) consulta por `resource` + `resource_id` y ningún índice existente
  /// sirve ese predicado: todos empiezan por store/org/user/created_at.
  @@index([resource, resource_id, created_at(sort: Desc)])
}

