model order_items {
  id                               Int                      @id @default(autoincrement())
  order_id                         Int
  product_id                       Int?
  product_variant_id               Int?
  product_name                     String                   @db.VarChar(255)
  variant_sku                      String?                  @db.VarChar(100)
  variant_attributes               String?
  variant_image_url                String?                  @db.VarChar(500)
  quantity                         Int
  unit_price                       Decimal                  @db.Decimal(12, 2)
  total_price                      Decimal                  @db.Decimal(12, 2)
  tax_rate                         Decimal?                 @db.Decimal(6, 5)
  tax_amount_item                  Decimal?                 @db.Decimal(12, 2)
  cost_price                       Decimal?                 @db.Decimal(12, 2)
  catalog_unit_price               Decimal?                 @db.Decimal(12, 2)
  catalog_final_price              Decimal?                 @db.Decimal(12, 2)
  final_unit_price                 Decimal?                 @db.Decimal(12, 2)
  is_price_overridden              Boolean                  @default(false)
  price_override_reason            String?                  @db.VarChar(500)
  price_overridden_by_user_id      Int?
  description                      String?
  weight                           Decimal?                 @db.Decimal(10, 3)
  weight_unit                      String?                  @db.VarChar(10)
  // Bug 12: UoM de venta en el momento del cobro. El frontend envía
  // 'kg'/'und'/'L' + el factor de presentación (ej. 250g por bolsa). El
  // snapshot se persiste para no depender de cambios futuros en
  // products.units_per_package que rompan el ticket histórico.
  sale_unit_code_snapshot          String?                  @db.VarChar(20)
  sale_quantity_snapshot           Decimal?                 @db.Decimal(18, 6)
  item_type                        String?                  @default("physical") @db.VarChar(20)
  // Multi-tarifa snapshot (Phase 1: price tiers).
  // applied_price_tier_id keeps a soft FK with ON DELETE SET NULL so
  // historical line items survive tier deletion; the name snapshot
  // (applied_price_tier_name_snapshot) preserves the human label.
  // stock_units_consumed records the real stock decrement when the applied
  // tier resolves a packSize > 1 (price_tiers.units_per_package or the
  // per-product override product_price_tier_overrides.override_units_per_package).
  applied_price_tier_id            Int?
  applied_price_tier_name_snapshot String?                  @db.VarChar(255)
  stock_units_consumed             Int?
  /// Snapshot de `products.price_unit_quantity` al momento de la venta: a
  /// cuántas unidades de stock corresponde `unit_price`. El total de la línea es
  /// `unit_price * quantity / price_unit_quantity`. `null` o `1` = precio por
  /// unidad, el comportamiento histórico.
  price_unit_quantity              Int?
  // Restaurant Suite Fase D — guard anti-doble-descuento.
  // Marcado por KitchenFireService al enviar el item a cocina (fire-to-kitchen).
  // PaymentsService.updateInventoryFromOrder lo salta si está true para que
  // el descuento NO se vuelva a aplicar al pagar. Default false → no afecta
  // el flujo retail existente.
  inventory_consumed_at_fire       Boolean                  @default(false)
  // Refactor inventario (Ola 0) — commit unico de stock, anti-doble-descuento.
  // inventory_committed marca que el stock de este item YA fue descontado. El
  // servicio unificado de commit salta el item si esta en true, garantizando que
  // el descuento nunca se aplique dos veces. inventory_committed_at registra el
  // instante del commit (null en historicos backfilleados). Default false preserva
  // el flujo existente (retail, ecommerce, POS).
  inventory_committed              Boolean                  @default(false)
  inventory_committed_at           DateTime?                @db.Timestamp(6)
  // Restaurant Suite Fase K / Plan KDS fire-flows: marca persistida de la intencion
  // del cajero al aniadir el item al carrito ("usar stock" en pos-prepared-choice-modal).
  // - skip_kds=true: el item NO se enviara a cocina; su stock se descuenta en el
  //   pago (sales movement), no en fire. Pensado para platos preparados que el
  //   operador sabe que ya no requieren paso por cocina (ej. producto terminado
  //   listo para entrega inmediata desde mostrador).
  // - skip_kds=false (default): item elegible para fire. kitchen-fire.service.ts
  //   decide al final segun product_type='prepared' y existencia de receta activa.
  // Default false preserva el comportamiento actual para ordenes existentes.
  skip_kds                         Boolean                  @default(false)
  // QUI-653 — el item se empaca y el cliente se lo lleva, aunque pertenezca al
  // pedido de una mesa. Es una dimension POR ITEM, deliberadamente separada de
  // `orders.delivery_type`, por dos razones:
  //   1. `delivery_type` es order-level: un solo valor no puede expresar "estos
  //      3 items en la mesa y este 1 para llevar".
  //   2. Cambiarlo metaria la orden en los flujos de despacho. `stores.service`
  //      y `orders.service` excluyen 'direct_delivery' y 'dine_in' del conjunto
  //      que requiere remision; si una orden de mesa pasara a 'pickup' por
  //      tener un item para llevar, empezaria a aparecer como pendiente de
  //      remision, donde no tiene nada que hacer: el plato se entrega en mano.
  // El indicador de "pedido mixto" es DERIVADO, no persistido: la orden es
  // mixta cuando tiene items con y sin el flag.
  is_takeaway                      Boolean                  @default(false)
  // QUI-652 — LA ENTREGA ES UN HECHO DE SERVICIO, NO DE COCINA.
  // Antes el estado de entrega vivia SOLO en `kitchen_ticket_items.status`
  // ('delivered'), y el fire excluye explicitamente todo lo que no sea
  // `product_type='prepared'`. Consecuencia: una cerveza en botella nunca
  // obtenia fila en kitchen_ticket_items, `kitchenStatusFor()` devolvia null
  // para siempre, y el item se quedaba en "Sin enviar" sin poder marcarse
  // entregado — se perdia la trazabilidad de que recibio el cliente.
  //
  // Una cerveza necesita trazabilidad de entrega y nunca necesita cocinarse, y
  // un plato para llevar tambien se entrega (empacado). Por eso el hecho vive
  // aqui, independiente del ticket de cocina, y la UI muestra dos dimensiones
  // separadas: cocina (solo cuando aplica) y entrega (siempre).
  delivered_at                     DateTime?                @db.Timestamp(6)
  delivered_by_user_id             Int?
  // QUI-655 — nota de texto libre al TOMAR el pedido ("sin cebolla", "poca sal",
  // "bien cocido"). No existía ningún campo así: `order_items` solo tenía
  // `quantity`, así que no había dónde poner ni la nota ni la exclusión.
  //
  // Es uno de los tres caminos OPCIONALES que convergen en el modal de
  // confirmación de cocina, y el que mejor refleja cómo funciona un restaurante
  // real cuando hay prisa o cuando la petición no calza con un ingrediente
  // exacto. El fire la propaga a `kitchen_ticket_items.notes`, columna que ya
  // existía en el schema documentando este caso y que el código nunca escribía.
  notes                            String?
  // QUI-655 — línea partida por PREPARACIÓN. Cuando una línea de 3 unidades
  // necesita una excepción en solo 1, se parte en 2 + 1 para que cada línea
  // quede HOMOGÉNEA: "una línea = una especificación de preparación".
  //
  // Se preserva así la invariante que todo el pipeline ya asume — `explodeBom`
  // multiplica por la cantidad de la línea, `updateStock` consume por línea, el
  // COGS suma por línea, `kitchen_ticket_items` es una fila por línea. La
  // alternativa (`unit_index`) rompe esa aritmética en cuatro lugares a la vez.
  //
  // `split_from_order_item_id` apunta a la línea original para que la UI pueda
  // reagrupar las partes y el cliente siga viendo "3 pollos" en vez de dos filas
  // sueltas. NULL = línea nunca partida.
  split_from_order_item_id         Int?
  /// SET NULL y no CASCADE: si la linea original se elimina, las partes NO deben
  /// desaparecer — son consumo real que ya paso por cocina. Pierden el puntero de
  /// agrupacion visual y nada mas.
  split_from_order_item            order_items?             @relation("order_item_preparation_split", fields: [split_from_order_item_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  split_parts                      order_items[]            @relation("order_item_preparation_split")
  order_item_exclusions            order_item_exclusions[]
  // QUI-431 serial tracking — immutable CSV snapshot of serial numbers sold on
  // this line. Persisted at emission time so legal documents (order voucher,
  // POS ticket) never read the live serial pool. The strong link lives in
  // sales_document_serials (document_item_type = order_item).
  serial_numbers_snapshot          String?
  created_at                       DateTime?                @default(now()) @db.Timestamp(6)
  updated_at                       DateTime?                @default(now()) @db.Timestamp(6)
  inventory_transactions           inventory_transactions[]
  order_item_taxes                 order_item_taxes[]
  orders                           orders                   @relation(fields: [order_id], references: [id], onUpdate: NoAction)
  products                         products?                @relation(fields: [product_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  product_variants                 product_variants?        @relation(fields: [product_variant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  applied_price_tier               price_tiers?             @relation("order_items_applied_price_tier", fields: [applied_price_tier_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  delivered_by_user                users?                   @relation("order_items_delivered_by", fields: [delivered_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  refund_items                     refund_items[]

  // Restaurant Suite Foundation (Fase A) — back-relation
  kitchen_ticket_items kitchen_ticket_items[]
}

model orders {
  id                                              Int                       @id @default(autoincrement())
  store_id                                        Int
  customer_id                                     Int?
  // ADR-9 (CP-POLLO-ARABE-727 A.3): alias de cliente en venta anónima/física.
  // `customer_id` y `customer_alias` son mutuamente excluyentes — el CHECK
  // `orders_customer_xor_alias` (en la migración add_customer_alias) garantiza
  // que nunca ambos se pueblen en la misma fila.
  customer_alias                                  String?                    @db.VarChar(100)
  order_number                                    String                    @db.VarChar(50)
  shipping_address_id                             Int?
  billing_address_id                              Int?
  shipping_address_snapshot                       Json?
  billing_address_snapshot                        Json?
  currency                                        String?                   @db.VarChar(10)
  subtotal_amount                                 Decimal                   @default(0.00) @db.Decimal(12, 2)
  discount_amount                                 Decimal                   @default(0.00) @db.Decimal(12, 2)
  tax_amount                                      Decimal                   @default(0.00) @db.Decimal(12, 2)
  shipping_cost                                   Decimal                   @default(0.00) @db.Decimal(12, 2)
  grand_total                                     Decimal                   @default(0.00) @db.Decimal(12, 2)
  // Plan Despacho Economía — FASE 6 paso 19. Estado de cumplimiento del
  // despacho (sin envío parcial del flujo de remisión). Mantenido por
  // listeners event-driven; el frontend lo usa para filtrar `?dispatchable=true`.
  dispatch_fulfillment                            dispatch_fulfillment_enum @default(none)
  state                                           order_state_enum          @default(created)
  channel                                         order_channel_enum        @default(pos)
  delivery_type                                   order_delivery_type_enum  @default(direct_delivery)
  shipping_method_id                              Int?
  shipping_rate_id                                Int?
  internal_notes                                  String?
  // Staff-only note (optional, set at creation only, never exposed to customer)
  notes                                           String?                   @db.VarChar(500)
  created_at                                      DateTime?                 @default(now()) @db.Timestamp(6)
  updated_at                                      DateTime?                 @default(now()) @db.Timestamp(6)
  coupon_id                                       Int?
  coupon_code                                     String?                   @db.VarChar(50)
  placed_at                                       DateTime?                 @db.Timestamp(6)
  completed_at                                    DateTime?                 @db.Timestamp(6)
  payment_form                                    String?                   @db.VarChar(2)
  credit_type                                     String?                   @db.VarChar(20)
  interest_rate                                   Decimal?                  @db.Decimal(5, 4)
  interest_type                                   String?                   @db.VarChar(10)
  total_paid                                      Decimal                   @default(0) @db.Decimal(12, 2)
  remaining_balance                               Decimal                   @default(0) @db.Decimal(12, 2)
  total_with_interest                             Decimal?                  @db.Decimal(12, 2)
  // Dine-in QR: propina opcional capturada al cerrar la cuenta (nullable, sin default)
  tip_amount                                      Decimal?                  @db.Decimal(12, 2)
  order_items                                     order_items[]
  order_installments                              order_installments[]
  addresses_orders_billing_address_idToaddresses  addresses?                @relation("orders_billing_address_idToaddresses", fields: [billing_address_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  addresses_orders_shipping_address_idToaddresses addresses?                @relation("orders_shipping_address_idToaddresses", fields: [shipping_address_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  stores                                          stores                    @relation(fields: [store_id], references: [id], onUpdate: NoAction)
  users                                           users?                    @relation(fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  payments                                        payments[]
  refunds                                         refunds[]
  shipping_method                                 shipping_methods?         @relation(fields: [shipping_method_id], references: [id], onDelete: SetNull)
  shipping_rate                                   shipping_rates?           @relation(fields: [shipping_rate_id], references: [id], onDelete: SetNull)
  invoices                                        invoices[]
  quotations                                      quotations[]
  order_promotions                                order_promotions[]
  coupon                                          coupons?                  @relation(fields: [coupon_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  coupon_uses                                     coupon_uses[]
  cash_register_movements                         cash_register_movements[]
  // Bookings
  bookings                                        bookings[]

  // Payment Links
  payment_links payment_links[]

  // ETA (Estimated Time of Arrival)
  estimated_ready_at     DateTime?
  estimated_delivered_at DateTime?

  // Invoice Data Requests
  invoice_data_requests invoice_data_requests[]

  // Restaurant Suite Foundation (Fase A) — back-relations
  table_sessions  table_sessions[]
  kitchen_tickets kitchen_tickets[]

  // Dispatch (remisión) back-relation
  dispatch_notes dispatch_notes[] @relation("orders_dispatch_notes")

  // Carrier Pool (Repartos Fase B4) — orden liberada al pool de repartidores.
  // dispatch_pool_at: instante en que entró al pool (nullable → no está en el pool).
  // claimed_by_carrier_user_id: repartidor (rol carrier) que la reclamó.
  // Ambos nullable; sin efecto sobre filas existentes.
  dispatch_pool_at           DateTime? @db.Timestamp(6)
  claimed_by_carrier_user_id Int?
  claimed_by_carrier         users?    @relation("orders_claimed_by_carrier", fields: [claimed_by_carrier_user_id], references: [id], onDelete: SetNull)

  // QUI-628: back-relation from carts.converted_order_id — a cart that
  // converted into this order (recovered, not abandoned).
  carts_converted carts[] @relation("cart_converted_order")

  @@unique([store_id, order_number])
  @@index([store_id, order_number])
  @@index([store_id, channel])
  @@index([store_id, dispatch_pool_at])
}

model order_installments {
