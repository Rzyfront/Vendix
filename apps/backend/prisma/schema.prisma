/// Catalog of physical units of measure. Global read-only data (constants of
/// the physical world, not tenant data) — same rationale as `countries` /
/// `currencies`. `factor_to_base` is metadata that lets the UI display
/// equivalences (1 kg = 1000 g); the integer factor used to convert
/// purchase→stock at receipt lives on `products.purchase_to_stock_factor`.
model units_of_measure {
  id                Int                @id @default(autoincrement())
  code              String             @unique @db.VarChar(20)
  name              String             @db.VarChar(60)
  dimension         uom_dimension_enum
  is_base           Boolean            @default(false)
  factor_to_base    Decimal            @db.Decimal(18, 6)
  /// Si esta unidad puede ser la unidad de STOCK de un producto. El inventario
  /// es `Int` en la unidad base, así que una unidad cuyo `factor_to_base` no es
  /// entero (pulgada = 25.4 mm, galón = 3785.411784 ml) no puede representarse
  /// sin perder mercancía por redondeo: sirve como unidad de COMPRA o de
  /// presentación, nunca como unidad de stock.
  is_stock_eligible Boolean            @default(true)
  is_active         Boolean            @default(true)
  created_at        DateTime?          @default(now()) @db.Timestamp(6)
  updated_at        DateTime?          @default(now()) @db.Timestamp(6)

  products_stock    products[] @relation("product_stock_uom")
  products_purchase products[] @relation("product_purchase_uom")

  @@index([dimension])
  @@index([is_active])
}

