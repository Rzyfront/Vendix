  id              Int      @id @default(autoincrement())
  organization_id Int
  plan_id         Int
  consumed_at     DateTime @default(now()) @db.Timestamp(6)
  store_id        Int?
  metadata        Json?

  organization organizations      @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  plan         subscription_plans @relation(fields: [plan_id], references: [id], onDelete: Restrict)

  @@unique([organization_id, plan_id])
  @@index([organization_id])
  @@index([plan_id])
}

