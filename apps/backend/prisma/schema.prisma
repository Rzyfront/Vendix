  year                 Int
  value_cop            Decimal   @db.Decimal(12, 2)
  created_at           DateTime? @default(now()) @db.Timestamp(6)
  updated_at           DateTime? @default(now()) @db.Timestamp(6)

  organization      organizations        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  accounting_entity accounting_entities? @relation(fields: [accounting_entity_id], references: [id], onDelete: SetNull)

  @@unique([organization_id, accounting_entity_id, year])
  @@index([organization_id])
  @@index([accounting_entity_id])
}

model withholding_concepts {
  id                   Int                            @id @default(autoincrement())
  organization_id      Int
  accounting_entity_id Int?
  code                 String                         @db.VarChar(30)
  name                 String                         @db.VarChar(150)
  rate                 Decimal                        @db.Decimal(7, 4)
