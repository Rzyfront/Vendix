/// Appointment redesign phase 2 — pending reschedule requests when
/// `store_settings.settings.reservations.allow_direct_reschedule` is
/// `false`. The booking's actual `date / start_time / end_time` stays
/// unchanged until an admin approves (or rejects) the row.
///
/// Status lifecycle:
///   `pending`  → `approved`   (admin accepted, booking moved)
///   `pending`  → `rejected`   (admin denied, booking untouched)
///   `pending`  → `cancelled`  (customer withdrew their request)
///   `approved` / `rejected` / `cancelled` are terminal.
model booking_reschedule_requests {
  id                       Int                                    @id @default(autoincrement())
  store_id                 Int
  booking_id               Int
  /// The new date the customer wants — the booking stays at its
  /// current `date` until the row is approved.
  requested_date           DateTime                               @db.Date
  requested_start_time     String                                 @db.VarChar(5)
  requested_end_time       String                                 @db.VarChar(5)
  /// The admin/employee who created the request, if it was filed from
  /// the POS/admin side on behalf of the customer. NULL for requests
  /// filed from the ecommerce portal by the customer themselves.
  requested_by_user_id     Int?
  /// The customer who filed the request from the ecommerce portal.
  /// NULL for admin-side requests (where the customer is implied by
  /// `booking_id`).
  requested_by_customer_id Int?
  requested_at             DateTime                               @default(now()) @db.Timestamp(6)
  /// Free-text reason the customer typed in the reschedule modal.
  reason                   String?                                @db.Text
  status                   booking_reschedule_request_status_enum @default(pending)
  /// The admin/employee who approved/rejected the request. NULL while
  /// pending; populated on `approved`/`rejected`.
  decided_by_user_id       Int?
  decided_at               DateTime?
  /// Free-text reason the admin typed when rejecting (also allowed on
  /// approve, but most approvals won't use it).
  decision_reason          String?                                @db.Text
  created_at               DateTime?                              @default(now()) @db.Timestamp(6)
  updated_at               DateTime?                              @default(now()) @db.Timestamp(6)

  booking               bookings @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  store                 stores   @relation(fields: [store_id], references: [id])
  requested_by_user     users?   @relation("reschedule_req_user", fields: [requested_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  requested_by_customer users?   @relation("reschedule_req_customer", fields: [requested_by_customer_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  decided_by_user       users?   @relation("reschedule_req_decided", fields: [decided_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([booking_id])
  @@index([store_id, status])
  @@index([store_id, status, requested_at])
}

enum booking_reschedule_request_status_enum {
  /// Filed by the customer (or admin on their behalf). The booking's
  /// date/time is untouched. Awaiting admin decision.
  pending
  /// Admin accepted — the booking's date/start_time/end_time were
  /// updated to the requested_* fields.
  approved
  /// Admin denied — the booking stays at its original slot. Customer
  /// gets the `decision_reason` in the notification/email.
  rejected
  /// Customer withdrew their request before the admin decided.
  cancelled
}

