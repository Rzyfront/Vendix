// ===================== MEMBERSHIPS (industria-genérico, Ola 1) =====================
// Núcleo de membresías REUTILIZABLE por cualquier industria (gym, service, generic…).
// Nace de la suite `gym` y se generaliza (rename total, Opción A): las tablas y enums
// dejan el prefijo gym_ y ganan un discriminador `kind` (membership_kind_enum) para que
// un gimnasio, un club de servicios o cualquier comercio vendan membresías con el mismo
// modelo, sin crear tablas por industria.
// El socio es un `users` rol customer (+ store_users); las tablas cuelgan de customer_id
// (scalar FK, constraints reales en la migración — sin relación Prisma hacia
// users/stores/orders/products para no tocar esos modelos compartidos).
// Límites específicos de industria (accesos/clases por periodo) viven en `features` Json,
// no en columnas dedicadas, para no re-migrar por cada industria.
// Nunca se almacenan plantillas biométricas: membership_access_credentials guarda solo
// QR/PIN/external_ref (dato de referencia), la huella vive en el dispositivo.

enum membership_status_enum {
  active
  expired
  suspended
  frozen
  pending_payment
  cancelled
}

enum membership_credential_type_enum {
  qr
  pin
  external_ref
}

enum membership_access_result_enum {
  granted
  denied_no_membership
  denied_expired
  denied_suspended
  denied_frozen
  denied_quota_exceeded
  denied_outside_schedule
  denied_capacity_full
  // Reingreso dentro de la ventana configurada (re_entry_window_hours) cuando
  // re_entry_mode = 'block'. En modo 'warn' se CONCEDE (granted) con warning.
  denied_re_entry
}

// Discriminador de industria/uso de la membresía. `generic` es el default reutilizable;
// `gym`/`service` etiquetan el origen para gating y reportes sin ramificar el modelo.
enum membership_kind_enum {
  generic
  gym
  service
}

model membership_plans {
  id            Int                  @id @default(autoincrement())
  store_id      Int
  kind          membership_kind_enum @default(generic)
  code          String               @db.VarChar(60)
  name          String               @db.VarChar(160)
  description   String?
  price         Decimal              @default(0) @db.Decimal(12, 2)
  currency      String               @default("COP") @db.VarChar(3)
  duration_days Int                  @default(30)
  // Límites por periodo (accesos, clases, etc.) y cualquier atributo específico de la
  // industria viven aquí: { access_limit_per_period, class_limit_per_period, ... }.
  features      Json?
  product_id    Int?
  is_active     Boolean              @default(true)
  sort_order    Int                  @default(0)
  created_at    DateTime             @default(now())
  updated_at    DateTime             @updatedAt

  @@unique([store_id, code])
  @@index([store_id])
  @@index([store_id, is_active])
  @@index([store_id, kind])
}

model memberships {
  id                 Int                    @id @default(autoincrement())
  store_id           Int
  customer_id        Int
  plan_id            Int
  kind               membership_kind_enum   @default(generic)
  status             membership_status_enum @default(pending_payment)
  period_start       DateTime?
  period_end         DateTime?
  auto_renew         Boolean                @default(false)
  source_order_id    Int?
  notes              String?
  // Bug 10: soft-delete audit. Solo terminales ({expired, suspended, cancelled})
  // se pueden eliminar. El listado filtra deleted_at IS NULL por default.
  deleted_at         DateTime?
  deleted_by_user_id Int?
  deletion_reason    String?
  created_at         DateTime               @default(now())
  updated_at         DateTime               @updatedAt

  @@index([store_id, customer_id])
  @@index([store_id, status])
  @@index([store_id, period_end])
  @@index([plan_id])
  @@index([store_id, deleted_at])
}

