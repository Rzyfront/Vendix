// ===== KDS (ESTACIONES DE PREPARACIÓN) =====
//
// QUI-651. Antes de esto el KDS era IMPLÍCITO: existía un solo tablero por
// tienda y `kitchen_tickets` no apuntaba a ninguna estación, así que en un
// restaurante con barra + cocina caliente + postres un pedido de 20 productos
// caía completo en el mismo tablero y el personal filtraba a mano.
//
// El modelado es espejo deliberado de `cash_registers` / `cash_register_sessions`:
// misma forma de entidad, mismo `@@unique([store_id, code])`, mismo índice
// `[x_id, status]` que respalda el guard de una-sola-sesión-abierta, y mismo
// `summary Json?` para el snapshot inmutable al cerrar el turno.
//
// La diferencia sustantiva: la sesión de caja custodia DINERO, la de KDS
// custodia RESPONSABILIDAD SOBRE EL CONSUMO DE INSUMOS. Por eso `kds_sessions`
// no tiene montos, y por eso `inventory_transactions` gana `kds_session_id`.

enum kds_session_status_enum {
  open
  closed
}

model kds {
  id          Int       @id @default(autoincrement())
  store_id    Int
  name        String    @db.VarChar(100)
  code        String    @db.VarChar(50)
  description String?   @db.VarChar(255)
  is_active   Boolean   @default(true)
  /// Exactamente un KDS por defecto por tienda. La unicidad se refuerza con un
  /// índice único PARCIAL (`WHERE is_default`) creado en la migración: Prisma no
  /// sabe expresar índices parciales, así que vive en SQL.
  is_default  Boolean   @default(false)
  location_id Int?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)

  store    stores               @relation(fields: [store_id], references: [id], onUpdate: NoAction)
  location inventory_locations? @relation(fields: [location_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  sessions kds_sessions[]
  products products[]
  tickets  kitchen_tickets[]

  @@unique([store_id, code])
  @@index([store_id, is_active])
  @@index([location_id])
}

model kds_sessions {
  id            Int                     @id @default(autoincrement())
  kds_id        Int
  store_id      Int
  opened_by     Int
  closed_by     Int?
  status        kds_session_status_enum @default(open)
  opened_at     DateTime                @default(now()) @db.Timestamp(6)
  closed_at     DateTime?               @db.Timestamp(6)
  closing_notes String?
  /// Snapshot inmutable del turno, persistido AL CERRAR (igual que caja):
  /// tickets servidos, tiempo promedio de preparación, items cancelados y el
  /// resumen de consumo de insumos con su costo total. Mientras la sesión está
  /// abierta el resumen se calcula en vivo y esta columna sigue NULL.
  summary       Json?
  /// QUI-XXX: heartbeat —última vez que alguien mutó algo del turno.
  /// Permite a `kitchen-fire.assertCanMutateStationTicket` decidir si una
  /// sesión abierta por otro operador ya está "vencida" (>5min sin actividad)
  /// y liberar la estación sin pedir acción al dueño anterior. Lazy: se
  /// actualiza en cada mutación (`start`/`ready`/`delivered`/`cancel`/`revert`)
  /// y desde el endpoint `/store/kds-sessions/:id/heartbeat` que el frontend
  /// llama una vez por minuto mientras el operador tiene la sesión abierta.
  last_seen_at  DateTime?               @db.Timestamp(6)
  /// QUI-XXX: auditoría de toma forzada — si un owner/admin tomó el control
  /// de una estación que otro operador tenía abierta, esta columna apunta
  /// al usuario que tomó el mando. Se estampa sobre la SESIÓN CERRADA en el
  /// momento de la toma, no sobre la nueva (la nueva es legítima del
  /// tomador, no requiere huella). Nullable y `ON DELETE SET NULL`: borrar
  /// el usuario tomador no debe borrar la auditoría.
  force_taken_by_user_id Int?
  created_at    DateTime?               @default(now()) @db.Timestamp(6)
  updated_at    DateTime?               @default(now()) @db.Timestamp(6)

  kds                    kds                      @relation(fields: [kds_id], references: [id], onUpdate: NoAction)
  store                  stores                   @relation("kds_sessions_store", fields: [store_id], references: [id], onUpdate: NoAction)
  opened_by_user         users                    @relation("kds_sessions_opened_by", fields: [opened_by], references: [id], onUpdate: NoAction)
  closed_by_user         users?                   @relation("kds_sessions_closed_by", fields: [closed_by], references: [id], onUpdate: NoAction)
  force_taken_by_user    users?                   @relation("kds_sessions_force_taken_by", fields: [force_taken_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  inventory_transactions inventory_transactions[]

  @@index([store_id, status])
  @@index([kds_id, status])
  @@index([opened_by, status])
  @@index([kds_id, last_seen_at])
}

