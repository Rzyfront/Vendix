  is_active            Boolean                        @default(true)
  created_at           DateTime?                      @default(now()) @db.Timestamp(6)
  updated_at           DateTime?                      @default(now()) @db.Timestamp(6)

  organization             organizations              @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  accounting_entity        accounting_entities?       @relation(fields: [accounting_entity_id], references: [id], onDelete: SetNull)
  withholding_calculations withholding_calculations[]

  @@unique([organization_id, accounting_entity_id, code])
  @@index([organization_id, is_active])
  @@index([accounting_entity_id])
}

model withholding_calculations {
  id                   Int                    @id @default(autoincrement())
  organization_id      Int
  store_id             Int?
  accounting_entity_id Int?
  invoice_id           Int?
  supplier_id          Int?
  customer_id          Int?
  concept_id           Int
  role                 withholding_role_enum  @default(practiced)
  counterparty_type    String?                @db.VarChar(20)
  withholding_type     withholding_type_enum?
  base_amount          Decimal                @db.Decimal(12, 2)
  withholding_rate     Decimal                @db.Decimal(7, 4)
  withholding_amount   Decimal                @db.Decimal(12, 2)
  uvt_value_used       Decimal                @db.Decimal(12, 2)
  year                 Int
  created_at           DateTime?              @default(now()) @db.Timestamp(6)

  organization      organizations        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  store             stores?              @relation(fields: [store_id], references: [id], onDelete: Cascade)
  accounting_entity accounting_entities? @relation(fields: [accounting_entity_id], references: [id], onDelete: SetNull)
  invoice           invoices?            @relation(fields: [invoice_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  supplier          suppliers?           @relation(fields: [supplier_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  customer          users?               @relation("customer_withholdings", fields: [customer_id], references: [id], onDelete: SetNull)
  concept           withholding_concepts @relation(fields: [concept_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([organization_id, invoice_id])
  @@index([organization_id, supplier_id, year])
  @@index([organization_id, customer_id, year])
  @@index([accounting_entity_id])
  @@index([store_id])
}

