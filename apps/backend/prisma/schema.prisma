// ===== NOTIFICATIONS =====

enum notification_type_enum {
  new_order
  order_status_change
  low_stock
  new_customer
  payment_received
  layaway_payment_received
  layaway_payment_reminder
  /// QUI-647 — cuotas de Cuentas por Pagar (lado proveedor). Espejo de
  /// `installment_*`, que es el lado cliente.
  ap_installment_due_soon
  ap_installment_overdue
  layaway_overdue
  layaway_completed
  layaway_cancelled
  installment_reminder
  installment_overdue
  installment_paid
  credit_completed
  new_review
  review_moderated
  payroll_rules_update
  customer_queue_new
  customer_queue_selected
  customer_queue_consumed
  customer_queue_cancelled
  customer_queue_released
  booking_created
  booking_confirmed
  booking_cancelled
  booking_no_show
  booking_reminder
  booking_rescheduled
  /// Appointment redesign phase 2 — fired when a customer requests a
  /// reschedule that requires admin approval (settings.reservations.
  /// allow_direct_reschedule === false). The booking itself stays at
  /// its current slot until the admin approves or rejects the
  /// `booking_reschedule_requests` row.
  booking_reschedule_requested
  /// Fired when an admin approves a pending reschedule. The booking's
  /// `date / start_time / end_time` have been moved to the requested
  /// slot and the customer gets a notification + email.
  booking_reschedule_approved
  /// Fired when an admin rejects a pending reschedule. The booking
  /// stays at its original slot and the customer gets a notification
  /// + email with the admin's reason.
  booking_reschedule_rejected
  /// Fired when the customer withdraws their own pending reschedule
  /// request (via the "Cancelar solicitud" button). The
  /// `booking_reschedule_requests` row is marked `cancelled` and the
  /// booking is left untouched.
  booking_reschedule_cancelled
  booking_started
  booking_completed
  booking_arrival
  booking_attending
  booking_check_in
  booking_pending_attention
  booking_confirmation_request
  booking_auto_cancelled
  invoice_data_request_submitted
  data_collection_created
  data_collection_submitted
  data_collection_prediagnosis_ready
  subscription_payment_reminder_soft
  subscription_payment_reminder_hard
  subscription_suspended
  subscription_blocked
  subscription_reactivated
  fiscal_scope_changed
  subscription_promo_applied
  subscription_renewal_upcoming
  partner_commission_available
  weekly_report
  pqr_new
  pqr_update
  membership_expiring
  membership_expired
  table_call_waiter
  table_request_bill
  table_request_split
  table_payment_pending
  table_payment_confirmed
  qr_table_scan
  /// QUI-719 — contacto desde la landing pública del módulo CRM.
  crm_contact_request
  order_awaiting_carrier
  appointment_upcoming
  appointment_checked_in
  appointment_queued
  appointment_no_show
  /// A Vexi background task finished. Its own type because the bell click has to
  /// route to the task result, and because the panel filters notifications by
  /// type — folded into an existing label it would show up as an order or a
  /// report and mislead the person who is looking for it.
  vexi_task_completed
  vexi_task_failed
  auto_renew_disabled_no_credential
  auto_renew_charge_failed
}

model notifications {
  id         Int                        @id @default(autoincrement())
  // store_id is nullable to support super-admin-level notifications
  // (e.g. "new PQR arrived on the platform"). When null, the
  // notification is scoped to the super-admin role via the `data`
  // JSON payload instead of a specific store. Store-scoped rows
  // (existing behaviour) keep their FK.
  store_id   Int?
  type       notification_type_enum
  severity   notification_severity_enum @default(info)
  title      String                     @db.VarChar(255)
  body       String                     @db.Text
  data       Json?
  is_read    Boolean                    @default(false)
  created_at DateTime                   @default(now()) @db.Timestamp(6)
  updated_at DateTime                   @default(now()) @db.Timestamp(6)
  stores     stores?                    @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id])
  @@index([store_id, is_read])
  @@index([store_id, created_at(sort: Desc)])
  @@index([store_id, severity, is_read])
  @@index([created_at(sort: Desc)])
}

