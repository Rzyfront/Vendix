  organization_id           Int
  vendor_nit                String                              @db.VarChar(20)
  vendor_name               String                              @db.VarChar(255)
  invoice_number            String                              @db.VarChar(100)
  issue_date                DateTime                            @db.Date
  subtotal                  Decimal?                            @db.Decimal(18, 4)
  tax_amount                Decimal?                            @db.Decimal(18, 4)
  total                     Decimal                             @db.Decimal(18, 4)
  currency                  String                              @default("COP") @db.VarChar(3)
  account_code              String                              @db.VarChar(20)
  description               String?                             @db.Text
  pdf_s3_key                String?                             @db.Text
  status                    vendor_support_document_status_enum @default(pending)
  approved_journal_entry_id Int?
  paid_journal_entry_id     Int?
  created_by_user_id        Int?
  created_at                DateTime?                           @default(now()) @db.Timestamp(6)
  updated_at                DateTime?                           @default(now()) @db.Timestamp(6)

  organization           organizations       @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  approved_journal_entry accounting_entries? @relation("vendor_doc_approved_entry", fields: [approved_journal_entry_id], references: [id], onDelete: SetNull)
  paid_journal_entry     accounting_entries? @relation("vendor_doc_paid_entry", fields: [paid_journal_entry_id], references: [id], onDelete: SetNull)
  created_by_user        users?              @relation("vendor_doc_created_by", fields: [created_by_user_id], references: [id], onDelete: SetNull)

  @@unique([organization_id, vendor_nit, invoice_number], map: "vendor_support_documents_org_nit_invoice_key")
  @@index([organization_id, status])
  @@index([organization_id, issue_date])
}

enum vendor_support_document_status_enum {
  pending
  approved
  paid
  void
}

// =====================================================================
// = Restaurant Suite Foundation (Fase A) — data foundation only       =
// = Phase A adds schema + migration + scope registration. No business  =
// = logic (services, controllers, DTOs) is wired yet — that is Fase B. =
// =====================================================================

// Lifecycle states of a production order (recipe-based cooking batch).
enum production_order_state_enum {
  // Recipe planned, not yet started in the kitchen.
  draft
  // Kitchen has begun preparing the batch.
  in_progress
  // Batch finished, finished-goods stock has been credited via
  // movement_type_enum='production' inventory movements.
  completed
  // Cancelled; no inventory effects.
  cancelled
}

// Lifecycle of a physical restaurant table / dining zone.
enum table_status_enum {
  // Table is open for seating new guests.
  available
  // Currently seated (open table_session, unfinished order).
  occupied
  // Held for a future reservation / walk-in; not yet seated.
  reserved
  // Out of service for cleaning / reset.
  cleaning
}

// Lifecycle of a kitchen ticket (a fire order sent to the kitchen).
enum kitchen_ticket_state_enum {
  pending
  in_preparation
  ready
  delivered
  cancelled
}

// Per-item lifecycle inside a kitchen ticket (some items may fire late).
enum kitchen_ticket_item_state_enum {
  pending
  in_preparation
  ready
  delivered
  cancelled
}

/// Dimension classification of a unit of measure. Mass and volume are
/// mutually exclusive at conversion time; `count` is the unitless dimension
/// for items sold per piece. Used to validate that stock_uom and
/// purchase_uom on a product are compatible (e.g. cannot convert kg to ml).
enum uom_dimension_enum {
  mass
  volume
  /// Longitud, con base en milímetros: cable, manguera, tubo, cinta. Entró con
  /// QUI-648 para que una ferretería pueda vender por metro y por rollo.
  length
  count
}

/// Waste mode of a recipe_items line. `percent` applies waste_percent as a
/// percentage (current behaviour); `absolute` adds `waste_absolute` in the
/// component's minimum stock unit before rounding (allows exact quantities
/// like "300 ml + 20 ml de merma" without % math).
enum waste_mode_enum {
  percent
  absolute
}

/// A bill of materials / recipe for a single sellable product. One recipe
/// per product (UNIQUE on product_id). Components are stored in
/// recipe_items and must themselves be products in the same store
/// (is_ingredient=true is a soft signal, not enforced at DB level so
/// stock items and prepared items can be mixed).
model recipes {
  id                Int       @id @default(autoincrement())
  store_id          Int
  product_id        Int       @unique
  yield_quantity    Decimal   @db.Decimal(12, 4)
  yield_unit        String    @db.VarChar(20)
  waste_percent     Decimal   @default(0) @db.Decimal(5, 2)
  preparation_notes String?   @db.Text
  is_active         Boolean   @default(true)
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @default(now()) @db.Timestamp(6)

  store             stores              @relation(fields: [store_id], references: [id], onUpdate: NoAction)
  product           products            @relation(fields: [product_id], references: [id], onUpdate: NoAction)
  items             recipe_items[]
  production_orders production_orders[]

  @@index([store_id, is_active])
}

/// A single component line of a recipe. The component is itself a product
/// (a raw ingredient, a sub-prep, or a stock item).
model recipe_items {
  id                   Int             @id @default(autoincrement())
  recipe_id            Int
  component_product_id Int
  quantity             Decimal         @db.Decimal(12, 4)
  waste_percent        Decimal         @default(0) @db.Decimal(5, 2)
  /// Mode of waste: percent (uses waste_percent) or absolute (uses
  /// waste_absolute in the component's minimum stock unit). Default
  /// `percent` preserves the legacy behaviour for all existing rows.
  waste_mode           waste_mode_enum @default(percent)
  /// Absolute waste, expressed in the component's minimum stock unit
  /// (e.g. ml, g, unit). Only honoured when `waste_mode='absolute'`.
  waste_absolute       Decimal         @default(0) @db.Decimal(12, 4)
  is_optional          Boolean         @default(false)
  created_at           DateTime?       @default(now()) @db.Timestamp(6)
  updated_at           DateTime?       @default(now()) @db.Timestamp(6)

  recipe            recipes  @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  component_product products @relation("recipe_items_component_product", fields: [component_product_id], references: [id], onUpdate: NoAction)

  @@unique([recipe_id, component_product_id])
  @@index([component_product_id])
}

/// A production run that consumes recipe items and produces finished goods.
/// Stock effects are posted via inventory_movements with
/// movement_type_enum in ('production', 'consumption') — this table is the
/// control record (who, when, planned vs actual qty, status).
model production_orders {
  id           Int                         @id @default(autoincrement())
  store_id     Int
  product_id   Int
  recipe_id    Int
  planned_qty  Decimal                     @db.Decimal(12, 4)
  produced_qty Decimal?                    @db.Decimal(12, 4)
  status       production_order_state_enum @default(draft)
  produced_at  DateTime?                   @db.Timestamp(6)
  created_at   DateTime?                   @default(now()) @db.Timestamp(6)
  updated_at   DateTime?                   @default(now()) @db.Timestamp(6)

  store   stores   @relation(fields: [store_id], references: [id], onUpdate: NoAction)
  product products @relation(fields: [product_id], references: [id], onUpdate: NoAction)
  recipe  recipes  @relation(fields: [recipe_id], references: [id], onUpdate: NoAction)

  @@index([store_id, status])
  @@index([store_id, product_id])
  @@index([store_id, created_at])
}

/// A physical table in a restaurant floor. Optional position (pos_x, pos_y)
/// supports a 2D floor-plan view; the schema is intentionally simple to
/// allow multiple visualization strategies in Fase B+ frontend.
model tables {
  id           Int               @id @default(autoincrement())
  store_id     Int
  name         String            @db.VarChar(100)
  zone         String?           @db.VarChar(100)
  capacity     Int?
  status       table_status_enum @default(available)
  pos_x        Int?
  pos_y        Int?
  public_token String            @unique @db.VarChar(64)
  created_at   DateTime?         @default(now()) @db.Timestamp(6)
  updated_at   DateTime?         @default(now()) @db.Timestamp(6)

  store         stores           @relation(fields: [store_id], references: [id], onUpdate: NoAction)
  sessions      table_sessions[]
  bookings      bookings[]
  table_waiters table_waiters[]
  kitchen_tickets kitchen_tickets[]

  @@unique([store_id, name])
  @@index([store_id, status])
  @@index([store_id, zone])
}

/// A single "seating" event at a table. One table_session groups an order
/// and (optionally) a kitchen_ticket stream until the table is closed.
/// `opened_by` is the staff user (server / cashier) who seated the guests.
model table_sessions {
  id          Int       @id @default(autoincrement())
  store_id    Int
  table_id    Int
  order_id    Int
  opened_by   Int?
  opened_at   DateTime  @default(now()) @db.Timestamp(6)
  closed_at   DateTime? @db.Timestamp(6)
  /// carril D / D1 — instante en que la mesa queda pagada en POS.
  /// NULL = aún sin pagar. Distingue "ocupada pagada" de "ocupada sin pagar"
  /// sin necesidad de un JOIN contra `payments`. La mesa sigue ocupada hasta
  /// que el mesero la libere explícitamente (closed_at sigue independiente).
  paid_at     DateTime? @db.Timestamp(6)
  guest_count Int?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)

  store  stores @relation(fields: [store_id], references: [id], onUpdate: NoAction)
  table  tables @relation(fields: [table_id], references: [id], onUpdate: NoAction)
  order  orders @relation(fields: [order_id], references: [id], onUpdate: NoAction)
  opener users? @relation("table_sessions_opened_by", fields: [opened_by], references: [id], onUpdate: NoAction)

  @@index([store_id, table_id])
  @@index([store_id, order_id])
  @@index([store_id, closed_at])
  @@index([store_id, paid_at])
}

/// A fire order routed to the kitchen (KDS — kitchen display system).
/// Multiple tickets per order are allowed (e.g. starter, main, dessert
/// fire in separate waves). Per-item state lives in kitchen_ticket_items.
model kitchen_tickets {
  id            Int                       @id @default(autoincrement())
  store_id      Int
  order_id      Int
  table_id      Int?
  /// QUI-651 — estación que prepara este ticket. NOT NULL: un ticket sin
  /// estación no se puede mostrar en ningún tablero. Se resuelve en el fire por
  /// la cascada skip_kds -> products.kds_id -> KDS por defecto de la tienda.
  kds_id        Int
  status        kitchen_ticket_state_enum @default(pending)
  daily_number  Int?
  business_date DateTime?                 @db.Date
  fired_at      DateTime                  @default(now()) @db.Timestamp(6)
  ready_at      DateTime?                 @db.Timestamp(6)
  created_at    DateTime?                 @default(now()) @db.Timestamp(6)
  updated_at    DateTime?                 @default(now()) @db.Timestamp(6)

  store stores                 @relation(fields: [store_id], references: [id], onUpdate: NoAction)
  order orders                 @relation(fields: [order_id], references: [id], onUpdate: NoAction)
  kds   kds                    @relation(fields: [kds_id], references: [id], onUpdate: NoAction)
  // CP-POLLO-ARABE-727 A.3 — la columna table_id YA EXISTE (creada en
  // 20260613000000_restaurant_suite_foundation); aquí solo se le declara la FK.
  table tables?                @relation(fields: [table_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  items kitchen_ticket_items[]

  /// El consecutivo diario es POR ESTACIÓN, no por tienda: cada tablero cuenta
  /// desde 1, así cocina canta #1 y barra canta #1 el mismo día. El número
  /// identifica al ticket DENTRO de la estación donde se canta en voz alta.
  /// Con el unique global anterior, un fire de dos estaciones consumía dos
  /// números y cada tablero veía la secuencia con huecos (8, 10, 13...).
  @@unique([store_id, kds_id, business_date, daily_number])
  @@index([store_id, status])
  @@index([store_id, order_id])
  @@index([store_id, fired_at])
  @@index([store_id, business_date])
  @@index([kds_id, status])
}

/// A single line on a kitchen ticket. Tracks per-item state and optional
/// kitchen-side notes (e.g. "no onions", "allergy: gluten").
model kitchen_ticket_items {
  id                Int                            @id @default(autoincrement())
  kitchen_ticket_id Int
  order_item_id     Int
  product_id        Int
  // CP-POLLO-ARABE-727 A.3: denormalización de la variante en el ticket de
  // cocina. product_variant_id es nullable (SET NULL si la variante se borra);
  // variant_label es un snapshot inmutable al fire (no varía si
  // product_variants.name cambia después).
  product_variant_id Int?
  variant_label      String?                    @db.VarChar(120)
  quantity          Int
  status            kitchen_ticket_item_state_enum @default(pending)
  notes             String?                        @db.Text
  created_at        DateTime?                      @default(now()) @db.Timestamp(6)
  updated_at        DateTime?                      @default(now()) @db.Timestamp(6)

  kitchen_ticket kitchen_tickets                  @relation(fields: [kitchen_ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order_item     order_items                      @relation(fields: [order_item_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  product        products                         @relation(fields: [product_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  product_variant product_variants?                @relation(fields: [product_variant_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  exclusions     kitchen_ticket_item_exclusions[]

  @@index([kitchen_ticket_id])
  @@index([order_item_id])
  @@index([product_id])
  @@index([status])
}

// ===== EXCLUSIONES DE INSUMOS (QUI-655) =====
//
// Un plato pedido sin un ingrediente CONSUMIA ese ingrediente del inventario y
// lo cargaba al costo igual: `fireOrderItems` explotaba la receta y consumia
// TODAS las hojas del BOM sin punto donde alguien dijera "este plato va sin
// papas". El inventario quedaba descuadrado contra la realidad fisica y el
// margen del plato subestimado.
//
// Son DOS registros con roles distintos, y la diferencia entre ambos es dato de
// auditoria:
//
//   - LA INTENCION (`order_item_exclusions`): lo que el cliente pidio al
//     ordenar, cuando alguien lo capturo. Es OPCIONAL y puede estar vacia — la
//     captura al pedir no es obligatoria y la nota de texto libre requiere que
//     el cocinero la traduzca.
//
//   - LO CONSUMIDO (`kitchen_ticket_item_exclusions`): lo que efectivamente se
//     excluyo al confirmar el modal de cocina. Es lo que se costeo y lo que
//     explica el margen. SIEMPRE existe cuando hubo exclusion.
//
// Ninguna de las dos necesita `unit_index`: con la particion de linea la linea
// ya es homogenea y la exclusion aplica a TODA la linea. Ese es buena parte del
// atractivo de partir.

model order_item_exclusions {
  id                   Int       @id @default(autoincrement())
  order_item_id        Int
  component_product_id Int
  /// Procedencia de la linea del BOM, root-first, tal como la expone
  /// `BomExplosionLine.path_recipe_ids`. Permite excluir un NODO de sub-receta
  /// completo ("sin salsa criolla") en vez de obligar a desmarcar sus tres hojas
  /// y a saber de memoria cuales venian de la salsa.
  path_recipe_ids      Int[]
  created_by_user_id   Int?
  created_at           DateTime? @default(now()) @db.Timestamp(6)

  order_item        order_items @relation(fields: [order_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  component_product products    @relation("order_item_exclusion_component", fields: [component_product_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  created_by_user   users?      @relation("order_item_exclusions_created_by", fields: [created_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([order_item_id, component_product_id])
  @@index([order_item_id])
  @@index([component_product_id])
}

model kitchen_ticket_item_exclusions {
  id                     Int       @id @default(autoincrement())
  kitchen_ticket_item_id Int
  component_product_id   Int
  path_recipe_ids        Int[]
  excluded_by_user_id    Int?
  created_at             DateTime? @default(now()) @db.Timestamp(6)

  kitchen_ticket_item kitchen_ticket_items @relation(fields: [kitchen_ticket_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  component_product   products             @relation("kti_exclusion_component", fields: [component_product_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  excluded_by_user    users?               @relation("kti_exclusions_excluded_by", fields: [excluded_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([kitchen_ticket_item_id, component_product_id])
  @@index([kitchen_ticket_item_id])
  @@index([component_product_id])
}

/// A named menu that bundles sections of products. Multiple menus per store
/// are allowed (e.g. "Lunch", "Dinner", "Weekend Brunch"). Sections live in
/// menu_sections; availability windows (time-of-day, day-of-week) live in
/// menu_availability_windows.
model menus {
  id         Int       @id @default(autoincrement())
  store_id   Int
  name       String    @db.VarChar(100)
  is_active  Boolean   @default(true)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  store                stores                      @relation(fields: [store_id], references: [id], onUpdate: NoAction)
  sections             menu_sections[]
  availability_windows menu_availability_windows[]

  @@unique([store_id, name])
  @@index([store_id, is_active])
}

/// A section (e.g. "Entradas", "Platos Fuertes", "Postres") inside a menu.
/// Sections can themselves be subject to availability windows (e.g. a
/// "Breakfast" section only available 06:00–11:00) — store_id is denormalized
/// to support that without traversing the menu relation.
model menu_sections {
  id         Int       @id @default(autoincrement())
  menu_id    Int
  store_id   Int
  name       String    @db.VarChar(100)
  sort_order Int       @default(0)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  menu                 menus                       @relation(fields: [menu_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  store                stores                      @relation(fields: [store_id], references: [id], onUpdate: NoAction)
  items                menu_section_items[]
  availability_windows menu_availability_windows[]

  @@unique([menu_id, name])
  @@index([store_id])
  @@index([menu_id, sort_order])
}

/// A product that appears inside a menu section. No quantity, no price —
/// pricing is read live from the product row. `sort_order` is per-section.
model menu_section_items {
  id              Int       @id @default(autoincrement())
  menu_section_id Int
  product_id      Int
  sort_order      Int       @default(0)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  updated_at      DateTime? @default(now()) @db.Timestamp(6)

  menu_section menu_sections @relation(fields: [menu_section_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product      products      @relation(fields: [product_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([menu_section_id, product_id])
  @@index([product_id])
  @@index([menu_section_id, sort_order])
}

/// Time-of-day availability rule attached to a menu (whole menu) or a
/// single menu section. Both FKs are nullable so the same window table can
/// express menu-level and section-level rules. Exactly one of (menu_id,
/// menu_section_id) should be non-null at the application layer; the
/// schema allows both null for system-wide default rules and we leave that
/// flexibility to Fase B service logic.
model menu_availability_windows {
  id              Int       @id @default(autoincrement())
  store_id        Int
  menu_id         Int?
  menu_section_id Int?
  day_of_week     Int
  start_time      String    @db.VarChar(8)
  end_time        String    @db.VarChar(8)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  updated_at      DateTime? @default(now()) @db.Timestamp(6)

  store        stores         @relation(fields: [store_id], references: [id], onUpdate: NoAction)
  menu         menus?         @relation(fields: [menu_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  menu_section menu_sections? @relation(fields: [menu_section_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([store_id, day_of_week])
  @@index([menu_id])
  @@index([menu_section_id])
}

// ===== DISPATCH ROUTES SYSTEM (Planillas de Despacho / Rutas DSD) =====

enum dispatch_route_status_enum {
  draft
  dispatched
  in_transit
  closed
  voided
}

/// Plan Despacho Economía — FASE 6 paso 19.
/// Estado de cumplimiento del despacho para una orden:
///   none    → aún no tiene remisiones.
///   partial → al menos una línea está total o parcialmente remitida
///             (quedan unidades pendientes). Aparece con `remaining_units > 0`.
///   full    → todas las líneas están totalmente remitidas (no es despachable).
/// Mantenido por listener en `dispatch_note.confirmed/voided/delivered`.
/// El valor `settling` queda como `reserved` en este enum sólo por
/// consistencia histórica; nunca se escribe.
enum dispatch_fulfillment_enum {
  none
  partial
  full
}

enum dispatch_route_stop_status_enum {
  pending
  in_progress
  delivered
  partial
  rejected
  released
}

enum dispatch_route_stop_result_enum {
  delivered
  partial
  rejected
  released
}

enum vehicle_type_enum {
  motorcycle
  car
  truck
  van
  bicycle
  other
}

model vehicles {
  id                 Int                  @id @default(autoincrement())
  store_id           Int
  plate              String               @db.VarChar(20)
  type               vehicle_type_enum    @default(truck)
  brand              String?              @db.VarChar(80)
  model_name         String?              @db.VarChar(80)
  capacity_kg        Decimal?             @db.Decimal(10, 2)
  capacity_units     Int?
  primary_driver_id  Int?
  is_active          Boolean              @default(true)
  notes              String?              @db.Text
  // Plan Despacho Economía — costo del ejecutor (FASE 1 paso 6).
  // `none` ⇒ costo 0 (sueldo interno, nóminas fuera del modelo).
  // `per_delivery` ⇒ settlement_rate × paradas que cuentan.
  // `per_route` ⇒ settlement_rate fijo por ruta cerrada.
  settlement_type    settlement_type_enum @default(none)
  settlement_rate    Decimal?             @db.Decimal(12, 2)
  created_by_user_id Int?
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  updated_at         DateTime?            @default(now()) @db.Timestamp(6)

  store               stores             @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  primary_driver      users?             @relation("vehicles_primary_driver", fields: [primary_driver_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  created_by_user     users?             @relation("vehicles_created_by", fields: [created_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  dispatch_routes     dispatch_routes[]
  // Plan Despacho Economía — FASE 2 paso 8. Contraparte de la relación
  // shipping_methods.default_vehicle_id → vehicles.id.
  default_for_methods shipping_methods[] @relation("shipping_methods_default_vehicle")

  @@unique([store_id, plate])
  @@index([store_id, is_active])
  @@index([primary_driver_id])
}

model dispatch_routes {
  id                           Int                        @id @default(autoincrement())
  store_id                     Int
  route_number                 String                     @db.VarChar(50)
  route_code                   String?                    @db.VarChar(20)
  status                       dispatch_route_status_enum @default(draft)
  vehicle_id                   Int?
  driver_user_id               Int?
  external_driver_name         String?                    @db.VarChar(255)
  external_driver_id_number    String?                    @db.VarChar(50)
  is_primary_driver_external   Boolean                    @default(false)
  // Carrier Pool (Repartos Fase B4) — distingue rutas de repartidor (rol carrier)
  // de las planillas de despacho DSD tradicionales. Filas existentes = false.
  is_carrier_route             Boolean                    @default(false)
  assistants                   Json?
  origin_location_id           Int?
  planned_date                 DateTime                   @db.Timestamp(6)
  dispatch_started_at          DateTime?                  @db.Timestamp(6)
  closed_at                    DateTime?                  @db.Timestamp(6)
  voided_at                    DateTime?                  @db.Timestamp(6)
  total_to_collect             Decimal                    @default(0) @db.Decimal(14, 2)
  total_collected              Decimal                    @default(0) @db.Decimal(14, 2)
  total_prepaid                Decimal                    @default(0) @db.Decimal(14, 2)
  total_changes                Decimal                    @default(0) @db.Decimal(14, 2)
  total_withholdings           Decimal                    @default(0) @db.Decimal(14, 2)
  total_credit                 Decimal                    @default(0) @db.Decimal(14, 2)
  declared_cash                Decimal?                   @db.Decimal(14, 2)
  cash_variance                Decimal?                   @db.Decimal(14, 2)
  currency                     String?                    @db.VarChar(10)
  planilla_pdf_key             String?                    @db.Text
  planilla_scanned_at          DateTime?                  @db.Timestamp(6)
  scan_result                  Json?
  scan_confidence              Decimal?                   @db.Decimal(5, 4)
  notes                        String?                    @db.Text
  void_reason                  String?                    @db.Text
  // Plan Despacho Economía — FASE 3 paso 11.
  // El método de envío es la "política" que gobierna la ruta. La fuente de
  // verdad final es `stops→dispatch_notes.order_id→orders.shipping_method_id`,
  // pero este FK permite override explícito (recomendado: una ruta agrupa
  // remisiones del mismo método).
  shipping_method_id           Int?
  // Transportista externo (supplier carrier). Usado por el settlement del
  // FASE 5 cuando `generates_transport_cost` ≠ 'none' y el ejecutor no es
  // propio (carrier | third_party_provider).
  external_carrier_supplier_id Int?
  dispatched_by_user_id        Int?
  closed_by_user_id            Int?
  voided_by_user_id            Int?
  created_by_user_id           Int?
  created_at                   DateTime?                  @default(now()) @db.Timestamp(6)
  updated_at                   DateTime?                  @default(now()) @db.Timestamp(6)

  store              stores                 @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vehicle            vehicles?              @relation(fields: [vehicle_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  driver_user        users?                 @relation("dispatch_routes_driver", fields: [driver_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  dispatched_by_user users?                 @relation("dispatch_routes_dispatcher", fields: [dispatched_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  closed_by_user     users?                 @relation("dispatch_routes_closed_by", fields: [closed_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  voided_by_user     users?                 @relation("dispatch_routes_voided_by", fields: [voided_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  origin_location    inventory_locations?   @relation("dispatch_routes_origin_location", fields: [origin_location_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  shipping_method    shipping_methods?      @relation("dispatch_routes_shipping_method", fields: [shipping_method_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  external_carrier   suppliers?             @relation("dispatch_routes_external_carrier", fields: [external_carrier_supplier_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  stops              dispatch_route_stops[]

  @@unique([store_id, route_number])
  @@index([store_id, status])
  @@index([store_id, planned_date])
  @@index([vehicle_id])
  @@index([driver_user_id])
  @@index([shipping_method_id])
  @@index([external_carrier_supplier_id])
}

model dispatch_route_stops {
  id                    Int                              @id @default(autoincrement())
  route_id              Int
  // Plan Despacho Economía — FASE 6 paso 18. La unicidad activa en BD la da
  // el índice PARCIAL `dispatch_route_stops_dispatch_note_id_active_idx` (creado
  // en la migración 20260618200000_dispatch_routes) que aplica sólo cuando
  // `status <> 'released'`. Mantenemos la columna sin `@unique` para no
  // invitar a `prisma migrate diff` a recrear un índice total que rompería
  // la reasignación de remisiones liberadas.
  dispatch_note_id      Int
  stop_sequence         Int
  status                dispatch_route_stop_status_enum  @default(pending)
  result                dispatch_route_stop_result_enum?
  is_extra_route        Boolean                          @default(false)
  is_prepaid            Boolean                          @default(false)
  collected_amount      Decimal                          @default(0) @db.Decimal(14, 2)
  anticipo_amount       Decimal                          @default(0) @db.Decimal(14, 2)
  change_amount         Decimal                          @default(0) @db.Decimal(14, 2)
  withholding_amount    Decimal                          @default(0) @db.Decimal(14, 2)
  withholding_breakdown Json?
  credit_amount         Decimal                          @default(0) @db.Decimal(14, 2)
  payment_method        String?                          @db.VarChar(40)
  notes                 String?                          @db.Text
  settled_at            DateTime?                        @db.Timestamp(6)
  released_at           DateTime?                        @db.Timestamp(6)
  settled_by_user_id    Int?
  created_at            DateTime?                        @default(now()) @db.Timestamp(6)
  updated_at            DateTime?                        @default(now()) @db.Timestamp(6)

  route           dispatch_routes               @relation(fields: [route_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dispatch_note   dispatch_notes                @relation(fields: [dispatch_note_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  settled_by_user users?                        @relation("dispatch_route_stops_settled_by", fields: [settled_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  history         dispatch_route_stop_history[]

  @@index([route_id, stop_sequence])
  @@index([status])
}

model dispatch_route_stop_history {
  id          Int       @id @default(autoincrement())
  stop_id     Int
  action      String    @db.VarChar(40)
  from_status String?   @db.VarChar(40)
  to_status   String?   @db.VarChar(40)
  reason      String?   @db.Text
  released_by Int?
  metadata    Json?
  created_at  DateTime? @default(now()) @db.Timestamp(6)

  stop             dispatch_route_stops @relation(fields: [stop_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  released_by_user users?               @relation("dispatch_route_stop_history_released_by", fields: [released_by], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([stop_id, created_at])
  @@index([action])
}

/// QUI-647 — cuotas PLANEADAS del pago de una orden de compra.
///
/// El motor de cobro sigue siendo `ap_payment_schedules`, que cuelga de
/// `accounts_payable`. Pero la CxP no existe cuando se crea la orden: nace
/// atada a la RECEPCIÓN (`ap_reception_links`). Esta tabla es el puente donde
/// vive el calendario acordado con el proveedor hasta que haya CxP a la cual
/// colgarlo; al materializarse, las filas se copian y se marcan.
model purchase_order_payment_schedules {
  id                Int       @id @default(autoincrement())
  purchase_order_id Int
  scheduled_date    DateTime  @db.Date
  amount            Decimal   @db.Decimal(12, 2)
  /// `planned` mientras espera CxP; `materialized` una vez copiada.
  status            String    @default("planned") @db.VarChar(20)
  materialized_at   DateTime? @db.Timestamp(6)
  created_at        DateTime  @default(now()) @db.Timestamp(6)

  purchase_orders purchase_orders @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade)

  @@index([purchase_order_id])
}

// ============================================================================
// Customer fiscal data (QUI-728) — DIAN Anexo Técnico 19 customer party
// ============================================================================
//
// These enums replace the previous free-form `String?` columns on `users`
// (`document_type`, `tax_regime`, `person_type`) and back-fill the legacy
// VARCHAR values in place using `USING ...::enum` — see the migration that
// ships with this schema change. Values mirror the published DIAN catalogs:
// `identification_type_enum` matches the 10 internal document type codes in
// `common/constants/document-types.ts`; `tax_regime_enum` covers the 6
// Colombian fiscal regimes; `person_type_enum` is the binary
// natural/jurídica switch consumed by the UBL builder to branch between
// `cac:Person` and `cac:PartyLegalEntity`.

enum identification_type_enum {
  CC
  CE
  NIT
  TI
  RC
  PA
  PEP
  PPT
  DIE
  NUIP
}

enum persona_type_enum {
  NATURAL
  JURIDICA
}

enum tax_regime_enum {
  COMUN
  SIMPLIFICADO
  GRAN_CONTRIBUYENTE
  AUTORRETENEDOR
  ESPECIAL
  NO_APLICA
}

// ============================================================================
// Régimen AIU — componente de una línea de factura
// ============================================================================
//
// En ciertos servicios el IVA no grava el valor total del contrato sino un
// subconjunto, y la factura se desglosa en Administración + Imprevistos +
// Utilidad. Qué subconjunto es la base gravable depende del régimen, y son DOS:
//
//   · E.T. art. 462-1 — servicios integrales de aseo y cafetería, vigilancia,
//     y servicios temporales de empleo: la tarifa se aplica sobre el AIU
//     COMPLETO (A+I+U), que además no puede ser inferior al 10% del valor del
//     contrato.
//   · Decreto 1372/1992 art. 3 — contratos de construcción de bien inmueble:
//     la base es ÚNICAMENTE la Utilidad del constructor.
//
// Confundirlos no produce un error visible: produce una factura que declara
// menos IVA del que debía, aceptada por la DIAN y corregible solo con nota.
// Por eso el régimen es configuración explícita de la tienda
// (`store_settings.invoicing.aiu`) y no se deduce de los datos de la línea.
//
// La línea declara a qué componente pertenece para que la base se calcule sobre
// el subconjunto correcto, y la cabecera lo marca con
// `invoices.operation_type` = '09' (`cbc:CustomizationID`, Anexo Técnico 1.9).
//
// `invoice_items.aiu_component` es NULLABLE: NULL = línea normal, no AIU.

enum aiu_component_enum {
  administracion
  imprevistos
  utilidad
  contrato
}
