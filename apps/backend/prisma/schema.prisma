model product_variants {
  id                            Int                             @id @default(autoincrement())
  product_id                    Int
  sku                           String                          @db.VarChar(100)
  barcode                       String?                         @db.VarChar(64)
  name                          String?                         @db.VarChar(255)
  price_override                Decimal?                        @db.Decimal(12, 2)
  cost_price                    Decimal?                        @db.Decimal(12, 2)
  profit_margin                 Decimal?                        @db.Decimal(5, 2)
  is_on_sale                    Boolean                         @default(false)
  sale_price                    Decimal?                        @db.Decimal(12, 2)
  stock_quantity                Int                             @default(0)
  track_inventory_override      Boolean?
  // Service-specific overrides (null = inherit from parent product)
  service_duration_minutes      Int?
  service_pricing_type          service_pricing_type_enum?
  buffer_minutes                Int?
  preparation_time_minutes      Int?
  attributes                    Json?
  image_id                      Int?
  /// Subcuenta PUC de INGRESO propia de ESTA variante. Gana sobre
  /// `products.account_code` porque la variante es la unidad realmente vendida:
  /// dos presentaciones del mismo producto pueden pertenecer a líneas de negocio
  /// distintas y el mapping por producto no sabría separarlas.
  ///
  /// NULL ⇒ hereda de `products.account_code`; si el producto tampoco la define,
  /// cae al mapping por defecto. Es decir NULL = comportamiento histórico, cero
  /// impacto en variantes existentes.
  ///
  /// Mismas reglas que `products.account_code`: debe existir en
  /// `chart_of_accounts` de la organización y tener `accepts_entries = true`.
  /// Mismo patrón que `withholding_concepts.account_code`.
  account_code                  String?                         @db.VarChar(20)
  created_at                    DateTime?                       @default(now()) @db.Timestamp(6)
  updated_at                    DateTime?                       @default(now()) @db.Timestamp(6)
  bookings                      bookings[]
  inventory_adjustments         inventory_adjustments[]
  inventory_batches             inventory_batches[]
  inventory_movements           inventory_movements[]
  inventory_serial_numbers      inventory_serial_numbers[]
  inventory_transactions        inventory_transactions[]
  order_items                   order_items[]
  product_images                product_images?                 @relation(fields: [image_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  products                      products                        @relation(fields: [product_id], references: [id], onUpdate: NoAction)
  purchase_order_items          purchase_order_items[]
  return_order_items            return_order_items[]
  sales_order_items             sales_order_items[]
  stock_levels                  stock_levels[]
  stock_reservations            stock_reservations[]
  stock_transfer_items          stock_transfer_items[]
  supplier_products             supplier_products[]             @relation("product_variantsTosupplier_products")
  cart_items                    cart_items[]
  wishlist_items                wishlist_items[]
  invoice_items                 invoice_items[]
  quotation_items               quotation_items[]
  inventory_cost_layers         inventory_cost_layers[]
  inventory_valuation_snapshots inventory_valuation_snapshots[]
  layaway_items                 layaway_items[]
  dispatch_note_items           dispatch_note_items[]
  kitchen_ticket_items          kitchen_ticket_items[]

  // Multi-tarifa overrides (Phase 1: price tiers)
  price_tier_overrides product_price_tier_overrides[]

  @@unique([product_id, sku])
  @@index([barcode])
}

model products {
  id                             Int                              @id @default(autoincrement())
  store_id                       Int
  brand_id                       Int?
  name                           String                           @db.VarChar(255)
  slug                           String                           @db.VarChar(255)
  description                    String?
  base_price                     Decimal                          @db.Decimal(12, 2)
  /// A cuántas unidades de stock corresponde `base_price` (la *price unit* de
  /// SAP). Un cable con el stock en milímetros guarda `base_price = 5000` y
  /// `price_unit_quantity = 1000`: "$5.000 por metro". El total de una línea es
  /// `unit_price * quantity / price_unit_quantity`. Con el default `1` la
  /// aritmética es idéntica a la histórica, así que ningún producto existente
  /// cambia de precio.
  price_unit_quantity            Int                              @default(1)
  cost_price                     Decimal?                         @db.Decimal(12, 2)
  profit_margin                  Decimal?                         @db.Decimal(5, 2)
  sku                            String?                          @db.VarChar(100)
  barcode                        String?                          @db.VarChar(64)
  stock_quantity                 Int?                             @default(0)
  state                          product_state_enum               @default(inactive)
  pricing_type                   pricing_type_enum                @default(unit)
  product_type                   product_type_enum                @default(physical)
  service_duration_minutes       Int?
  service_modality               service_modality_enum?
  service_pricing_type           service_pricing_type_enum?
  requires_booking               Boolean                          @default(false)
  booking_mode                   booking_mode_enum                @default(provider_required)
  buffer_minutes                 Int?                             @default(0)
  is_recurring                   Boolean                          @default(false)
  service_instructions           String?                          @db.Text
  preparation_time_minutes       Int?
  is_consultation                Boolean                          @default(false)
  send_preconsultation           Boolean                          @default(false)
  consultation_template_id       Int?
  consultation_template          data_collection_templates?       @relation("product_consultation_template", fields: [consultation_template_id], references: [id], onDelete: SetNull)
  preconsultation_template_id    Int?
  preconsultation_template       data_collection_templates?       @relation("product_preconsultation_template", fields: [preconsultation_template_id], references: [id], onDelete: SetNull)
  available_for_ecommerce        Boolean                          @default(false)
  is_featured                    Boolean                          @default(false)
  online_purchase_url            String?                          @db.Text
  online_purchase_qr_code        String?                          @db.Text
  online_purchase_domain_id      Int?
  online_purchase_generated_at   DateTime?                        @db.Timestamp(6)
  allow_pos_price_override       Boolean                          @default(false)
  is_on_sale                     Boolean                          @default(false)
  sale_price                     Decimal?                         @db.Decimal(12, 2)
  weight                         Decimal?                         @db.Decimal(12, 3)
  dimensions                     Json?
  track_inventory                Boolean                          @default(true)
  min_stock_level                Int?                             @default(0)
  max_stock_level                Int?                             @default(0)
  reorder_point                  Int?                             @default(0)
  reorder_quantity               Int?                             @default(0)
  requires_serial_numbers        Boolean                          @default(false)
  requires_batch_tracking        Boolean                          @default(false)
  // ===== Restaurant Suite Foundation (Fase A) =====
  // These flags are ADDITIVE. Existing products keep default behavior:
  // is_sellable=true (visible in catalog), is_ingredient=false (not a raw
  // material), is_combo=false, is_batch_produced=false. Retail flow is
  // unaffected. stock_unit / purchase_unit / purchase_to_stock_factor are
  // nullable to preserve backward compatibility for non-restaurant stores.
  is_sellable                    Boolean                          @default(true)
  is_ingredient                  Boolean                          @default(false)
  is_combo                       Boolean                          @default(false)
  is_batch_produced              Boolean                          @default(false)
  /// Appointment redesign phase 2 — whether this product/service is
  /// eligible to be performed at the customer's home
  /// (when `bookings.service_location_type = 'home'`). When false, the
  /// ecommerce booking flow forces `shop` and hides the "A domicilio"
  /// selector for this product only (the rest of the catalog keeps
  /// its own flag). Defaults to `false` for backward compatibility.
  is_eligible_for_home_service   Boolean                          @default(false)
  stock_unit                     String?                          @db.VarChar(20)
  purchase_unit                  String?                          @db.VarChar(20)
  purchase_to_stock_factor       Int?
  stock_uom_id                   Int?
  purchase_uom_id                Int?
  stock_uom                      units_of_measure?                @relation("product_stock_uom", fields: [stock_uom_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  purchase_uom                   units_of_measure?                @relation("product_purchase_uom", fields: [purchase_uom_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  // Multi-tarifa (Phase 1: price tiers).
  // Packaging quantity (units-per-package) now lives on the price tier
  // (price_tiers.units_per_package) with an optional per-product override
  // (product_price_tier_overrides.override_units_per_package). The product
  // no longer owns packaging fields.
  has_multiple_price_tiers       Boolean                          @default(false)
  /// Si la vitrina pública ofrece TAMBIÉN la unidad suelta del producto, además
  /// de sus presentaciones (bulto, caja, six-pack).
  ///
  /// QUÉ: es la opción que el POS llama "Default (sin tarifa)" —la línea sin
  /// `price_tier_id`, cobrada al precio base—. El ecommerce nunca la ofrecía:
  /// solo listaba las tarifas `sale_unit` asignadas, así que un producto con
  /// UNA presentación no mostraba selector (el frontend exige más de una
  /// opción) y su "desde" salía al precio del paquete en vez del de la unidad.
  ///
  /// POR QUÉ ES UNA COLUMNA Y NO UNA CONSTANTE: hay negocios que venden la
  /// botella y la caja, y otros que solo venden por caja aunque el inventario
  /// se lleve en botellas. Para los segundos, ofrecer la unidad suelta es
  /// publicar un precio al que no piensan vender.
  ///
  /// `true` por defecto — el comportamiento nuevo es el que se parece al POS, y
  /// apagarlo es la decisión explícita del comercio. Con la unidad suelta
  /// apagada, la presentación por defecto pasa a ser la marcada en
  /// `product_price_tier_assignments.is_default`, o la primera publicable si no
  /// hay ninguna marcada.
  offer_loose_unit               Boolean                          @default(true)
  /// Subcuenta PUC de INGRESO propia de este producto (p. ej. `413550` para una
  /// línea de comercio al por menor que el contador quiere separar de `4135`).
  ///
  /// QUÉ: override del catálogo vivo. Cuando está presente, el asiento de la
  /// factura acredita ESTA cuenta en vez de la que resuelve el mapping
  /// `invoice.validated.revenue`. Como cada línea resuelve su propia cuenta, una
  /// misma factura produce un asiento MIXTO: una línea de ingreso por cuenta
  /// resuelta, conviviendo con las que caen al ingreso por defecto.
  ///
  /// POR QUÉ: un PUC real no tiene una sola cuenta de ingreso. Sin esta columna
  /// la única salida es un asiento manual de reclasificación por cada venta, que
  /// es exactamente el trabajo que la contabilidad automática debía eliminar.
  ///
  /// NULL ⇒ comportamiento histórico: resolver por el mapping por defecto. Por
  /// eso la columna nace nullable y sin DEFAULT — ningún producto existente
  /// cambia de cuenta ni un solo asiento ya posteado se reescribe.
  ///
  /// El código debe existir en `chart_of_accounts` de la organización Y aceptar
  /// movimientos (`accepts_entries = true`): una cuenta de AGRUPACIÓN no puede
  /// recibir un asiento. Mismo patrón, mismo tipo y mismo ancho que el
  /// precedente ya probado `withholding_concepts.account_code`.
  ///
  /// OJO: NO es la cuenta que se contabiliza — es la cuenta VIGENTE. La que se
  /// contabiliza es el snapshot `invoice_items.account_code`, capturado al
  /// facturar. Ver el orden de resolución en `resolveInvoiceRevenueLines()`.
  account_code                   String?                          @db.VarChar(20)
  created_at                     DateTime?                        @default(now()) @db.Timestamp(6)
  updated_at                     DateTime?                        @default(now()) @db.Timestamp(6)
  inventory_adjustments          inventory_adjustments[]
  inventory_batches              inventory_batches[]
  inventory_movements            inventory_movements[]
  inventory_serial_numbers       inventory_serial_numbers[]
  inventory_transactions         inventory_transactions[]
  order_items                    order_items[]
  product_categories             product_categories[]
  product_images                 product_images[]
  product_tax_assignments        product_tax_assignments[]
  product_variants               product_variants[]
  brands                         brands?                          @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  online_purchase_domain         domain_settings?                 @relation("product_online_purchase_domain", fields: [online_purchase_domain_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  stores                         stores                           @relation(fields: [store_id], references: [id], onUpdate: NoAction)
  purchase_order_items           purchase_order_items[]
  return_order_items             return_order_items[]
  reviews                        reviews[]
  sales_order_items              sales_order_items[]
  stock_levels                   stock_levels[]
  stock_reservations             stock_reservations[]
  stock_transfer_items           stock_transfer_items[]
  supplier_products              supplier_products[]
  cart_items                     cart_items[]
  wishlist_items                 wishlist_items[]
  invoice_items                  invoice_items[]
  quotation_items                quotation_items[]
  promotion_products             promotion_products[]
  coupon_products                coupon_products[]
  marketing_ad_creative_products marketing_ad_creative_products[]
  inventory_cost_layers          inventory_cost_layers[]
  inventory_valuation_snapshots  inventory_valuation_snapshots[]
  layaway_items                  layaway_items[]

  // Bookings
  bookings          bookings[]
  provider_services provider_services[]

  // Dispatch Notes
  dispatch_note_items dispatch_note_items[]

  // Data Collection
  data_collection_template_products data_collection_template_products[]

  // Multi-tarifa overrides (Phase 1: price tiers)
  price_tier_overrides           product_price_tier_overrides[]
  product_price_tier_assignments product_price_tier_assignments[]

  // Restaurant Suite Foundation (Fase A) — back-relations
  recipe                    recipes?
  recipe_items_as_component recipe_items[]         @relation("recipe_items_component_product")
  production_orders         production_orders[]
  menu_section_items        menu_section_items[]
  kitchen_ticket_items      kitchen_ticket_items[]

  /// QUI-651 — estación de preparación del plato. Solo significativo para
  /// `product_type = 'prepared'`. NULL significa "cae en el KDS por defecto de
  /// la tienda", que es lo que hace funcionar el caso de una sola estación sin
  /// configurar nada. Las variantes NO sobrescriben esta estación: el ruteo es
  /// una propiedad de cómo se cocina el plato, no de qué opción se vendió.
  kds_id Int?
  kds    kds? @relation(fields: [kds_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  /// QUI-655 — back-relations de exclusion: este producto figura como el
  /// COMPONENTE excluido de la receta de otro plato.
  excluded_in_order_items   order_item_exclusions[]          @relation("order_item_exclusion_component")
  excluded_in_kitchen_items kitchen_ticket_item_exclusions[] @relation("kti_exclusion_component")

  @@unique([store_id, slug])
  @@unique([store_id, sku])
  @@unique([store_id, barcode])
  @@index([store_id, sku])
  @@index([store_id, barcode])
  @@index([store_id, product_type])
  @@index([store_id, is_ingredient])
  @@index([kds_id])
  @@index([stock_uom_id])
  @@index([purchase_uom_id])
  @@index([store_id, is_featured])
  @@index([store_id, is_consultation])
  @@index([online_purchase_domain_id])
  /// CP-PURCHASE-TRANSPARENCY D.0 — hoy NO existe ningún índice que incluya
  /// `state`, y las fases siguientes encienden un filtro por estado en las
  /// agregaciones de valoración: sin índice el planificador degrada a barrido
  /// secuencial al crecer el catálogo. `(state, id)` sirve el barrido global
  /// paginado por id; `(store_id, state)` sirve el mismo filtro dentro de una
  /// tienda, que es como lo consultan los reportes con scope.
  @@index([state, id])
  @@index([store_id, state])
}

// ===== PRICE TIERS (MULTI-TARIFA) =====

model price_tiers {
  id                  Int                  @id @default(autoincrement())
  store_id            Int
  name                String               @db.VarChar(255)
  code                String?              @db.VarChar(50)
  description         String?              @db.Text
  // Global rule: percent discount applied over base_price/sale_price when no
  // explicit override exists in product_price_tier_overrides. Stored as the
  // discount percentage itself (e.g. 15.00 means -15%).
  discount_percentage Decimal              @default(0) @db.Decimal(5, 2)
  is_active           Boolean              @default(true)
  is_default          Boolean              @default(false)
  // Discriminador de los dos ejes que conviven en esta tabla: tarifa de
  // cliente (a quién le vendo) vs unidad de venta (en qué presentación
  // vendo). Los selectores filtran por este campo para no mezclarlos.
  kind                price_tier_kind_enum @default(customer_tier)
  // When true, applying this tier is interpreted as selling by package
  // (caja/bulto). Derived from units_per_package: it is set true whenever
  // units_per_package >= 2.
  is_package_unit     Boolean              @default(false)
  // Packaging quantity owned by the tier (units per package, e.g. "Caja x6").
  // Optional. A product can override it via
  // product_price_tier_overrides.override_units_per_package. The effective
  // packSize cascade is: override_units_per_package ?? units_per_package ?? 1.
  units_per_package   Int?
  sort_order          Int                  @default(0)
  created_at          DateTime?            @default(now()) @db.Timestamp(6)
  updated_at          DateTime?            @default(now()) @db.Timestamp(6)

  store               stores                           @relation(fields: [store_id], references: [id], onUpdate: NoAction)
  product_overrides   product_price_tier_overrides[]
  product_assignments product_price_tier_assignments[]
  order_items         order_items[]                    @relation("order_items_applied_price_tier")
  quotation_items     quotation_items[]                @relation("quotation_items_applied_price_tier")
  sales_order_items   sales_order_items[]              @relation("sales_order_items_applied_price_tier")
  cart_items          cart_items[]                     @relation("cart_items_applied_price_tier")

  @@unique([store_id, name])
  @@index([store_id, is_active])
  @@index([store_id, kind, is_active])
}

model product_price_tier_overrides {
  id                         Int       @id @default(autoincrement())
  product_id                 Int
  variant_id                 Int?
  price_tier_id              Int
  // Explicit override price of the WHOLE PACKAGE. Optional. When present it
  // wins over the tier rule (price_tiers.discount_percentage). When absent the
  // package price is computed as base_unit_price * packSize * (1 - discount/100).
  override_price             Decimal?  @db.Decimal(12, 2)
  // Per-product override of the tier packaging quantity. Optional. Wins over
  // price_tiers.units_per_package in the packSize cascade.
  override_units_per_package Int?
  // Margen de la presentación, en porcentaje. Se deriva contra
  // `cost_price * packSize` (el costo del paquete completo), no contra el
  // costo unitario. Criterio cost-anchor: si llegan precio y margen juntos,
  // el precio explícito gana y el margen se recalcula a partir de él.
  override_profit_margin     Decimal?  @db.Decimal(5, 2)
  created_at                 DateTime? @default(now()) @db.Timestamp(6)
  updated_at                 DateTime? @default(now()) @db.Timestamp(6)

  product    products          @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variant    product_variants? @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  price_tier price_tiers       @relation(fields: [price_tier_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([product_id, variant_id, price_tier_id])
  @@index([price_tier_id])
}

model product_price_tier_assignments {
  product_id    Int
  price_tier_id Int
  /// Presentación por defecto del producto: preselección de la vitrina y
  /// fallback de toda superficie de venta (tienda online, POS, cotizaciones)
  /// cuando la línea no trae presentación explícita. En la tienda online el
  /// comprador puede elegir otra si el flag
  /// `ecommerce.catalog.enable_sale_unit_selector` está activo.
  ///
  /// La unicidad la garantiza un índice único PARCIAL que Prisma no puede
  /// expresar en el schema y vive solo en la migración:
  ///   CREATE UNIQUE INDEX ... ON product_price_tier_assignments (product_id)
  ///   WHERE is_default;
  /// No lo borres al regenerar: un `@@unique([product_id, is_default])` NO
  /// sirve (dejaría un solo `false` por producto). El índice no puede filtrar
  /// además por `kind` porque vive en otra tabla — que solo un `sale_unit`
  /// pueda marcarse lo garantiza el servicio.
  is_default    Boolean   @default(false)
  /// Código de barras del par (producto, presentación). La "Caja x12" de dos
  /// productos distintos nunca comparte código, y la caja no comparte código
  /// con la unidad suelta: por eso vive acá y no en `price_tiers`, que es de
  /// tienda. Pistolearlo agrega la línea con la presentación ya aplicada.
  ///
  /// La unicidad es POR TIENDA y la garantiza un índice único PARCIAL que
  /// Prisma no puede expresar y vive solo en la migración:
  ///   CREATE UNIQUE INDEX ... ON product_price_tier_assignments (store_id, barcode)
  ///   WHERE barcode IS NOT NULL;
  barcode       String?   @db.VarChar(64)
  /// Denormalizado del producto dueño. Existe SOLO para poder exigir la
  /// unicidad del barcode por tienda: un índice único no atraviesa un JOIN.
  store_id      Int?
  created_at    DateTime? @default(now()) @db.Timestamp(6)

  product    products    @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  price_tier price_tiers @relation(fields: [price_tier_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stores     stores?     @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@id([product_id, price_tier_id])
  @@index([price_tier_id])
  @@index([store_id])
}

model refund_items {
  id                      Int                  @id @default(autoincrement())
  refund_id               Int
  order_item_id           Int
  quantity                Int
  refund_amount           Decimal?             @db.Decimal(12, 2)
  tax_amount              Decimal?             @db.Decimal(12, 2)
  discount_amount         Decimal?             @db.Decimal(12, 2)
  inventory_action        String?              @default("no_return") @db.VarChar(20)
  /// Unidades mínimas de stock que esta devolución repone, proporcionales a
  /// `order_items.stock_units_consumed` de la línea original. Devolver 1 bulto
  /// de 50 repone 50, no 1. `null` = la línea no vendió en presentación y se
  /// repone `quantity`.
  stock_units_consumed    Int?
  location_id             Int?
  reason                  String?
  // QUI-431 serial tracking — immutable CSV snapshot of serial numbers returned
  // on this refund line. Strong link lives in sales_document_serials
  // (document_item_type = refund_item).
  serial_numbers_snapshot String?
  // Destination bank_account for refund_method='bank_transfer'. Nullable (most
  // refunds don't use it). SET NULL on bank_account delete preserves the audit
  // trail of historic refunds without blocking account deletion.
  bank_account_id         Int?
  created_at              DateTime?            @default(now()) @db.Timestamp(6)
  order_items             order_items          @relation(fields: [order_item_id], references: [id], onUpdate: NoAction)
  refunds                 refunds              @relation(fields: [refund_id], references: [id], onUpdate: NoAction)
  inventory_locations     inventory_locations? @relation(fields: [location_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  bank_accounts           bank_accounts?       @relation(fields: [bank_account_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

model refunds {
  id                    Int                @id @default(autoincrement())
  order_id              Int
  payment_id            Int?
  customer_id           Int?
  amount                Decimal            @db.Decimal(12, 2)
  subtotal_refund       Decimal?           @default(0) @db.Decimal(12, 2)
  tax_refund            Decimal?           @default(0) @db.Decimal(12, 2)
  shipping_refund       Decimal?           @default(0) @db.Decimal(12, 2)
  currency              String?            @db.VarChar(10)
  reason                String?
  notes                 String?            @db.Text
  state                 refunds_state_enum
  refund_method         String?            @db.VarChar(100)
  refund_transaction_id String?            @unique @db.VarChar(255)
  processed_by_user_id  Int?
  requested_at          DateTime?          @default(now()) @db.Timestamp(6)
  processed_at          DateTime?          @db.Timestamp(6)
  created_at            DateTime?          @default(now()) @db.Timestamp(6)
  updated_at            DateTime?          @default(now()) @db.Timestamp(6)
  // Respuesta cruda de la pasarela, igual que `payments.gateway_response`.
  // `payment-gateway.service.ts` ya la escribía sin que la columna existiera.
  gateway_response      Json?
  // Auditoría de cierre manual (CP-refund-gateway-dispatch-fix · ADR-3).
  // Nullable: solo poblado cuando un operador cierra un refund vía
  // `PATCH /store/orders/:orderId/flow/refunds/:refundId/resolve`. No aplica
  // a refunds cerrados por el flujo automático del gateway.
  resolved_by_user_id   Int?
  resolution_notes      String?            @db.Text
  refund_items          refund_items[]
  orders                orders             @relation(fields: [order_id], references: [id], onUpdate: NoAction)
  payments              payments?          @relation(fields: [payment_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  users                 users?             @relation(fields: [processed_by_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  resolvedByUser        users?             @relation("refunds_resolved_by", fields: [resolved_by_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([order_id])
}

model reviews {
