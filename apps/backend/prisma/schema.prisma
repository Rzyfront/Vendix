}

model inventory_transactions {
  id                 Int                             @id @default(autoincrement())
  organization_id    Int
  product_id         Int
  product_variant_id Int?
  user_id            Int?
  order_item_id      Int?
  type               inventory_transaction_type_enum
  notes              String?
  transaction_date   DateTime?                       @default(now()) @db.Timestamp(6)
  quantity_change    Int
  /// QUI-651 — QUIÉN COCINÓ y consumió el insumo, frente a `user_id`, que es
  /// quién PIDIÓ que se cocine (el mesero o cajero del POS). Son dos
  /// responsables distintos y ambos reales; antes de esto el consumo de la
  /// estación quedaba firmado por quien disparó el fire.
  ///
  /// NULL es un caso VÁLIDO: el fire consume inventario al disparar, que puede
  /// ocurrir antes de que la estación abra sesión. Exigir sesión abierta
  /// convertiría a la cocina en bloqueante del POS — si el cocinero no fichó,
  /// el mesero no podría enviar el pedido. Se reporta como "consumo sin sesión".
  kds_session_id     Int?
  /// Costo del movimiento, persistido POR FILA. Antes de QUI-651 el costo solo
  /// existía en memoria: `StockLevelManager.updateStock` lo devuelve en
  /// `cost_snapshot` y nunca lo guardaba en la fila del movimiento.
  /// `inventory_valuation_snapshots` sí persiste costo, pero su `total_value` es
  /// el valor del stock ON-HAND después del movimiento, no el costo de lo
  /// consumido — usarlo para el historial de la sesión daría otro número.
  /// Sin estas dos columnas el historial y el resumen de consumo por turno no
  /// se pueden construir, y recomputar en lectura no sirve porque las capas
  /// FIFO ya se movieron. NULL en los movimientos históricos.
  unit_cost          Decimal?                        @db.Decimal(12, 4)
  total_cost         Decimal?                        @db.Decimal(18, 4)
  created_at         DateTime?                       @default(now()) @db.Timestamp(6)
  order_items        order_items?                    @relation(fields: [order_item_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  organizations      organizations                   @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  products           products                        @relation(fields: [product_id], references: [id], onUpdate: NoAction)
  product_variants   product_variants?               @relation(fields: [product_variant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  users              users?                          @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  kds_session        kds_sessions?                   @relation(fields: [kds_session_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([organization_id, created_at(sort: Desc)])
  @@index([kds_session_id])
}

