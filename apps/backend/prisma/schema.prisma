model sales_order_items {
  id                               Int               @id @default(autoincrement())
  sales_order_id                   Int
  product_id                       Int
  product_variant_id               Int?
  quantity                         Int
  unit_price                       Decimal?          @db.Decimal(12, 2)
  discount                         Decimal?          @db.Decimal(12, 2)
  total_price                      Decimal?          @db.Decimal(12, 2)
  cost_price                       Decimal?          @db.Decimal(12, 2)
  // Multi-tarifa snapshot (Phase 1.5: price tiers, sales-orders path).
  // applied_price_tier_id keeps a soft FK with ON DELETE SET NULL so
  // historical line items survive tier deletion; the name snapshot
  // (applied_price_tier_name_snapshot) preserves the human label.
  // stock_units_consumed records the real stock decrement when the applied
  // tier resolves a packSize > 1 (price_tiers.units_per_package or the
  // per-product override product_price_tier_overrides.override_units_per_package).
  applied_price_tier_id            Int?
  applied_price_tier_name_snapshot String?           @db.VarChar(255)
  variant_image_url                String?           @db.VarChar(500)
  stock_units_consumed             Int?
  /// Snapshot de `products.price_unit_quantity` al momento de la venta: a
  /// cuántas unidades de stock corresponde `unit_price`. El total de la línea es
  /// `unit_price * quantity / price_unit_quantity`. `null` o `1` = precio por
  /// unidad, el comportamiento histórico.
  price_unit_quantity              Int?
  created_at                       DateTime?         @default(now()) @db.Timestamp(6)
  products                         products          @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_variants                 product_variants? @relation(fields: [product_variant_id], references: [id], onDelete: Cascade)
  sales_orders                     sales_orders      @relation(fields: [sales_order_id], references: [id], onDelete: Cascade)
  applied_price_tier               price_tiers?      @relation("sales_order_items_applied_price_tier", fields: [applied_price_tier_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([sales_order_id])
  @@index([product_id, sales_order_id])
}

