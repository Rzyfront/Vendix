model invoices {
  id                               Int                             @id @default(autoincrement())
  organization_id                  Int
  store_id                         Int
  accounting_entity_id             Int
  fiscal_document_type             fiscal_document_type_enum?
  invoice_number                   String                          @db.VarChar(50)
  invoice_type                     invoice_type_enum
  status                           invoice_status_enum             @default(draft)
  transmission_status              fiscal_transmission_status_enum @default(draft)
  dian_status                      dian_document_status_enum       @default(not_applicable)
  accounting_status                fiscal_accounting_status_enum   @default(blocked)
  /// `cbc:CustomizationID` — tipo de operación DIAN: '10' estándar, '09' AIU,
  /// '11' mandatos, '12' transporte (Anexo Técnico 1.9).
  ///
  /// NULL equivale a '10'. No lleva DEFAULT a propósito: un DEFAULT dejaría dos
  /// representaciones del mismo valor conviviendo —las facturas históricas en
  /// NULL y las nuevas en '10'— y el lector tendría que manejar ambas igual.
  /// Con NULL ⇒ '10' hay una sola regla y cero filas tocadas por la migración.
  operation_type                   String?                         @db.VarChar(2)
  /// Concepto de corrección de una NOTA CRÉDITO o DÉBITO —
  /// `cac:DiscrepancyResponse/cbc:ResponseCode`. Sólo aplica a
  /// `invoice_type` `credit_note` / `debit_note`.
  ///
  /// Catálogo (Anexo Técnico 1.9, tablas 13.2.4 y 13.2.5):
  ///   · nota crédito: '1' devolución parcial · '2' anulación · '3' rebaja o
  ///     descuento · '4' ajuste de precio · '5' otros
  ///   · nota débito:  '1' intereses · '2' gastos por cobrar · '3' cambio del
  ///     valor · '4' otro
  /// Un dígito, sin cero a la izquierda (regla CAD02a). El catálogo tipado vive
  /// en `providers/dian-direct/constants/dian-note-concepts.ts`.
  ///
  /// Antes de esta columna el concepto NO era transmisible: los builders
  /// emitían el literal '2', así que una nota por descuento le declaraba a la
  /// DIAN una anulación. El concepto elegido sólo sobrevivía como prosa dentro
  /// de `notes` → `cbc:Description`, que ningún validador lee.
  ///
  /// NULL ⇒ se emite '2', el literal histórico. Sin DEFAULT por la misma razón
  /// que `operation_type`: dos representaciones del mismo valor conviviendo
  /// obligan al lector a manejar ambas.
  note_concept_code                String?                         @db.VarChar(2)
  /// Objeto del contrato AIU de ESTE documento (regla CAV03, Anexo Técnico 1.9).
  ///
  /// La `cbc:Note` de la línea de Administración debe empezar por el literal
  /// «Contrato de servicios AIU por concepto de:» seguido del objeto del
  /// contrato, y medir entre 20 y 5.000 caracteres.
  ///
  /// Vivía SÓLO en `store_settings.invoicing.aiu.contract_object`, de donde la
  /// recomponían por separado la creación y la emisión. Eso obligaba a una
  /// empresa de servicios a declarar el MISMO objeto en todos sus contratos
  /// —tiene varios, es su negocio—, y dejaba la nota expuesta a que la
  /// configuración cambiara entre que se captura la factura y se transmite: el
  /// documento salía describiendo un contrato distinto del que se facturó.
  ///
  /// NULL ⇒ se usa el de la tienda, que sigue siendo el valor por defecto y no
  /// hay que repetirlo en cada factura. La columna es un SNAPSHOT: una vez
  /// emitido, el documento conserva el objeto con el que se validó.
  ///
  /// 4900 y no 5000: el prefijo obligatorio ya ocupa parte de la cota de CAV03.
  /// Misma longitud que `contract_object` en `settings-schemas.dto.ts`.
  aiu_contract_object              String?                         @db.VarChar(4900)
  /// Régimen de base gravable AIU con el que se calculó ESTE documento, y el
  /// piso legal y la matriz de gravabilidad que aplicaron. Tres columnas, un
  /// solo propósito: hacer del régimen un SNAPSHOT, por la misma razón que
  /// `aiu_contract_object` lo es.
  ///
  /// El régimen decide qué parte del contrato es base gravable, y los dos son
  /// incompatibles: E.T. art. 462-1 grava A+I+U completo con piso del 10 % del
  /// valor del contrato; Decreto 1372/1992 art. 3 grava sólo la Utilidad.
  /// Vivía SÓLO en `store_settings.invoicing.aiu.regime`, y `invoice-flow`
  /// volvía a leerlo VIVO en la emisión (`resolveAiuEmissionContext`). Cambiar
  /// ese ajuste entre que se captura la factura y se transmite hacía que una
  /// línea calculada sin impuesto se emitiera con el `Percent` heredado de la
  /// cabecera por la ruta histórica del constructor UBL — un XML que declara
  /// 19 % sobre una base sin impuesto, que es justo lo que prohíben FAX01 y
  /// FAU04 del Anexo Técnico 1.9.
  ///
  /// NULL ⇒ se cae al ajuste vivo de la tienda, con traza explícita. Es el caso
  /// de las facturas anteriores a esta columna: rellenarlas sería inventar la
  /// configuración con la que se emitieron.
  ///
  /// `aiu_taxable_matrix` guarda la gravabilidad EFECTIVA por componente y la
  /// tarifa que la sostiene, que es el dato que el calculador no tenía y por el
  /// cual no podía imponer el impuesto de una línea gravable sin declarar.
  aiu_regime                       String?                         @db.VarChar(30)
  aiu_minimum_percent              Decimal?                        @db.Decimal(5, 2)
  aiu_taxable_matrix               Json?
  /// Versión del perfil de facturación con la que se calculó este documento.
  ///
  /// Las dos columnas apuntan JUNTAS a `invoice_profile_versions` por su único
  /// `(profile_id, version)`, no al perfil: lo que una factura debe poder
  /// reproducir es la CONFIGURACIÓN con la que se calculó, y el perfil es
  /// mutable. Referenciar la cabeza haría que editar un perfil cambiara
  /// retroactivamente lo que una factura timbrada afirma.
  ///
  /// La FK compuesta hace cumplir en la BASE el invariante DB-03 —si hay perfil,
  /// la versión referenciada existe—. Falta lo que la FK NO puede: en Postgres
  /// una FK multi-columna con `MATCH SIMPLE` (el default) no se verifica si
  /// CUALQUIERA de las columnas es NULL, así que `(profile_id = 5,
  /// profile_version = NULL)` pasaría. El «ambas o ninguna» lo impone un CHECK
  /// en la migración, que Prisma no puede declarar.
  profile_id                       Int?
  profile_version                  Int?
  customer_id                      Int?
  supplier_id                      Int?
  customer_name                    String?                         @db.VarChar(255)
  customer_tax_id                  String?                         @db.VarChar(50)
  customer_address                 Json?
  /// Correo del adquiriente al momento de facturar. Es SNAPSHOT, igual que
  /// `customer_address`: la DIAN exige `cac:Contact/cbc:ElectronicMail` y el
  /// acuse de recibo se manda a esta dirección, así que el correo que valió es
  /// el de la emisión, no el que el cliente tenga hoy en su ficha.
  customer_email                   String?                         @db.VarChar(255)
  /// Teléfono del adquiriente al momento de facturar (`cac:Contact/cbc:Telephone`).
  /// Snapshot por la misma razón que `customer_email`.
  customer_phone                   String?                         @db.VarChar(50)
  /// Código DIAN del tipo de identificación del adquiriente: '11','12','13',
  /// '21','22','31','41','42','47','48','50','91' (Anexo Técnico 1.9, tabla de
  /// tipos de documento).
  ///
  /// CRÍTICO — no es un campo decorativo: decide si al calcular el CUFE se le
  /// recorta el dígito de verificación al número. SOLO el NIT ('31') lleva DV.
  /// A una cédula como 1118860776 recortarle el último dígito la convierte en la
  /// cédula de otra persona, la huella no cuadra y la DIAN rechaza el documento
  /// habiendo gastado ya el consecutivo. La lógica vive en `dianPartyId()`
  /// (`common/utils/nit.util.ts`) y necesita este dato persistido para que un
  /// reenvío años después recalcule el MISMO CUFE.
  ///
  /// VarChar(5) y no (2) porque el provider todavía acepta el alias interno
  /// ('CC', 'NIT', 'NUIP') además del código numérico.
  customer_document_type           String?                         @db.VarChar(5)
  /// Dígito de verificación del NIT del adquiriente. Se emite como `<NIT>-<DV>`
  /// en el XML pero NUNCA dentro del número que entra al hash del CUFE.
  customer_verification_digit      String?                         @db.VarChar(1)
  /// CÓDIGO DIAN de régimen fiscal del adquiriente (`cbc:TaxLevelCode`):
  /// '48' responsable de IVA, '49' no responsable.
  ///
  /// Es el CÓDIGO, no la etiqueta de `users.tax_regime`. 'GRAN_CONTRIBUYENTE' no
  /// cabe en 10 caracteres, y eso es deliberado: el XML necesita el código, así
  /// que un intento de guardar la etiqueta debe fallar ruidosamente en vez de
  /// persistir un valor que el builder no sabe emitir.
  customer_tax_regime              String?                         @db.VarChar(10)
  /// Responsabilidades fiscales DIAN del adquiriente (O-13, O-15, O-23, O-47…),
  /// como lista. Ausente ⇒ el builder cae a 'R-99-PN'. Json y no String[] para
  /// alinearse con `customer_address`, el otro snapshot del adquiriente en esta
  /// misma tabla; la fuente viva `users.fiscal_responsibilities` sí es String[].
  customer_fiscal_responsibilities Json?
  order_id                         Int?
  sales_order_id                   Int?
  related_invoice_id               Int?
  subtotal_amount                  Decimal                         @default(0) @db.Decimal(12, 2)
  discount_amount                  Decimal                         @default(0) @db.Decimal(12, 2)
  tax_amount                       Decimal                         @default(0) @db.Decimal(12, 2)
  // Plan Despacho Economía — FASE 4 paso 13. Ingreso de flete separado en
  // cuenta 414505 "Transporte Terrestre". Persistido desde order.shipping_cost
  // en invoicing.service.ts:590. Excluido de IVA (tax_amount sólo cubre
  // producto). shipping_amount = 0 ⇒ comportamiento legacy (sin línea extra).
  shipping_amount                  Decimal                         @default(0) @db.Decimal(12, 2)
  withholding_amount               Decimal                         @default(0) @db.Decimal(12, 2)
  total_amount                     Decimal                         @default(0) @db.Decimal(12, 2)
  currency                         String?                         @db.VarChar(10)
  exchange_rate                    Decimal?                        @db.Decimal(12, 6)
  /// Divisa ISO 4217 en que se PACTÓ la operación (USD, EUR…).
  ///
  /// LEER ANTES DE ASUMIR LO CONTRARIO: esta columna NO cambia la moneda del
  /// documento. La factura electrónica se emite SIEMPRE en pesos colombianos —
  /// `DocumentCurrencyCode` = COP, Res. DIAN 000042/2020 art. 73—. Lo único que
  /// hacen `foreign_currency`, `foreign_total_amount` y `exchange_rate_date` es
  /// DECLARAR la conversión en el bloque `cac:PaymentExchangeRate`. El importe
  /// legal sigue siendo `total_amount` en COP.
  foreign_currency                 String?                         @db.VarChar(3)
  /// Total equivalente expresado en `foreign_currency`. Informativo/declarativo:
  /// no sustituye a `total_amount` (ver la nota de `foreign_currency`).
  /// Decimal(14,2) — más holgura que los 12,2 vecinos porque una divisa débil
  /// multiplica la cantidad de dígitos del mismo importe.
  foreign_total_amount             Decimal?                        @db.Decimal(14, 2)
  /// Fecha en que se fijó la tasa de cambio (`cac:PaymentExchangeRate/cbc:Date`).
  /// Es fecha-sólo, no instante: la TRM es del día, no de una hora.
  exchange_rate_date               DateTime?                       @db.Date
  /// `cbc:PaymentMeansCode` grupo forma de pago: '1' contado, '2' crédito.
  /// Mismo dominio y mismo ancho que `orders.payment_form`, del que se propaga.
  payment_form                     String?                         @db.VarChar(2)
  /// Medio de pago DIAN (`cac:PaymentMeans/cbc:PaymentMeansCode`): '10' efectivo,
  /// '42' consignación, '48' tarjeta crédito, '49' tarjeta débito…
  /// Hoy el builder emite '10' fijo; persistirlo permite declarar el real.
  payment_means_code               String?                         @db.VarChar(3)
  resolution_id                    Int?
  cufe                             String?                         @db.VarChar(255)
  qr_code                          String?
  xml_document                     String?
  pdf_url                          String?
  send_status                      document_send_status_enum       @default(not_applicable)
  /// '03' = contingencia del facturador, '04' = indisponibilidad DIAN.
  contingency_type                 String?                         @db.VarChar(2)
  contingency_declared_at          DateTime?                       @db.Timestamp(6)
  /// Vencimiento del plazo de 48 h para transmitir el documento a la DIAN.
  contingency_deadline             DateTime?                       @db.Timestamp(6)
  contingency_reason               String?
  provider_response                Json?
  sent_at                          DateTime?                       @db.Timestamp(6)
  accepted_at                      DateTime?                       @db.Timestamp(6)
  email_sent_at                    DateTime?                       @db.Timestamp(6)
  issue_date                       DateTime                        @db.Timestamp(6)
  due_date                         DateTime?                       @db.Timestamp(6)
  payment_date                     DateTime?                       @db.Timestamp(6)
  accounting_entry_id              Int?
  created_by_user_id               Int?
  notes                            String?
  created_at                       DateTime?                       @default(now()) @db.Timestamp(6)
  updated_at                       DateTime?                       @default(now()) @db.Timestamp(6)

  organization             organizations              @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  store                    stores                     @relation(fields: [store_id], references: [id], onDelete: Cascade)
  accounting_entity        accounting_entities        @relation(fields: [accounting_entity_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  customer                 users?                     @relation("invoices_customer", fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  supplier                 suppliers?                 @relation(fields: [supplier_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  order                    orders?                    @relation(fields: [order_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sales_order              sales_orders?              @relation(fields: [sales_order_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  related_invoice          invoices?                  @relation("invoice_credit_debit_notes", fields: [related_invoice_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  credit_debit_notes       invoices[]                 @relation("invoice_credit_debit_notes")
  resolution               invoice_resolutions?       @relation(fields: [resolution_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  /// `map` explícito: sin él Prisma esperaría el nombre
  /// `invoices_profile_id_profile_version_fkey` y cada `migrate diff` reportaría
  /// drift contra la constraint que la migración ya creó. Mismo patrón que el
  /// `map` de `idx_invoice_resolutions_technical_key_fingerprint`.
  profile_snapshot         invoice_profile_versions?  @relation(fields: [profile_id, profile_version], references: [profile_id, version], onDelete: Restrict, onUpdate: NoAction, map: "invoices_profile_snapshot_fkey")
  accounting_entry         accounting_entries?        @relation(fields: [accounting_entry_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  created_by_user          users?                     @relation("invoices_created_by", fields: [created_by_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  invoice_items            invoice_items[]
  invoice_taxes            invoice_taxes[]
  withholding_calculations withholding_calculations[]
  invoice_retry_queue      invoice_retry_queue[]
  dian_document_events     dian_document_events[]
  invoice_delivery_events  invoice_delivery_events[]
  dispatch_notes           dispatch_notes[]

  @@unique([accounting_entity_id, invoice_type, invoice_number])
  @@index([profile_id, profile_version])
  @@index([store_id, status])
  @@index([accounting_entity_id])
  @@index([organization_id, accounting_entity_id])
  @@index([accounting_entity_id, fiscal_document_type])
  @@index([organization_id, issue_date])
  @@index([customer_id])
}

model invoice_items {
  id                      Int                 @id @default(autoincrement())
  invoice_id              Int
  product_id              Int?
  product_variant_id      Int?
  description             String              @db.VarChar(500)
  quantity                Decimal             @db.Decimal(12, 4)
  unit_price              Decimal             @db.Decimal(12, 2)
  discount_amount         Decimal             @default(0) @db.Decimal(12, 2)
  tax_amount              Decimal             @default(0) @db.Decimal(12, 2)
  // Snapshot of whether the line's taxes are INCLUDED in `unit_price` or
  // ADDITIONAL on top. Drives `calculateAmounts()` desglose: if true,
  // base gravable = total / (1 + rate); if false, base gravable =
  // unit_price * qty - discount. Defaults to ADDITIONAL for backward
  // compatibility with historical invoices.
  is_inclusive            Boolean?            @default(false)
  total_amount            Decimal             @db.Decimal(12, 2)
  // Snapshot of the price tier applied on the source order line (human label),
  // and the real stock units consumed when packaging ("empaque por tarifa")
  // expands the sold quantity. Propagated from order_items at invoice build.
  applied_price_tier_name String?             @db.VarChar(255)
  stock_units_consumed    Int?
  /// Snapshot de `products.price_unit_quantity` al momento de la venta: a
  /// cuántas unidades de stock corresponde `unit_price`. El total de la línea es
  /// `unit_price * quantity / price_unit_quantity`. `null` o `1` = precio por
  /// unidad, el comportamiento histórico.
  price_unit_quantity     Int?
  // QUI-431 serial tracking — immutable CSV snapshot of serial numbers,
  // propagated from the source order_item at invoice build. Legal documents
  // render this snapshot instead of reading the live serial pool.
  serial_numbers_snapshot String?
  /// Código UN/ECE rec. 20 de la unidad realmente vendida ('EA', 'MTR', 'KGM',
  /// 'LTR'). Va al XML como `@unitCode` de `cbc:InvoicedQuantity`.
  ///
  /// Hoy no se persiste: se resuelve en CADA envío y, cuando la resolución
  /// falla, cae a 'EA' EN SILENCIO. La DIAN valida la coherencia entre cantidad
  /// y unidad, así que 3 metros declarados como 'EA' dicen "3 unidades" y el
  /// documento queda mintiendo. Snapshot ⇒ un reenvío años después emite la
  /// misma unidad que se emitió la primera vez. NULL = 'EA' (histórico).
  unit_code               String?             @db.VarChar(10)
  /// SNAPSHOT de la cuenta PUC de ingreso de esta línea al momento de facturar.
  ///
  /// Que el producto se remapee a otra cuenta mañana NO debe reescribir un
  /// asiento ya contabilizado: el asiento tiene que poder reconstruirse desde el
  /// documento, no desde el catálogo vivo. Mismo patrón y mismo ancho que
  /// `withholding_concepts.account_code`. NULL ⇒ resolver por el mapping vigente
  /// (comportamiento histórico).
  account_code            String?             @db.VarChar(20)
  /// Componente AIU al que pertenece la línea: Administración, Imprevistos o
  /// Utilidad. Marca qué parte del contrato entra a la base gravable del IVA
  /// (`CustomizationID` = '09', ver `invoices.operation_type`).
  ///
  /// CUIDADO — son DOS regímenes distintos y no comparten base gravable:
  ///   · E.T. art. 462-1 (aseo, vigilancia, servicios temporales de empleo):
  ///     la base es el AIU COMPLETO (A+I+U), y no puede ser inferior al 10% del
  ///     valor del contrato.
  ///   · Decreto 1372/1992 art. 3 (contratos de construcción): la base es
  ///     ÚNICAMENTE la Utilidad del constructor.
  /// Cuál aplica depende del contrato, no del producto, así que el régimen es
  /// configuración de la tienda y no se puede deducir de esta columna sola.
  ///
  /// NULL = línea normal, no AIU — que es el 100% del histórico.
  aiu_component           aiu_component_enum?
  created_at              DateTime?           @default(now()) @db.Timestamp(6)

  invoice         invoices          @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  product         products?         @relation(fields: [product_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  product_variant product_variants? @relation(fields: [product_variant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  /// Tributos que declaran gravar ESTA línea. Ver `invoice_taxes.invoice_item_id`:
  /// la relación es opcional del otro lado, así que una línea sin filas acá no
  /// es una línea sin impuestos — es un documento cuyo desglose no se persistió
  /// (todo el histórico, y los documentos con un solo tributo).
  invoice_taxes   invoice_taxes[]

  @@index([invoice_id])
}

model invoice_taxes {
  id              Int            @id @default(autoincrement())
  invoice_id      Int
  /// Línea del documento que este tributo grava. NULL = fila de CABECERA, que
  /// es el 100 % del histórico y sigue siendo la forma canónica de un documento
  /// con un solo tributo.
  ///
  /// POR QUÉ EXISTE — el emisor UBL escribe un `cac:TaxSubtotal` por cada
  /// tributo DE LA LÍNEA. Sin este vínculo cae al camino histórico de heredarle
  /// a toda línea el PRIMER tributo del documento, y en una cuenta mixta
  /// IVA + INC eso hace que todas las líneas declaren el esquema de la primera:
  /// una cuenta de restaurante sale entera como IVA 19 % o entera como INC 8 %,
  /// y la DIAN recompone los impuestos desde lo que recibe.
  ///
  /// DOS FORMAS, NUNCA MEZCLADAS EN EL MISMO DOCUMENTO (ver
  /// `InvoicingService.needsPersistedLineTaxes`):
  ///   · 1 solo tributo  ⇒ UNA fila agregada de cabecera, `invoice_item_id` NULL.
  ///     El camino histórico ya emite EXACTAMENTE el mismo XML, así que partirla
  ///     por línea no cambiaría un byte y sí multiplicaría las filas que leen el
  ///     PDF, el detalle del panel y los reportes fiscales.
  ///   · ≥2 tributos     ⇒ UNA fila por (línea × tributo), todas con
  ///     `invoice_item_id`. NO conviven con filas agregadas: cada consumidor de
  ///     esta tabla SUMA sus filas (`cac:TaxTotal` de cabecera, declaraciones,
  ///     exógena, ICA), y agregado + desglose juntos duplicarían el impuesto del
  ///     documento y lo harían rechazar por FAS01b.
  ///
  /// `ON DELETE SET NULL`: borrar una línea no puede arrastrar la fila de
  /// tributo —es dato fiscal— pero tampoco puede dejarla apuntando a un id
  /// muerto. Degradar a NULL la devuelve al camino histórico, que sigue siendo
  /// correcto. Es además lo que permite que `InvoicingService.update()` borre
  /// las líneas antes que los tributos sin chocar contra la FK.
  invoice_item_id Int?
  tax_rate_id     Int?
  tax_name        String         @db.VarChar(100)
  tax_rate        Decimal        @db.Decimal(5, 2)
  taxable_amount  Decimal        @db.Decimal(12, 2)
  tax_amount      Decimal        @db.Decimal(12, 2)
  tax_type        tax_type_enum?
  // Per-line flag: INCLUDED in `unit_price` or ADDITIONAL on top. Drives
  // UBL DIAN builder (`ubl-common.builder.ts`) to emit the corresponding
  // `TaxInclusiveIndicator` XML attribute. Defaults to ADDITIONAL.
  is_inclusive    Boolean?       @default(false)

  invoice      invoices       @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  invoice_item invoice_items? @relation(fields: [invoice_item_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  tax_rates    tax_rates?     @relation(fields: [tax_rate_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([invoice_id])
  @@index([invoice_item_id])
}

/// Uniqueness lives in DB partial unique indexes that Prisma cannot express as
/// @@unique (migration 20260511190000_close_fiscal_scope_gaps_phase2):
///   - invoice_resolutions_entity_prefix_uidx
///     (accounting_entity_id, prefix) WHERE accounting_entity_id IS NOT NULL
///   - invoice_resolutions_store_prefix_no_entity_uidx
///     (organization_id, store_id, prefix) WHERE accounting_entity_id IS NULL
///                                           AND store_id IS NOT NULL
///   - invoice_resolutions_org_prefix_no_store_no_entity_uidx
///     (organization_id, prefix) WHERE accounting_entity_id IS NULL
///                                AND store_id IS NULL
/// Since 20260522150000_enforce_fiscal_accounting_entity_not_null made
/// accounting_entity_id NOT NULL, only the FIRST index is ever in effect: one
/// prefix per accounting entity, full stop. It deliberately excludes
/// document_type and is_active, matching how DIAN authorizes a prefix — per NIT,
/// not per document type.
///
/// CONSEQUENCE FOR CALLERS: a pre-create duplicate check must key on exactly
/// (accounting_entity_id, prefix). Adding document_type or is_active:true makes
/// the check MORE PERMISSIVE than the DB, and the duplicate then surfaces as a
/// raw P2002 — an opaque 500 instead of a 409 naming the offending row.
model invoice_resolutions {
  id                        Int                       @id @default(autoincrement())
  organization_id           Int
  store_id                  Int?
  accounting_entity_id      Int
  document_type             fiscal_document_type_enum @default(sales_invoice)
  resolution_number         String                    @db.VarChar(100)
  resolution_date           DateTime                  @db.Timestamp(6)
  prefix                    String                    @db.VarChar(10)
  range_from                Int
  range_to                  Int
  current_number            Int                       @default(0)
  valid_from                DateTime                  @db.Timestamp(6)
  valid_to                  DateTime                  @db.Timestamp(6)
  is_active                 Boolean                   @default(true)
  technical_key             String?                   @db.VarChar(255)
  /// Clave técnica DIAN cifrada (AES-256-GCM, `TechnicalKeyVaultService`).
  ///
  /// Es la fuente de verdad PREFERIDA: `reveal()` la descifra y sólo cae a
  /// `technical_key` cuando está vacía o no abre. No hubo backfill por SQL —ni
  /// puede haberlo: la llave maestra no está disponible para el runner de
  /// migraciones—, así que las filas viejas se cifran solas la primera vez que
  /// alguien las lee, una a una y sin mutación masiva. Mismo patrón ya probado
  /// en `DianSecretEnvelopeService` para el Software-PIN.
  technical_key_encrypted   String?                   @db.Text
  /// SHA-256 de la ClTec normalizada. Sin llave, a propósito.
  ///
  /// Existe porque el cifrado usa salt e IV frescos por registro: dos filas con
  /// la misma ClTec dan ciphertexts distintos, y eso rompe la única consulta que
  /// compara claves ENTRE filas — el detector de ClTec compartida entre NIT
  /// (`findResolutionsSharingTechnicalKey`), que corre sin scope sobre toda la
  /// plataforma. Contra la columna cifrada esa igualdad nunca coincide y su
  /// vacío se lee como «no hay contaminación».
  technical_key_fingerprint String?                   @db.VarChar(64)
  created_at                DateTime?                 @default(now()) @db.Timestamp(6)
  updated_at                DateTime?                 @default(now()) @db.Timestamp(6)

  organization      organizations       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  store             stores?             @relation(fields: [store_id], references: [id], onDelete: Cascade)
  accounting_entity accounting_entities @relation(fields: [accounting_entity_id], references: [id], onDelete: Restrict)
  invoices          invoices[]

  @@index([store_id, is_active])
  @@index([accounting_entity_id, document_type, is_active])
  @@index([organization_id, accounting_entity_id])
  @@index([organization_id, accounting_entity_id, document_type])
  // `map` explícito para que el nombre coincida con el de la migración; sin él
  // Prisma lo llamaría `invoice_resolutions_technical_key_fingerprint_idx` y
  // cada `migrate dev` posterior detectaría drift contra un índice que ya existe.
  @@index([technical_key_fingerprint], map: "idx_invoice_resolutions_technical_key_fingerprint")
}

/// Perfil de facturación: la cabeza MUTABLE de una configuración fiscal.
///
/// Existe porque el motor de cálculo sabe QUÉ componentes de un contrato AIU
/// entran a la base gravable —lo decide el régimen— pero NO a qué tarifa: la
/// tarifa depende del bien o servicio y el servicio no tiene catálogo. Sin un
/// sitio donde declararla, la única salida correcta ante una línea gravable sin
/// impuesto es rechazar (`INVOICING_AIU_004`). La matriz de impuestos del perfil
/// es la que aporta esa tarifa que falta.
///
/// La configuración NO vive acá: vive en `invoice_profile_versions`, inmutable.
/// Esta fila guarda sólo lo que puede cambiar sin alterar lo que una factura ya
/// emitida reproduce — el nombre, el estado, cuál es el predeterminado.
model invoice_profiles {
  id              Int @id @default(autoincrement())
  organization_id Int
  /// Nullable desde la migración 20260826120000, replicando el patrón vivo de
  /// `dian_configurations` (migración 20260511160000) y de
  /// `invoice_resolutions.store_id`. Permite perfiles de ámbito organización
  /// (raíl plataforma VENDIX_ADMIN con su propio NIT) anclados únicamente a
  /// `organization_id`, sin fragmentar el invariante del módulo.
  ///
  /// El invariante «exactamente un predeterminado por ámbito y operation_type»
  /// lo sostiene la BASE con DOS índices únicos parciales:
  ///   · `invoice_profiles_store_scope_default_uq` ON (store_id, operation_type)
  ///     WHERE is_default AND store_id IS NOT NULL  (ámbito tienda)
  ///   · `invoice_profiles_org_scope_default_uq` ON (organization_id, operation_type)
  ///     WHERE is_default AND store_id IS NULL       (ámbito organización)
  /// Postgres trata NULLs como distintos, así que UN solo parcial no cubre
  /// ambos casos: el ORG-scope es el segundo parcial. Prisma no puede
  /// representar parciales: viven únicamente en la migración de SQL.
  /// `store_id` no se queda NULL por capricho — su nulabilidad es gobernada por
  /// `organizations.fiscal_scope` (STORE ⇒ tienda; ORGANIZATION ⇒ plataforma).
  store_id        Int?

  name String @db.VarChar(150)
  /// Código DIAN de tipo de operación (`09` = AIU, `10` = estándar).
  ///
  /// `VarChar` y no enum de Prisma a propósito: agregar un código DIAN nuevo a
  /// un enum exige `ALTER TYPE ... ADD VALUE`, que no puede ir en la misma
  /// transacción que otras sentencias y convierte cada código nuevo en una
  /// migración frágil. La validación vive en el DTO contra
  /// `DIAN_INVOICE_OPERATION_TYPES`, que es la fuente única.
  operation_type String @db.VarChar(2)
  /// `active` | `inactive`. VarChar y no `Boolean is_active`.
  ///
  /// El ciclo de vida ya tiene tres posiciones con significado distinto: activo,
  /// desactivado, y «no eliminable porque tiene facturas timbradas»
  /// (`INVOICING_PROFILE_003`, que ofrece desactivar como alternativa al
  /// borrado). Un `Boolean` no admite una cuarta sin cambio de tipo, y un enum
  /// de Prisma la exigiría por `ALTER TYPE`. La validación vive en el DTO.
  state          String @db.VarChar(20) @default("active")

  /// Predeterminado para su `operation_type` en su ámbito (STORE u ORG). El
  /// invariante «un predeterminado por ámbito y operation_type» lo sostienen
  /// DOS índices únicos parciales en la base (Prisma no puede representar
  /// parciales): `invoice_profiles_store_scope_default_uq` y
  /// `invoice_profiles_org_scope_default_uq`, creados en la migración
  /// 20260826120000_invoice_profiles_relax_store_id_for_org_scope. No los
  /// borres de ahí creyendo que el esquema los cubre.
  ///
  /// El índice de unicidad de nombre por ámbito es simétrico:
  /// `invoice_profiles_unique_name_per_store` (tienda) y
  /// `invoice_profiles_unique_name_per_org` (organización, store_id IS NULL),
  /// este último en la migración 20260826121000.
  is_default Boolean @default(false)

  /// Número de la última versión COMPROMETIDA. Arranca en 0, no en 1.
  ///
  /// La fila del perfil y su versión 1 se escriben en la misma transacción. Un
  /// default de 1 afirmaría una versión que una transacción interrumpida nunca
  /// escribió; el 0 significa «sin versión comprometida» y es detectable como
  /// corrupción con una consulta.
  current_version Int @default(0)

  /// Clonar produce un perfil INDEPENDIENTE (ADR-1): estas dos columnas son
  /// procedencia para el historial, no una dependencia viva. Por eso
  /// `onDelete: SetNull` — borrar el perfil de origen no puede tocar al clon.
  cloned_from_profile_id Int?
  cloned_from_version    Int?

  created_by Int?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  /// `Restrict`, no `Cascade` — a diferencia de `invoices` e `invoice_resolutions`.
  ///
  /// Declarar `Cascade` acá sería mentira: `invoice_profile_versions` es
  /// `Restrict` hacia el perfil, así que borrar una tienda intentaría cascadear
  /// al perfil y el RESTRICT de las versiones lo bloquearía igual. La cadena
  /// entera es `Restrict` para que la base diga lo que de verdad hace, y para no
  /// añadir un `ON DELETE CASCADE` sobre una tabla padre con datos de negocio.
  ///
  /// `store` es opcional (nullable) desde la migración 20260826120000: cuando
  /// `store_id IS NULL` el perfil vive en el ámbito organización (raíl plataforma).
  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  store        stores?       @relation(fields: [store_id], references: [id], onDelete: Restrict)
  creator      users?        @relation("invoice_profiles_created_by", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  cloned_from  invoice_profiles?  @relation("invoice_profile_clones", fields: [cloned_from_profile_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  clones       invoice_profiles[] @relation("invoice_profile_clones")
  versions     invoice_profile_versions[]

  @@index([store_id, state, operation_type])
  @@index([organization_id])
  @@index([organization_id, state, operation_type])
  @@index([cloned_from_profile_id])
}

/// Versión INMUTABLE de la configuración de un perfil. Solo INSERT.
///
/// Es lo que una factura congela y lo que reproduce años después al reenviarse.
/// Nunca se hace `UPDATE` ni `DELETE` sobre esta tabla: editar un perfil inserta
/// una versión nueva y mueve `invoice_profiles.current_version`. Si se pudiera
/// editar, una factura timbrada dejaría de poder reproducir la configuración con
/// la que se calculó, que es exactamente el defecto que el snapshot cierra.
model invoice_profile_versions {
  id         Int @id @default(autoincrement())
  profile_id Int
  /// Contiguo desde 1. El invariante es `count(*) = max(version)` por perfil:
  /// un hueco significaría una versión perdida, y con ella la reproducibilidad
  /// de las facturas que la referencian.
  version    Int

  /// El snapshot completo de configuración. Su forma es un CONTRATO FISCAL
  /// (`InvoiceProfileConfig`, paso B.5), no una preferencia de UI: si omite algo
  /// que la emisión necesita, la emisión vuelve a leer configuración viva y
  /// reabre el defecto que el congelado cierra.
  config Json

  created_by Int?
  created_at DateTime? @default(now()) @db.Timestamp(6)

  /// `Restrict` y no `Cascade`: borrar un perfil NO puede llevarse el historial
  /// que las facturas timbradas referencian. El borrado de un perfil con
  /// facturas ya está prohibido (`INVOICING_PROFILE_003`); esta FK es la red que
  /// lo sostiene a nivel de base, no a nivel de servicio.
  profile invoice_profiles @relation(fields: [profile_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  creator users?           @relation("invoice_profile_versions_created_by", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)

  invoices invoices[]

  @@unique([profile_id, version])
  @@index([profile_id, created_at])
}

