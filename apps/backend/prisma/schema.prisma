  store              stores?              @relation(fields: [store_id], references: [id], onDelete: SetNull)
  accounting_entity  accounting_entities? @relation(fields: [accounting_entity_id], references: [id], onDelete: SetNull)
  inventory_location inventory_locations  @relation(fields: [location_id], references: [id], onDelete: Restrict)
