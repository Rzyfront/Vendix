/// Audit row that records when a single organization consumed its
/// platform-wide auto-trial. The UNIQUE constraint on `organization_id`
/// is the enforcement primitive that makes "one trial per org, ever"
/// concurrency-safe — a second concurrent INSERT raises P2002.
model organization_trial_consumptions {
  id                    Int      @id @default(autoincrement())
  organization_id       Int      @unique
  store_subscription_id Int
  consumed_at           DateTime @default(now()) @db.Timestamp(6)
  metadata              Json?

  organization       organizations       @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  store_subscription store_subscriptions @relation(fields: [store_subscription_id], references: [id], onDelete: Restrict)

  @@index([store_subscription_id])
}

/// Tracks one-time redemption of promotional plan codes per organization.
/// UNIQUE(organization_id, plan_id) prevents reusing the same promo twice.
