model inventory_serial_numbers {
  id                     Int                      @id @default(autoincrement())
  product_id             Int
  product_variant_id     Int?
  serial_number          String                   @unique @db.VarChar(255)
  status                 serial_status_enum       @default(in_stock)
  location_id            Int?
  batch_id               Int?
  cost                   Decimal?                 @db.Decimal(12, 4)
  sold_date              DateTime?                @db.Timestamp(6)
  warranty_expiry        DateTime?                @db.Timestamp(6)
  notes                  String?
  created_at             DateTime?                @default(now()) @db.Timestamp(6)
  updated_at             DateTime?                @default(now()) @db.Timestamp(6)
  inventory_batches      inventory_batches?       @relation(fields: [batch_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  inventory_locations    inventory_locations?     @relation(fields: [location_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  products               products                 @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_variants       product_variants?        @relation(fields: [product_variant_id], references: [id], onDelete: Cascade)
  sales_document_serials sales_document_serials[]
}

// QUI-431 serial tracking — polymorphic junction linking a tracked serial in
// the pool (inventory_serial_numbers) to a specific sales/dispatch document
// line. A controlled polymorphism (no DB-level FK on document_item_id) because
// a single line with quantity > 1 needs N serials, so a scalar FK on the line
// would not work. The unique (document_item_type, serial_number_id) constraint
// prevents the same serial from being committed twice to the same document type
// (anti double-sale guard under concurrency).
model sales_document_serials {
  id                 Int                           @id @default(autoincrement())
  serial_number_id   Int
  document_item_type sales_document_item_type_enum
  document_item_id   Int
  quantity           Int                           @default(1)
  created_at         DateTime?                     @default(now()) @db.Timestamp(6)

  serial inventory_serial_numbers @relation(fields: [serial_number_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([document_item_type, serial_number_id])
  @@index([document_item_type, document_item_id])
  @@index([serial_number_id])
}

model suppliers {
  id                                  Int                        @id @default(autoincrement())
  organization_id                     Int
  store_id                            Int?
  name                                String                     @db.VarChar(255)
  code                                String                     @db.VarChar(50)
  contact_person                      String?                    @db.VarChar(255)
  mobile                              String?                    @db.VarChar(50)
  email                               String?                    @db.VarChar(255)
  phone                               String?                    @db.VarChar(50)
  website                             String?                    @db.VarChar(255)
  tax_id                              String?                    @db.VarChar(50)
  tax_regime                          String?                    @db.VarChar(50)
  person_type                         String?                    @db.VarChar(20)
  is_self_withholder                  Boolean                    @default(false)
  document_type                       String?                    @db.VarChar(10)
  verification_digit                  String?                    @db.VarChar(1)
  payment_terms                       String?                    @db.VarChar(255)
  currency                            String?                    @db.VarChar(10)
  notes                               String?
  lead_time_days                      Int?
  /// DEPRECADO — reemplazado por `state`. La columna sobrevive este deploy porque
  /// contiene datos productivos; su DROP va en una migración posterior con
  /// snapshot y autorización explícita. Nada en el código la lee ni la escribe.
  is_active                           Boolean                    @default(true)
  /// Ciclo de vida del proveedor, alineado con brands/categories/products:
  /// `active` = usable en flujos nuevos; `inactive` = visible en listados pero
  /// no seleccionable; `archived` = lo que produce "Eliminar", oculto de
  /// listados y pickers pero con su historia contable intacta (las FKs
  /// entrantes siguen resolviendo porque la fila persiste).
  state                               supplier_state_enum        @default(active)
  // Plan Despacho Economía — FASE 1 paso 7. Categoría distingue al proveedor
  // de transporte (carrier) que se usa como ejecutor externo de la ruta y
  // dispara AP+retención. `goods` preserva el comportamiento actual por backfill.
  supplier_category                   supplier_category_enum     @default(goods)
  // Banco destino del pago inmediato al carrier (paso 17). Las 3 columnas
  // cierran el bug latente de `ap-bank-export.service.ts:39-41` que las
  // seleccionaba sin que existieran en la tabla.
  bank_name                           String?                    @db.VarChar(120)
  bank_account_number                 String?                    @db.VarChar(60)
  bank_account_type                   String?                    @db.VarChar(20)
  address_id                          Int?
  created_at                          DateTime?                  @default(now()) @db.Timestamp(6)
  updated_at                          DateTime?                  @default(now()) @db.Timestamp(6)
  purchase_orders                     purchase_orders[]
  supplier_products                   supplier_products[]
  dispatch_notes                      dispatch_notes[]           @relation("dispatch_notes_supplier")
  organizations                       organizations              @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  store                               stores?                    @relation(fields: [store_id], references: [id], onDelete: SetNull)
  addresses                           addresses?                 @relation("supplier_addresses", fields: [address_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  invoices                            invoices[]
  withholding_calculations            withholding_calculations[]
  accounts_payable                    accounts_payable[]         @relation("supplier_accounts_payable")
  // Plan Despacho Economía — FASE 2 paso 8. Contraparte de
  // shipping_methods.default_carrier_supplier_id → suppliers.id.
  shipping_methods_as_default_carrier shipping_methods[]         @relation("shipping_methods_default_carrier")
  // Plan Despacho Economía — FASE 3 paso 11. Contraparte de
