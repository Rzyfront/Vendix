  stock_transfer_id  Int
  product_id         Int
  product_variant_id Int?
  quantity           Int
  quantity_received  Int               @default(0)
  notes              String?
  created_at         DateTime?         @default(now()) @db.Timestamp(6)
  products           products          @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_variants   product_variants? @relation(fields: [product_variant_id], references: [id], onDelete: Cascade)
  stock_transfers    stock_transfers   @relation(fields: [stock_transfer_id], references: [id], onDelete: Cascade)

  @@index([stock_transfer_id])
  @@index([product_id, stock_transfer_id])
}

model return_orders {
  id                  Int                      @id @default(autoincrement())
  organization_id     Int
  related_order_id    Int?
  related_order_type  related_order_type_enum?
  related_dispatch_id Int?
  partner_id          Int?
  partner_type        partner_type_enum?
  type                return_order_type_enum
  status              return_order_status_enum @default(draft)
  reason_id           Int?
  created_at          DateTime?                @default(now()) @db.Timestamp(6)
  updated_at          DateTime?                @default(now()) @db.Timestamp(6)
  // Marcas de la transición. `return-orders.service.ts` ya las escribía en
  // `process()` y `cancel()`, pero las columnas no existían: Prisma rechazaba
  // el `update` completo, así que procesar o anular una devolución respondía
  // «Error interno» y la devolución se quedaba en su estado anterior.
  processed_date      DateTime?                @db.Timestamp(6)
  cancelled_date      DateTime?                @db.Timestamp(6)
  return_order_items  return_order_items[]
  organizations       organizations            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  related_dispatch    dispatch_notes?          @relation("return_orders_related_dispatch", fields: [related_dispatch_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([organization_id, type, status])
  @@index([related_dispatch_id])
}

model return_order_items {
  id                 Int                 @id @default(autoincrement())
  return_order_id    Int
  product_id         Int
  product_variant_id Int?
  quantity           Int
  condition          item_condition_enum @default(good)
  created_at         DateTime?           @default(now()) @db.Timestamp(6)
  products           products            @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_variants   product_variants?   @relation(fields: [product_variant_id], references: [id], onDelete: Cascade)
  return_orders      return_orders       @relation(fields: [return_order_id], references: [id], onDelete: Cascade)

  @@index([return_order_id, product_id])
}

// ===== SHIPPING & LOGISTICS DOMAIN =====

model shipping_zones {
  id           Int       @id @default(autoincrement())
  store_id     Int?
  name         String    @db.VarChar(100)
  display_name String?   @db.VarChar(100)
  countries    String[] // Array of ISO country codes
  regions      String[] // Array of region/state codes
  cities       String[] // Specific cities if needed
  zip_codes    String[] // Zip code patterns
  is_active    Boolean   @default(true)
  is_system    Boolean   @default(false)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)

  // Tracking de copia del sistema (One-Click Magic)
  copied_from_system_zone_id Int? // ID de zona del sistema de donde se copió
  source_type                zone_source_type_enum? // 'system_copy' | 'custom'

  // Relaciones
  store            stores?               @relation(fields: [store_id], references: [id], onDelete: Cascade)
  shipping_rates   shipping_rates[]
  copied_from_zone shipping_zones?       @relation("ZoneCopies", fields: [copied_from_system_zone_id], references: [id], onDelete: SetNull)
  copied_zones     shipping_zones[]      @relation("ZoneCopies")
  system_updates   system_zone_updates[]

  @@index([store_id])
  @@index([is_system])
  @@index([copied_from_system_zone_id])
  @@index([source_type])
}

model shipping_methods {
  id                           Int                           @id @default(autoincrement())
  store_id                     Int?
  name                         String                        @db.VarChar(100)
  code                         String?                       @db.VarChar(50)
  description                  String?
  logo_url                     String?
  type                         shipping_method_type_enum     @default(custom)
  provider_name                String?                       @db.VarChar(50) // e.g., "fedex", "uber"
  tracking_url                 String?
  min_days                     Int?
  max_days                     Int?
  transit_time_minutes         Int                           @default(0)
  is_active                    Boolean                       @default(true)
  is_system                    Boolean                       @default(false)
  display_order                Int                           @default(0)
  custom_config                Json?
  min_order_amount             Decimal?                      @db.Decimal(12, 2)
  max_order_amount             Decimal?                      @db.Decimal(12, 2)
  copied_from_system_method_id Int?
  // Plan Despacho Economía — FASE 2 paso 8. Política tipada por método
  // (recaudo, costo del transportador, ejecutor por defecto, timing).
  collects_payment             Boolean                       @default(false)
  payment_timing               dispatch_payment_timing_enum? @default(on_delivery)
  generates_transport_cost     settlement_type_enum          @default(none)
  default_vehicle_id           Int?
  default_driver_user_id       Int?
  default_carrier_supplier_id  Int?
  cost_settlement_timing       cost_settlement_timing_enum?  @default(immediate_on_close)
  created_at                   DateTime?                     @default(now()) @db.Timestamp(6)
  updated_at                   DateTime?                     @default(now()) @db.Timestamp(6)

  store                        stores?            @relation(fields: [store_id], references: [id], onDelete: Cascade)
  shipping_rates               shipping_rates[]
  orders                       orders[]
  copied_from_method           shipping_methods?  @relation("MethodCopies", fields: [copied_from_system_method_id], references: [id], onDelete: SetNull)
  copied_methods               shipping_methods[] @relation("MethodCopies")
  default_vehicle              vehicles?          @relation("shipping_methods_default_vehicle", fields: [default_vehicle_id], references: [id], onDelete: SetNull)
  default_driver_user          users?             @relation("shipping_methods_default_driver", fields: [default_driver_user_id], references: [id], onDelete: SetNull)
  default_carrier_supplier     suppliers?         @relation("shipping_methods_default_carrier", fields: [default_carrier_supplier_id], references: [id], onDelete: SetNull)
  // Plan Despacho Economía — FASE 3 paso 11. Contraparte de
  // dispatch_routes.shipping_method_id → shipping_methods.id.
  dispatch_routes_using_method dispatch_routes[]  @relation("dispatch_routes_shipping_method")

  @@index([store_id])
  @@index([is_system])
  @@index([copied_from_system_method_id])
  @@index([default_vehicle_id])
  @@index([default_carrier_supplier_id])
}

model shipping_rates {
  id                      Int                     @id @default(autoincrement())
  shipping_zone_id        Int
  shipping_method_id      Int
  name                    String?                 @db.VarChar(100)
  type                    shipping_rate_type_enum @default(flat)
  base_cost               Decimal                 @default(0.00) @db.Decimal(12, 2)
  per_unit_cost           Decimal?                @default(0.00) @db.Decimal(12, 2) // Price per kg or per item
  min_val                 Decimal?                @db.Decimal(12, 2) // Min condition (weight/price)
  max_val                 Decimal?                @db.Decimal(12, 2) // Max condition (weight/price)
  free_shipping_threshold Decimal?                @db.Decimal(12, 2)
  is_active               Boolean                 @default(true)
  created_at              DateTime?               @default(now()) @db.Timestamp(6)
  updated_at              DateTime?               @default(now()) @db.Timestamp(6)

  // Tracking de copia del sistema
  copied_from_system_rate_id Int? // ID de tarifa del sistema de donde se copió
  source_type                zone_source_type_enum? // 'system_copy' | 'custom'

  // Relaciones
  shipping_zone   shipping_zones   @relation(fields: [shipping_zone_id], references: [id], onDelete: Cascade)
  shipping_method shipping_methods @relation(fields: [shipping_method_id], references: [id], onDelete: Cascade)
  orders          orders[]

  @@index([shipping_zone_id])
  @@index([shipping_method_id])
  @@index([copied_from_system_rate_id])
}

// Tracking de cambios en zonas del sistema para notificar a tiendas
model system_zone_updates {
  id             Int      @id @default(autoincrement())
  system_zone_id Int
  change_type    String   @db.VarChar(50) // 'updated' | 'new_rate' | 'rate_updated' | 'deleted'
  description    String
  created_at     DateTime @default(now()) @db.Timestamp(6)

  // Relación con la zona del sistema
  system_zone shipping_zones @relation(fields: [system_zone_id], references: [id], onDelete: Cascade)

  @@index([system_zone_id])
  @@index([created_at])
}

// ===== ECOMMERCE MODELS =====

model carts {
  id         Int       @id @default(autoincrement())
  store_id   Int
  user_id    Int
  currency   String?   @db.VarChar(10)
  subtotal   Decimal   @default(0.00) @db.Decimal(12, 2)
  /// Operational state for the analytics abandoned-cart definition. NULL for
  /// carts created before this migration; treated as 'active' for metrics.
  state             cart_state_enum?
  /// FK to the order this cart converted into. NULL = never converted (active
  /// or abandoned). Used by analytics to distinguish recovered carts from
  /// abandoned ones without heuristics over user_id + timestamp.
  converted_order_id Int?
  converted_at      DateTime?          @db.Timestamp(6)
  /// Last time anything happened to this cart (item add/update, subtotal
  /// recompute, etc.). Drives the "older than N minutes" operational
  /// definition of "abandoned".
  last_activity_at  DateTime?          @db.Timestamp(6)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  cart_items       cart_items[]
  store            stores       @relation(fields: [store_id], references: [id], onDelete: Cascade)
  user             users        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  converted_order  orders?      @relation("cart_converted_order", fields: [converted_order_id], references: [id], onDelete: SetNull)

  @@unique([store_id, user_id])
  @@index([user_id])
  @@index([store_id, state, last_activity_at])
  @@index([store_id, converted_at])
}

model cart_items {
  id                 Int       @id @default(autoincrement())
  cart_id            Int
  product_id         Int
  product_variant_id Int?
  quantity           Int
  unit_price         Decimal   @db.Decimal(12, 2)
  created_at         DateTime? @default(now()) @db.Timestamp(6)

  /// Presentacion de venta elegida por el comprador (bulto/kilo, rollo/metro).
  /// NULL = el servidor resuelve la presentacion por defecto del producto, que
  /// es el comportamiento historico y el de cualquier cliente sin actualizar.
  applied_price_tier_id Int?
  /// Unidades de stock que consume la linea = quantity * packSize. Es CACHE,
  /// no verdad: el checkout siempre lo recalcula desde la presentacion
  /// autorizada. Vive aqui para que getCartSummary pueda alimentar el
  /// predicado `isSoldByPresentation` del motor de promociones sin una lectura
  /// extra por linea.
  stock_units_consumed  Int?

  cart            carts             @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product         products          @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_variant product_variants? @relation(fields: [product_variant_id], references: [id], onDelete: Cascade)

  applied_price_tier price_tiers? @relation("cart_items_applied_price_tier", fields: [applied_price_tier_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  /// OJO: la unicidad REAL la impone un indice `NULLS NOT DISTINCT` que Prisma
  /// no sabe expresar y que vive SOLO en la migracion
  /// `20260818140000_cart_items_sale_unit`. Bajo el default de Postgres
  /// (NULLS DISTINCT) esta declaracion no protege nada en el caso que importa:
  /// los productos con presentacion NO tienen variantes (regla tiers (+)
  /// variantes, QUI-648), asi que product_variant_id es siempre NULL ahi y dos
  /// NULL nunca colisionan. No regeneres esta tabla sin reponer el indice
  /// manual -- mismo criterio que product_price_tier_assignments.is_default.
  @@unique([cart_id, product_id, product_variant_id, applied_price_tier_id], map: "cart_items_line_identity_key")
  @@index([cart_id])
  @@index([applied_price_tier_id])
}

/// Operational state of a cart for the analytics abandoned-cart definition
/// (QUI-628): `active` = in use, `abandoned` = items but not converted and
/// last_activity_at older than the grace window, `converted` = turned into an
/// order (converted_order_id set).
enum cart_state_enum {
  active
  abandoned
  converted
}

model wishlists {
  id         Int       @id @default(autoincrement())
  store_id   Int
  user_id    Int
  created_at DateTime? @default(now()) @db.Timestamp(6)

  wishlist_items wishlist_items[]
  store          stores           @relation(fields: [store_id], references: [id], onDelete: Cascade)
  user           users            @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([store_id, user_id])
  @@index([user_id])
}

model wishlist_items {
  id                 Int       @id @default(autoincrement())
  wishlist_id        Int
  product_id         Int
  product_variant_id Int?
  added_at           DateTime? @default(now()) @db.Timestamp(6)

  wishlist        wishlists         @relation(fields: [wishlist_id], references: [id], onDelete: Cascade)
  product         products          @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_variant product_variants? @relation(fields: [product_variant_id], references: [id], onDelete: Cascade)

  @@unique([wishlist_id, product_id, product_variant_id])
  @@index([wishlist_id])
}

// ===== DEFAULT TEMPLATES =====

model default_templates {
  id                 Int                       @id @default(autoincrement())
  template_name      String                    @unique @db.VarChar(255)
  configuration_type template_config_type_enum
  template_data      Json
  description        String?                   @db.Text
  is_active          Boolean                   @default(true)
