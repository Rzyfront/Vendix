  store_id      Int
  invoice_id    Int
  attempts      Int      @default(0)
  max_attempts  Int      @default(3)
  last_error    String?  @db.Text
  next_retry_at DateTime @db.Timestamp(6)
  status        String   @default("pending") @db.VarChar(20)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @updatedAt @db.Timestamp(6)

  invoice      invoices      @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  organization organizations @relation(fields: [org_id], references: [id], onDelete: Cascade)
  store        stores        @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([status, next_retry_at])
  @@index([invoice_id])
}

model bookings {
  id                        Int                           @id @default(autoincrement())
  store_id                  Int
  /// CP-POS-SVC-PERF-001 / HU-B + HU-C — anonymous sales ("Venta
  /// Anónima" / Consumidor Final) must be able to carry a booking
  /// alongside the order. The cashier picks the staff + day + time,
  /// and the booking is tied to the order alone. Optional now; legacy
  /// rows stay required by application-level guards.
  customer_id               Int?
  product_id                Int
  product_variant_id        Int?
  booking_number            String                        @db.VarChar(50)
  date                      DateTime                      @db.Date
  start_time                String                        @db.VarChar(5)
  end_time                  String                        @db.VarChar(5)
  status                    booking_status_enum           @default(pending)
  channel                   order_channel_enum            @default(pos)
  notes                     String?                       @db.Text
  internal_notes            String?                       @db.Text
  order_id                  Int?
  table_id                  Int?
  created_by_user_id        Int?
  expires_at                DateTime?                     @db.Timestamp(6)
  provider_id               Int?
  checked_in_at             DateTime?                     @db.Timestamp(6)
  confirmation_requested_at DateTime?                     @db.Timestamp(6)
  confirmation_deadline     DateTime?                     @db.Timestamp(6)
  arrival_at                DateTime?                     @db.Timestamp(6)
  /// Resolved queue position computed by AppointmentQueueService.
  /// 0 means not in queue (most common case). Lower = sooner.
  queue_position            Int                           @default(0)
  /// Manual priority override for queue ordering. Lower = sooner. 0 = default.
  priority                  Int                           @default(0)
  /// Where the service will be performed. `home` = technician goes to the
  /// customer's address; `shop` = customer goes to the technician's shop.
  /// Historical bookings all default to `shop`.
  service_location_type     booking_service_location_enum @default(shop)
  /// FK to the customer's `addresses` row when service_location_type =
  /// `home`. NULL for `shop` bookings.
  service_address_id        Int?
  service_address           addresses?                    @relation("booking_service_address", fields: [service_address_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  /// CP-POS-SVC-PERF-001 / C.1 — optional link from booking back to the
  /// cart line that produced it. Allows the order editor to round-trip
  /// the same booking atomically. NULL when the booking was created
  /// outside the POS (ecommerce, reservations module, etc.).
  cart_item_id              String?                       @db.VarChar(80)
  created_at                DateTime?                     @default(now()) @db.Timestamp(6)
  updated_at                DateTime?                     @default(now()) @db.Timestamp(6)

  store            stores             @relation(fields: [store_id], references: [id])
  customer         users?             @relation("bookings_customer", fields: [customer_id], references: [id])
  product          products           @relation(fields: [product_id], references: [id])
  product_variants product_variants?  @relation(fields: [product_variant_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  order            orders?            @relation(fields: [order_id], references: [id])
  table            tables?            @relation(fields: [table_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  created_by       users?             @relation("bookings_created_by", fields: [created_by_user_id], references: [id])
  provider         service_providers? @relation(fields: [provider_id], references: [id])

  data_collection_submissions data_collection_submissions[]
  metadata_snapshot           booking_metadata_snapshots?
  consultation_notes          customer_consultation_notes[]
  confirmation_tokens         booking_confirmation_tokens[]
  reminder_logs               booking_reminder_logs[]
  /// Appointment redesign phase 2 — pending/decided reschedule requests
  /// when `settings.reservations.allow_direct_reschedule === false`.
  /// Multiple requests can exist per booking; only one `pending` row
  /// at a time (enforced in service layer).
  reschedule_requests         booking_reschedule_requests[]
  proximity_notifications     proximity_notification_log[]

  @@unique([store_id, booking_number])
  @@index([store_id, date])
  @@index([store_id, status])
  @@index([store_id, product_id, product_variant_id, date])
  @@index([customer_id])
  @@index([provider_id])
  @@index([order_id])
  @@index([store_id, table_id])
}

/// Per-store business hours: the master calendar the booking flow consults
/// when computing slot availability. Overrides / supplements per-provider
/// `provider_schedules` (provider availability still wins when stricter).
model store_business_hours {
  id          Int       @id @default(autoincrement())
  store_id    Int
  /// 0 = Sunday, 6 = Saturday (matches `provider_schedules.day_of_week`).
  day_of_week Int
  start_time  String    @db.VarChar(5)
  end_time    String    @db.VarChar(5)
  is_active   Boolean   @default(true)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)

  store stores @relation(fields: [store_id], references: [id])

  @@unique([store_id, day_of_week])
  @@index([store_id])
}

/// Dedup log for `appointment_upcoming` notifications. BookingProximityJob
/// writes one row per (booking_id, proximity_minutes, channel) so the same
/// notification is never sent twice. The job checks this table before
/// emitting via `NotificationsService.createAndBroadcast`.
model proximity_notification_log {
  id                Int      @id @default(autoincrement())
  booking_id        Int
  /// One of the values in `booking_proximity_minutes` (e.g. 30, 15, 5).
  proximity_minutes Int
  /// "email" | "web_push" | "in_app" — free-form to match `NotificationsService`.
  channel           String   @db.VarChar(32)
  sent_at           DateTime @default(now()) @db.Timestamp(6)

  booking bookings @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([booking_id, proximity_minutes, channel])
  @@index([booking_id])
}

model service_providers {
  id           Int       @id @default(autoincrement())
  store_id     Int
  employee_id  Int
  is_active    Boolean   @default(true)
  display_name String?   @db.VarChar(100)
  avatar_url   String?   @db.Text
  bio          String?   @db.Text
  sort_order   Int       @default(0)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)

  store      stores                @relation(fields: [store_id], references: [id])
  employee   employees             @relation(fields: [employee_id], references: [id])
  services   provider_services[]
  schedules  provider_schedules[]
  exceptions provider_exceptions[]
  bookings   bookings[]

  @@unique([store_id, employee_id])
  @@index([store_id, is_active])
}

model provider_services {
  id          Int @id @default(autoincrement())
  provider_id Int
  product_id  Int

  provider service_providers @relation(fields: [provider_id], references: [id], onDelete: Cascade)
  product  products          @relation(fields: [product_id], references: [id])

  @@unique([provider_id, product_id])
}

model provider_schedules {
  id          Int       @id @default(autoincrement())
  provider_id Int
  day_of_week Int       @db.SmallInt
  /// Order of this block within the day (0 = first, 1 = second, etc.)
  /// Allows multiple time blocks per day (e.g., morning + afternoon)
  block_order Int       @default(0)
  start_time  String    @db.VarChar(5)
  end_time    String    @db.VarChar(5)
  is_active   Boolean   @default(true)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)

  provider service_providers @relation(fields: [provider_id], references: [id], onDelete: Cascade)

  @@unique([provider_id, day_of_week, block_order])
  @@index([provider_id, day_of_week])
}

model provider_exceptions {
  id                Int       @id @default(autoincrement())
  provider_id       Int
  date              DateTime  @db.Date
  is_unavailable    Boolean   @default(true)
  custom_start_time String?   @db.VarChar(5)
  custom_end_time   String?   @db.VarChar(5)
  reason            String?   @db.VarChar(255)
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @default(now()) @db.Timestamp(6)

  provider service_providers @relation(fields: [provider_id], references: [id], onDelete: Cascade)

  @@index([provider_id, date])
}

// ===== DISPATCH NOTES SYSTEM =====

model dispatch_notes {
  id                   Int                          @id @default(autoincrement())
  store_id             Int
  dispatch_number      String                       @db.VarChar(50)
  status               dispatch_note_status_enum    @default(draft)
  direction            dispatch_note_direction_enum @default(outbound)
  subtype              dispatch_note_subtype_enum   @default(customer_delivery)
  reason               dispatch_note_reason_enum?
  // Nullable: non-customer flows (transfer_out/in, purchase_receipt) have no
  // customer — their party lives in from_location_id/to_location_id (transfer)
  // or supplier_id (purchase_receipt). Outbound customer_delivery/customer_return
  // still require a real customer_id (enforced in the service layer).
  customer_id          Int?
  customer_name        String?                      @db.VarChar(255)
  customer_tax_id      String?                      @db.VarChar(50)
  customer_address     Json?
  sales_order_id       Int?
  invoice_id           Int?
  order_id             Int?
  supplier_id          Int?
  // Order-first receipt bridge: when a purchase_receipt remisión is created
  // from a purchase order, this links the two. The `received` event delegates
  // stock-in/FIFO/UoM/IVA/accounting to PurchaseOrdersService.receive() (the
  // canonical engine) instead of doing its own stock_in. Standalone receipts
  // (no PO) leave this null and keep the EMIT-OWN stock_in path.
  purchase_order_id    Int?
  related_dispatch_id  Int?
  from_location_id     Int?
  to_location_id       Int?
  needs_collection     Boolean?                     @default(false)
  emission_date        DateTime                     @default(now()) @db.Timestamp(6)
  agreed_delivery_date DateTime?                    @db.Timestamp(6)
  actual_delivery_date DateTime?                    @db.Timestamp(6)
  dispatch_location_id Int?
  subtotal_amount      Decimal                      @default(0) @db.Decimal(12, 2)
  discount_amount      Decimal                      @default(0) @db.Decimal(12, 2)
  tax_amount           Decimal                      @default(0) @db.Decimal(12, 2)
  shipping_cost        Decimal                      @default(0) @db.Decimal(12, 2)
  grand_total          Decimal                      @default(0) @db.Decimal(12, 2)
  currency             String?                      @db.VarChar(10)
  notes                String?                      @db.Text
  internal_notes       String?                      @db.Text
  void_reason          String?                      @db.Text
  created_by_user_id   Int?
  confirmed_by_user_id Int?
  delivered_by_user_id Int?
  voided_by_user_id    Int?
  confirmed_at         DateTime?                    @db.Timestamp(6)
  delivered_at         DateTime?                    @db.Timestamp(6)
  voided_at            DateTime?                    @db.Timestamp(6)
  created_at           DateTime?                    @default(now()) @db.Timestamp(6)
  updated_at           DateTime?                    @default(now()) @db.Timestamp(6)

  dispatch_note_items  dispatch_note_items[]
  store                stores                 @relation(fields: [store_id], references: [id], onUpdate: NoAction)
  customer             users?                 @relation("dispatch_notes_customer", fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sales_order          sales_orders?          @relation(fields: [sales_order_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  invoice              invoices?              @relation(fields: [invoice_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  order                orders?                @relation("orders_dispatch_notes", fields: [order_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  supplier             suppliers?             @relation("dispatch_notes_supplier", fields: [supplier_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  purchase_order       purchase_orders?       @relation("dispatch_notes_purchase_order", fields: [purchase_order_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  related_dispatch     dispatch_notes?        @relation("dispatch_notes_related", fields: [related_dispatch_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  related_dispatchs    dispatch_notes[]       @relation("dispatch_notes_related")
  from_location        inventory_locations?   @relation("dispatch_notes_from_location", fields: [from_location_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  to_location          inventory_locations?   @relation("dispatch_notes_to_location", fields: [to_location_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  dispatch_location    inventory_locations?   @relation("dispatch_notes_location", fields: [dispatch_location_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  created_by_user      users?                 @relation("dispatch_notes_created_by", fields: [created_by_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  confirmed_by_user    users?                 @relation("dispatch_notes_confirmed_by", fields: [confirmed_by_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  delivered_by_user    users?                 @relation("dispatch_notes_delivered_by", fields: [delivered_by_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  voided_by_user       users?                 @relation("dispatch_notes_voided_by", fields: [voided_by_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  return_orders        return_orders[]        @relation("return_orders_related_dispatch")
  dispatch_route_stops dispatch_route_stops[]

  @@unique([store_id, dispatch_number])
  @@index([store_id, status])
  @@index([customer_id])
  @@index([sales_order_id])
  @@index([invoice_id])
  @@index([store_id, order_id])
  @@index([store_id, direction, subtype])
  @@index([supplier_id])
  @@index([purchase_order_id])
  @@index([related_dispatch_id])
  @@index([from_location_id])
  @@index([to_location_id])
}

model dispatch_note_items {
  id                     Int       @id @default(autoincrement())
  dispatch_note_id       Int
  product_id             Int
  product_variant_id     Int?
  location_id            Int?
  ordered_quantity       Int       @default(0)
  dispatched_quantity    Int
  unit_price             Decimal?  @db.Decimal(12, 2)
  discount_amount        Decimal?  @default(0) @db.Decimal(12, 2)
  tax_amount             Decimal?  @default(0) @db.Decimal(12, 2)
  total_price            Decimal?  @db.Decimal(12, 2)
  cost_price             Decimal?  @db.Decimal(12, 2)
  // QUI-425 — per-line pricing overrides captured in the "Crear y recibir"
  // margin/price editor. Persisted here so the `dispatch_note.received` listener
  // can forward them to PurchaseOrdersService.receive() on PO-linked receipts.
  new_base_price         Decimal?  @db.Decimal(12, 2)
  new_profit_margin      Decimal?  @db.Decimal(5, 2)
  lot_serial             String?   @db.VarChar(100)
  sales_order_item_id    Int?
  // Exact `purchase_order_items` line this receipt line settles.
  // `CreateDispatchNoteItemDto` already accepts `purchase_order_item_id` and
  // `DispatchNotesService.createPurchaseReceipt` validates it, but before this
  // column existed the value was dropped, forcing
  // `delegatePurchaseReceiptToPurchaseOrder` to re-derive the PO line from
  // product_id + product_variant_id — which cannot disambiguate two PO lines
  // of the same product/variant. Nullable: sales dispatches and pre-existing
  // rows have no PO line, hence onDelete: SetNull (never Cascade).
  purchase_order_item_id Int?
  created_at             DateTime? @default(now()) @db.Timestamp(6)

  dispatch_note       dispatch_notes        @relation(fields: [dispatch_note_id], references: [id], onDelete: Cascade)
  product             products              @relation(fields: [product_id], references: [id], onDelete: Restrict)
  product_variant     product_variants?     @relation(fields: [product_variant_id], references: [id], onDelete: Restrict)
  location            inventory_locations?  @relation("dispatch_note_items_location", fields: [location_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  purchase_order_item purchase_order_items? @relation(fields: [purchase_order_item_id], references: [id], onDelete: SetNull)

  @@index([dispatch_note_id])
  @@index([product_id])
  @@index([sales_order_item_id])
  @@index([purchase_order_item_id])
}

// ──── Accounts Receivable (Cartera) ────────────

enum payment_agreement_state_enum {
  active
  completed
  defaulted
  cancelled
}

model accounts_receivable {
  id                Int       @id @default(autoincrement())
  store_id          Int
  organization_id   Int
  customer_id       Int
  source_type       String    @db.VarChar(50)
  source_id         Int?
  document_number   String?   @db.VarChar(100)
  original_amount   Decimal   @db.Decimal(12, 2)
  paid_amount       Decimal   @default(0.00) @db.Decimal(12, 2)
  balance           Decimal   @db.Decimal(12, 2)
  currency          String    @default("COP") @db.VarChar(10)
  issue_date        DateTime  @db.Date
  due_date          DateTime  @db.Date
  status            String    @default("open") @db.VarChar(20)
  days_overdue      Int       @default(0)
  last_payment_date DateTime? @db.Timestamp(6)
  notes             String?   @db.Text
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime  @default(now()) @db.Timestamp(6)

  stores             stores               @relation(fields: [store_id], references: [id])
  organizations      organizations        @relation(fields: [organization_id], references: [id])
  customer           users                @relation("ar_customer", fields: [customer_id], references: [id])
  ar_payments        ar_payments[]
  payment_agreements payment_agreements[]

  @@index([store_id, customer_id])
  @@index([store_id, status])
  @@index([due_date, status])
}

model ar_payments {
  id                     Int      @id @default(autoincrement())
  accounts_receivable_id Int
  payment_id             Int?
  amount                 Decimal  @db.Decimal(12, 2)
  payment_date           DateTime @db.Timestamp(6)
  payment_method         String?  @db.VarChar(50)
  reference              String?  @db.VarChar(255)
  notes                  String?  @db.Text
  created_by             Int?
  created_at             DateTime @default(now()) @db.Timestamp(6)

  accounts_receivable accounts_receivable @relation(fields: [accounts_receivable_id], references: [id])

  @@index([accounts_receivable_id])
}

model payment_agreements {
  id                     Int                          @id @default(autoincrement())
  accounts_receivable_id Int
  store_id               Int
  agreement_number       String                       @db.VarChar(50)
  total_amount           Decimal                      @db.Decimal(12, 2)
  num_installments       Int
  interest_rate          Decimal                      @default(0) @db.Decimal(5, 4)
  state                  payment_agreement_state_enum @default(active)
  start_date             DateTime                     @db.Date
  notes                  String?                      @db.Text
  created_by             Int?
  created_at             DateTime                     @default(now()) @db.Timestamp(6)
  updated_at             DateTime                     @default(now()) @db.Timestamp(6)

  stores                 stores                   @relation(fields: [store_id], references: [id])
  accounts_receivable    accounts_receivable      @relation(fields: [accounts_receivable_id], references: [id])
  agreement_installments agreement_installments[]

  @@index([accounts_receivable_id])
  @@index([store_id])
}

model agreement_installments {
  id                   Int       @id @default(autoincrement())
  payment_agreement_id Int
  installment_number   Int
  amount               Decimal   @db.Decimal(12, 2)
  due_date             DateTime  @db.Date
  state                String    @default("pending") @db.VarChar(20)
  paid_amount          Decimal   @default(0) @db.Decimal(12, 2)
  paid_at              DateTime? @db.Timestamp(6)
  created_at           DateTime  @default(now()) @db.Timestamp(6)

  payment_agreement payment_agreements @relation(fields: [payment_agreement_id], references: [id])

  @@unique([payment_agreement_id, installment_number])
  @@index([due_date, state])
}

// ──── Wallet Interna ────────────────────────

enum wallet_transaction_type_enum {
  credit
  debit
  hold
  release
}

enum wallet_transaction_state_enum {
  pending
  completed
  failed
  reversed
}

enum customer_queue_status_enum {
  waiting
  selected
  consumed
  expired
  cancelled
}

enum invoice_data_request_status_enum {
  pending
  submitted
  processing
  completed
  expired
  failed
}

model wallets {
  id              Int      @id @default(autoincrement())
  store_id        Int
  organization_id Int
  customer_id     Int
  balance         Decimal  @default(0.00) @db.Decimal(12, 2)
  held_balance    Decimal  @default(0.00) @db.Decimal(12, 2)
  currency        String   @default("COP") @db.VarChar(10)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @db.Timestamp(6)

  stores              stores                @relation("store_wallets", fields: [store_id], references: [id])
  organizations       organizations         @relation("org_wallets", fields: [organization_id], references: [id])
  customer            users                 @relation("wallet_owner", fields: [customer_id], references: [id])
  wallet_transactions wallet_transactions[]

  @@unique([store_id, customer_id])
  @@index([store_id])
}

model wallet_transactions {
  id             Int                           @id @default(autoincrement())
  wallet_id      Int
  type           wallet_transaction_type_enum
  state          wallet_transaction_state_enum @default(pending)
  amount         Decimal                       @db.Decimal(12, 2)
  balance_before Decimal                       @db.Decimal(12, 2)
  balance_after  Decimal                       @db.Decimal(12, 2)
  reference_type String?                       @db.VarChar(50)
  reference_id   Int?
  description    String?                       @db.VarChar(500)
  metadata       Json?
  created_by     Int?
  created_at     DateTime                      @default(now()) @db.Timestamp(6)

  wallet wallets @relation(fields: [wallet_id], references: [id])

  @@index([wallet_id, created_at])
  @@index([reference_type, reference_id])
}

// ──── Accounts Payable (CxP) ────────────────

model accounts_payable {
  id              Int      @id @default(autoincrement())
  organization_id Int
  store_id        Int?
  supplier_id     Int
  source_type     String   @db.VarChar(50)
  source_id       Int?
  document_number String?  @db.VarChar(100)
  original_amount Decimal  @db.Decimal(12, 2)
  paid_amount     Decimal  @default(0.00) @db.Decimal(12, 2)
  balance         Decimal  @db.Decimal(12, 2)
  currency        String   @default("COP") @db.VarChar(10)
  issue_date      DateTime @db.Date
  due_date        DateTime @db.Date
  status          String   @default("open") @db.VarChar(20)
  days_overdue    Int      @default(0)
  priority        String   @default("normal") @db.VarChar(20)
  notes           String?  @db.Text
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @db.Timestamp(6)

  organizations        organizations          @relation("org_accounts_payable", fields: [organization_id], references: [id])
  supplier             suppliers              @relation("supplier_accounts_payable", fields: [supplier_id], references: [id])
  ap_payments          ap_payments[]
  ap_payment_schedules ap_payment_schedules[]
  ap_reception_links   ap_reception_links[]

  @@index([organization_id, supplier_id])
  @@index([due_date, status])
}

model ap_payments {
  id                        Int      @id @default(autoincrement())
  accounts_payable_id       Int
  purchase_order_payment_id Int?
  amount                    Decimal  @db.Decimal(12, 2)
  payment_date              DateTime @db.Timestamp(6)
  payment_method            String   @db.VarChar(50)
  reference                 String?  @db.VarChar(255)
  bank_export_ref           String?  @db.VarChar(100)
  source                    String   @default("ap_ui")
  notes                     String?  @db.Text
  created_by                Int?
  created_at                DateTime @default(now()) @db.Timestamp(6)

  accounts_payable               accounts_payable          @relation(fields: [accounts_payable_id], references: [id])
  purchase_order_payment         purchase_order_payments?  @relation("ap_payment_po_payment", fields: [purchase_order_payment_id], references: [id])
  purchase_order_payment_mirrors purchase_order_payments[] @relation("po_payment_ap_payment")

  @@index([accounts_payable_id])
}

model ap_reception_links {
