model purchase_orders {
  id                      Int                                @id @default(autoincrement())
  organization_id         Int
  supplier_id             Int
  location_id             Int
  order_number            String                             @db.VarChar(50)
  status                  purchase_order_status_enum         @default(draft)
  /// Fase 2: primary order type (retail | ingredient). Nullable for
  /// backward compatibility — legacy orders have `null` and behave as
  /// `retail`. New orders from the POP modal always carry a value.
  order_type              purchase_order_type_enum?          @default(retail)
  order_date              DateTime?                          @default(now()) @db.Timestamp(6)
  expected_date           DateTime?                          @db.Timestamp(6)
  received_date           DateTime?                          @db.Timestamp(6)
  subtotal_amount         Decimal                            @default(0.00) @db.Decimal(12, 2)
  tax_amount              Decimal                            @default(0.00) @db.Decimal(12, 2)
  total_amount            Decimal                            @default(0.00) @db.Decimal(12, 2)
  discount_amount         Decimal                            @default(0.00) @db.Decimal(12, 2)
  shipping_cost           Decimal                            @default(0.00) @db.Decimal(12, 2)
  payment_terms           String?                            @db.VarChar(255)
  shipping_method         String?                            @db.VarChar(100)
  notes                   String?
  internal_notes          String?
  created_by_user_id      Int?
  approved_by_user_id     Int?
  created_at              DateTime?                          @default(now()) @db.Timestamp(6)
  updated_at              DateTime?                          @default(now()) @db.Timestamp(6)
  payment_status          purchase_order_payment_status_enum @default(unpaid)
  payment_due_date        DateTime?                          @db.Timestamp(6)
  /// QUI-647 — modo de pago acordado al crear la orden:
  /// `immediate` | `partial` | `deferred` | `installments`.
  /// NULL en órdenes anteriores al ticket, que se comportan como el checkbox
  /// binario `ackPay` que existía antes.
  payment_plan            String?                            @db.VarChar(20)
  /// Monto abonado en el acto cuando `payment_plan = 'partial'`.
  down_payment_amount     Decimal?                           @default(0.00) @db.Decimal(12, 2)
  /// F1 IVA lifecycle: dominant tax mode for the whole invoice. When true,
  /// line `unit_price` is understood as tax-INCLUSIVE (gross); when false the
  /// tax is ADDED on top. Individual lines may override via
  /// `purchase_order_items.prices_include_tax` to support mixed invoices.
  prices_include_tax      Boolean                            @default(false)
  /// F2 IVA lifecycle: supplier's own invoice reference for the purchase.
  /// `supplier_invoice_number` becomes the `invoice_number` of the fiscal
  /// document materialized to recognize the deductible VAT (240804). When the
  /// supplier number is absent the recognition falls back to `order_number`.
  supplier_invoice_number String?                            @db.VarChar(50)
  supplier_invoice_date   DateTime?                          @db.Date
  /// CP-PURCHASE-TRANSPARENCY C.1 — qué se hizo con el flete de esta orden:
  /// `prorate` lo reparte entre las líneas (y por tanto entra al costo del
  /// inventario) o `expense` lo manda a gasto del período y NO toca el costo.
  /// NULLABLE a propósito: las órdenes anteriores al ticket nunca tomaron esta
  /// decisión y no se les inventa una — un default silencioso reescribiría a
  /// posteriori la intención del operador que las creó. Guardada como VarChar
  /// con un CHECK, calcando `payment_plan` (misma tabla, misma forma: una
  /// decisión enumerada que no justifica un tipo enum de Postgres).
  /// El monto sigue viviendo en `shipping_cost`, que ya existía.
  shipping_cost_allocation String?                           @db.VarChar(20)
  /// CP-PURCHASE-TRANSPARENCY C.10 — vista previa que el operador aprobó y de
  /// la que salió esta orden. Hoy no existe nada que permita demostrar a
  /// posteriori que la cifra aprobada es la que se selló.
  preview_id              String?                            @db.Uuid
  purchase_order_items    purchase_order_items[]
  users                   users?                             @relation("purchase_orders_approved_by", fields: [approved_by_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  users1                  users?                             @relation("purchase_orders_created_by", fields: [created_by_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  location                inventory_locations                @relation(fields: [location_id], references: [id], onUpdate: NoAction)
  organizations           organizations                      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  suppliers               suppliers                          @relation(fields: [supplier_id], references: [id], onUpdate: NoAction)
  inventory_cost_layers   inventory_cost_layers[]
  attachments             purchase_order_attachments[]
  payments                purchase_order_payments[]
  payment_schedules       purchase_order_payment_schedules[]
  receptions              purchase_order_receptions[]
  dispatch_notes          dispatch_notes[]                   @relation("dispatch_notes_purchase_order")

  @@unique([organization_id, order_number])
}

model purchase_order_items {
  id                     Int                              @id @default(autoincrement())
  purchase_order_id      Int
  product_id             Int
  product_variant_id     Int?
  quantity_ordered       Int
  quantity_received      Int                              @default(0)
  unit_cost              Decimal?                         @db.Decimal(12, 4)
  total_cost             Decimal?                         @db.Decimal(12, 2)
  /// F1 IVA lifecycle — VAT capture per line.
  /// `tax_rate`        : percentage (e.g. 19 for 19%).
  /// `tax_type`        : fiscal classification, defaults to iva.
  /// `prices_include_tax`: per-line override of the header mode (mixed invoices).
  /// `unit_price_net`  : the NET unit price (single source of truth for cost).
  /// `tax_amount`      : total VAT captured for the line (per-unit tax × qty).
  /// `deductible_tax_amount`  : VAT sealed as descontable (O-48 responsible).
  /// `capitalized_tax_amount` : VAT sealed into inventory cost (O-49 non-responsible).
  tax_rate               Decimal?                         @db.Decimal(5, 2)
  tax_type               tax_type_enum?                   @default(iva)
  prices_include_tax     Boolean?
  /// QUI-661 commercial discount granted by the supplier ON THIS LINE.
  /// `discount_percentage` is what the user typed when the deal is percentual;
  /// `discount_amount` is the RESOLVED money figure and the single source of
  /// truth for the calculation (the percentage is kept only to reproduce how
  /// the number was reached). The discount is subtracted from the gross unit
  /// price BEFORE the VAT is derived, so it lowers the taxable base, the
  /// deductible VAT and the cost capitalized into the inventory layers.
  /// A header-level discount (`purchase_orders.discount_amount`) is prorated
  /// into these same columns at write time — it never stays in the header,
  /// because FIFO cost layers are written per line and a header-only figure
  /// has no way to reach the product's cost.
  discount_percentage    Decimal?                         @default(0) @db.Decimal(5, 2)
  discount_amount        Decimal?                         @default(0) @db.Decimal(12, 2)
  /// CP-PURCHASE-TRANSPARENCY C.1 — porción del flete de la cabecera que
  /// aterrizó en ESTA línea cuando `purchase_orders.shipping_cost_allocation
  /// = 'prorate'`. Cero cuando el flete se mandó a gasto o cuando la orden es
  /// anterior al ticket.
  /// NOT NULL DEFAULT 0 a propósito: un nulo obligaría a cada consumidor
  /// (costeo, capas FIFO, reportes) a decidir qué significa, y ya sabemos que
  /// significa cero.
  /// Decimal(12,2) — NO (12,4): es un monto de LÍNEA, no un precio unitario.
  /// En esta tabla los (12,4) son unitarios (`unit_cost`, `unit_price_net`) y
  /// los montos de línea son (12,2) (`total_cost`, `discount_amount`,
  /// `tax_amount`). Además su origen, `purchase_orders.shipping_cost`, es
  /// (12,2): con dos decimales el prorrateo por mayor-residuo suma EXACTO al
  /// flete de la cabecera, mientras que guardar cuatro fabricaría un total que
  /// no cuadra al mostrarse redondeado.
  allocated_shipping_amount Decimal                       @default(0) @db.Decimal(12, 2)
  unit_price_net         Decimal?                         @db.Decimal(12, 4)
  tax_amount             Decimal?                         @db.Decimal(12, 2)
  deductible_tax_amount  Decimal?                         @db.Decimal(12, 2)
  capitalized_tax_amount Decimal?                         @db.Decimal(12, 2)
  /// Fase 2: UoM FKs the receiving engine uses to derive the
  /// `purchase_to_stock_factor` for ingredient orders. Optional because
  /// retail orders keep factor=1 and do not need them. When
  /// `purchase_orders.order_type = 'ingredient'`, both FKs SHOULD be set;
  /// the receive() flow validates this.
  purchase_uom_id        Int?
  stock_uom_id           Int?
  notes                  String?
  batch_number           String?                          @db.VarChar(100)
  manufacturing_date     DateTime?                        @db.Timestamp(6)
  expiration_date        DateTime?                        @db.Timestamp(6)
  created_at             DateTime?                        @default(now()) @db.Timestamp(6)
  products               products                         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_variants       product_variants?                @relation(fields: [product_variant_id], references: [id], onDelete: Cascade)
  purchase_orders        purchase_orders                  @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade)
  reception_items        purchase_order_reception_items[]
  dispatch_note_items    dispatch_note_items[]
  inventory_cost_layers  inventory_cost_layers[]

  @@index([purchase_order_id])
  @@index([product_id, purchase_order_id])
}

