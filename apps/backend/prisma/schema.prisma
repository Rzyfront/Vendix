// Como los demás modelos de membresía, usa store_id escalar (la FK vive en SQL;
// Prisma ignora la FK escalar — ver migración membership_generalization §9).
model membership_access_occupancy {
  id              Int       @id @default(autoincrement())
  store_id        Int       @unique
  current_count   Int       @default(0)
  business_date   DateTime? @db.Date
  last_leveled_at DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
}

