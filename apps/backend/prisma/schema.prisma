/// @prisma-ignore: per-entity uniqueness via partial unique indexes (see migration 20260511170000_chart_of_accounts_per_entity_uniqueness)
model chart_of_accounts {
  id                   Int                 @id @default(autoincrement())
  organization_id      Int
  accounting_entity_id Int?
  code                 String              @db.VarChar(20)
  name                 String              @db.VarChar(255)
  account_type         account_type_enum
  nature               account_nature_enum
  parent_id            Int?
  level                Int                 @default(1)
  is_active            Boolean             @default(true)
  accepts_entries      Boolean             @default(false)
  is_intercompany      Boolean             @default(false)
  created_at           DateTime?           @default(now()) @db.Timestamp(6)
  updated_at           DateTime?           @default(now()) @db.Timestamp(6)

  organization                organizations                 @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  accounting_entity           accounting_entities?          @relation(fields: [accounting_entity_id], references: [id], onDelete: SetNull)
  parent                      chart_of_accounts?            @relation("chart_of_accounts_parent", fields: [parent_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  children                    chart_of_accounts[]           @relation("chart_of_accounts_parent")
  accounting_entry_lines      accounting_entry_lines[]
  accounting_account_mappings accounting_account_mappings[]
  bank_accounts               bank_accounts[]
  budget_lines                budget_lines[]
  intercompany_transactions   intercompany_transactions[]
  consolidation_adjustments   consolidation_adjustments[]

  @@index([organization_id, parent_id])
  @@index([organization_id, account_type])
  @@index([accounting_entity_id, code])
  @@index([accounting_entity_id])
}

model accounting_account_mappings {
  id                   Int       @id @default(autoincrement())
  organization_id      Int
  store_id             Int?
  accounting_entity_id Int?
  mapping_key          String    @db.VarChar(100)
  account_id           Int
  is_active            Boolean   @default(true)
  created_at           DateTime? @default(now()) @db.Timestamp(6)
  updated_at           DateTime? @default(now()) @db.Timestamp(6)

  organization      organizations        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  store             stores?              @relation(fields: [store_id], references: [id], onDelete: Cascade)
  accounting_entity accounting_entities? @relation(fields: [accounting_entity_id], references: [id], onDelete: SetNull)
  account           chart_of_accounts    @relation(fields: [account_id], references: [id], onDelete: Restrict)

  @@unique([organization_id, store_id, mapping_key])
  @@index([organization_id, store_id])
  @@index([accounting_entity_id])
}

model fiscal_periods {
  id                   Int                       @id @default(autoincrement())
  organization_id      Int
  accounting_entity_id Int?
  name                 String                    @db.VarChar(50)
  start_date           DateTime                  @db.Timestamp(6)
  end_date             DateTime                  @db.Timestamp(6)
  status               fiscal_period_status_enum @default(open)
  closed_by_user_id    Int?
  closed_at            DateTime?                 @db.Timestamp(6)
  created_at           DateTime?                 @default(now()) @db.Timestamp(6)
  updated_at           DateTime?                 @default(now()) @db.Timestamp(6)

  organization           organizations            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  accounting_entity      accounting_entities?     @relation(fields: [accounting_entity_id], references: [id], onDelete: SetNull)
  closed_by_user         users?                   @relation("fiscal_periods_closed_by", fields: [closed_by_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  accounting_entries     accounting_entries[]
  budgets                budgets[]
  consolidation_sessions consolidation_sessions[]
  fiscal_close_sessions  fiscal_close_sessions[]

  @@index([organization_id, name])
  @@index([accounting_entity_id])
}

model accounting_entries {
  id                         Int                          @id @default(autoincrement())
  organization_id            Int
  store_id                   Int?
  accounting_entity_id       Int?
  entry_number               String                       @db.VarChar(50)
  entry_type                 accounting_entry_type_enum   @default(manual)
  status                     accounting_entry_status_enum @default(draft)
  fiscal_period_id           Int
  entry_date                 DateTime                     @db.Timestamp(6)
  description                String?                      @db.VarChar(500)
  source_type                String?                      @db.VarChar(50)
  source_id                  Int?
  total_debit                Decimal                      @default(0) @db.Decimal(12, 2)
  total_credit               Decimal                      @default(0) @db.Decimal(12, 2)
  created_by_user_id         Int?
  posted_by_user_id          Int?
  posted_at                  DateTime?                    @db.Timestamp(6)
  created_at                 DateTime?                    @default(now()) @db.Timestamp(6)
  updated_at                 DateTime?                    @default(now()) @db.Timestamp(6)
  is_historical_consolidated Boolean                      @default(false)

  organization                organizations                 @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  store                       stores?                       @relation(fields: [store_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  accounting_entity           accounting_entities?          @relation(fields: [accounting_entity_id], references: [id], onDelete: SetNull)
  fiscal_period               fiscal_periods                @relation(fields: [fiscal_period_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  created_by_user             users?                        @relation("accounting_entries_created_by", fields: [created_by_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  posted_by_user              users?                        @relation("accounting_entries_posted_by", fields: [posted_by_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  accounting_entry_lines      accounting_entry_lines[]
  invoices                    invoices[]
  payroll_runs                payroll_runs[]
  bank_reconciliation_matches bank_reconciliation_matches[]
  depreciation_entries        depreciation_entries[]        @relation("depreciation_accounting_entry")
  intercompany_entries        intercompany_transactions[]   @relation("ic_entry")
  intercompany_counterparts   intercompany_transactions[]   @relation("ic_counterpart")
  payroll_settlements         payroll_settlements[]
  vendor_documents_approved   vendor_support_documents[]    @relation("vendor_doc_approved_entry")
  vendor_documents_paid       vendor_support_documents[]    @relation("vendor_doc_paid_entry")

  @@index([organization_id, entry_date])
  @@index([organization_id, fiscal_period_id])
  @@index([accounting_entity_id, entry_number])
  @@index([accounting_entity_id])
  @@index([source_type, source_id])
  @@index([organization_id, source_type, source_id, accounting_entity_id])
  @@index([organization_id, is_historical_consolidated])
}

/// Cola de observabilidad de asientos automáticos fallidos. Cuando
/// `AutoEntryService.createAutoEntry` lanza (mapping/cuenta faltante, período
/// cerrado, error de BD), en vez de tragarse el error se persiste aquí el
/// evento crudo + el error y se encola un reintento (cola BullMQ
/// `accounting-entry-retry`). Sin relaciones a `organizations`/`stores` a
/// propósito: es una bitácora operativa, no un modelo de negocio.
model accounting_entry_failures {
  id              Int       @id @default(autoincrement())
  organization_id Int
  store_id        Int?
  handler_key     String    @db.VarChar(80)
  source_type     String?   @db.VarChar(50)
  source_id       Int?
  event_payload   Json
  error_message   String    @db.Text
  attempt_count   Int       @default(1)
  resolved_at     DateTime? @db.Timestamp(6)
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  updated_at      DateTime  @updatedAt @db.Timestamp(6)

  @@index([organization_id, resolved_at])
  @@index([source_type, source_id])
}

model accounting_entry_lines {
  id                 Int       @id @default(autoincrement())
  entry_id           Int
  account_id         Int
  description        String?   @db.VarChar(500)
  debit_amount       Decimal   @default(0) @db.Decimal(12, 2)
  credit_amount      Decimal   @default(0) @db.Decimal(12, 2)
  third_party_id     Int?
  third_party_type   String?   @db.VarChar(40)
  third_party_name   String?   @db.VarChar(255)
  third_party_tax_id String?   @db.VarChar(50)
  created_at         DateTime? @default(now()) @db.Timestamp(6)

  entry   accounting_entries @relation(fields: [entry_id], references: [id], onDelete: Cascade)
  account chart_of_accounts  @relation(fields: [account_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([entry_id])
  @@index([account_id])
  @@index([third_party_tax_id], map: "accounting_entry_lines_third_party_tax_id_idx")
  @@index([third_party_type, third_party_id], map: "accounting_entry_lines_third_party_lookup_idx")
}

