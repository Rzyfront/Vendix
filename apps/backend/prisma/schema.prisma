// ===== PROMOTIONS =====

model promotions {
  id                  Int                              @id @default(autoincrement())
  store_id            Int
  name                String                           @db.VarChar(255)
  description         String?
  code                String?                          @db.VarChar(50)
  type                promotion_type_enum
  value               Decimal                          @db.Decimal(12, 2)
  rule_type           promotion_rule_type_enum         @default(flat)
  scope               promotion_scope_enum             @default(order)
  // For quantity_tiered rules, how quantities are counted toward tiers.
  //   cart_total: sums units across every line in scope (legacy behavior).
  //   per_product: each SKU is evaluated independently; tier fires only when
  //                a single product reaches min_quantity on its own.
  // Default 'cart_total' preserves existing promotion semantics.
  quantity_grouping   promotion_quantity_grouping_enum @default(cart_total)
  min_purchase_amount Decimal?                         @db.Decimal(12, 2)
  max_discount_amount Decimal?                         @db.Decimal(12, 2)
  usage_limit         Int?
  usage_count         Int                              @default(0)
  per_customer_limit  Int?
  start_date          DateTime                         @db.Timestamp(6)
  end_date            DateTime?                        @db.Timestamp(6)
  state               promotion_state_enum             @default(draft)
  is_auto_apply       Boolean                          @default(false)
  priority            Int                              @default(0)
  created_at          DateTime?                        @default(now()) @db.Timestamp(6)
  updated_at          DateTime?                        @default(now()) @db.Timestamp(6)

  stores                   stores                     @relation(fields: [store_id], references: [id], onUpdate: NoAction)
  promotion_products       promotion_products[]
  promotion_categories     promotion_categories[]
  promotion_quantity_tiers promotion_quantity_tiers[]
  order_promotions         order_promotions[]

  @@unique([store_id, code])
  @@index([store_id, state])
  @@index([store_id, start_date, end_date])
}

model promotion_quantity_tiers {
  id           Int                 @id @default(autoincrement())
  promotion_id Int
  min_quantity Int
  max_quantity Int?
  type         promotion_type_enum
  value        Decimal             @db.Decimal(12, 2)
  sort_order   Int                 @default(0)
  promotions   promotions          @relation(fields: [promotion_id], references: [id], onDelete: Cascade)

  @@unique([promotion_id, min_quantity])
  @@index([promotion_id])
}

model promotion_products {
  id           Int        @id @default(autoincrement())
  promotion_id Int
  product_id   Int
  promotions   promotions @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
  products     products   @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([promotion_id, product_id])
}

model promotion_categories {
  id           Int        @id @default(autoincrement())
  promotion_id Int
  category_id  Int
  promotions   promotions @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
  categories   categories @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([promotion_id, category_id])
}

model order_promotions {
  id              Int        @id @default(autoincrement())
  order_id        Int
  promotion_id    Int
  customer_id     Int?
  discount_amount Decimal    @db.Decimal(12, 2)
  created_at      DateTime?  @default(now()) @db.Timestamp(6)
  orders          orders     @relation(fields: [order_id], references: [id], onDelete: Cascade)
  promotions      promotions @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
  customers       users?     @relation("order_promotions_customer", fields: [customer_id], references: [id], onDelete: SetNull)

  @@unique([order_id, promotion_id])
  @@index([promotion_id, customer_id])
}

// ===== PROMOTIONS =====

enum promotion_state_enum {
  draft
  scheduled
  active
  paused
  expired
  cancelled
}

enum promotion_type_enum {
  percentage
  fixed_amount
}

enum promotion_rule_type_enum {
  flat
  quantity_tiered
}

enum promotion_scope_enum {
