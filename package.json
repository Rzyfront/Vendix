{
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "engines": {
    "node": "^20.19 || ^22.12 || ^24"
  },
  "scripts": {
    "// ----- WORKSPACES -----": "",
    "install:all": "npm install -ws",
    "// ----- DEVELOPMENT -----": "",
    "dev": "npm run start:dev -w apps/backend & npm run start -w apps/frontend",
    "// dev:fe — ng serve NATIVO en macOS. El frontend ya no vive en Docker: nginx (contenedor) proxya vendix.com hacia host.docker.internal:4200. Sin cgroup el heap puede crecer, y sin VirtioFS el watch usa FSEvents en vez de --poll.": "",
    "predev:fe": "node scripts/check-node-version.js",
    "predev:fe:lite": "node scripts/check-node-version.js",
    "dev:fe": "NODE_OPTIONS=\"--max-old-space-size=6144 --max-semi-space-size=64\" NG_BUILD_MAX_WORKERS=4 npm run start -w apps/frontend",
    "// dev:fe:lite — misma cosa con presupuesto recortado, para cuando corras algo pesado en paralelo (buildcheck, tests, otro agente).": "",
    "dev:fe:lite": "NODE_OPTIONS=\"--max-old-space-size=3072\" NG_BUILD_MAX_WORKERS=2 npm run start -w apps/frontend",
    "mobile:start": "npm run start -w apps/mobile",
    "mobile:ios": "npm run ios -w apps/mobile",
    "mobile:android": "npm run android -w apps/mobile",
    "mobile:web": "npm run web -w apps/mobile",
    "// ----- BUILD -----": "",
    "// [print-editor-dsk P1.6] Copia libs/print-formats/schemas/page-geometry.json byte-a-byte a las 3 copias locales (backend/frontend/mobile). Se ejecuta via prebuild antes de cualquier build; los shims de cada app importan su copia local, sin este sync los 3 apps divergen silenciosamente.": "",
    "sync:geometry": "ts-node scripts/sync-print-geometry.ts",
    "prebuild": "npm run sync:geometry",
    "build": "npm run build -w apps/backend && npm run build:prod -w apps/frontend",
    "// ----- BUILDCHECK (compila y muere: sin servidores, sin huérfanos) -----": "",
    "buildcheck": "bash scripts/buildcheck.sh",
    "buildcheck:be": "bash scripts/buildcheck.sh --backend",
    "buildcheck:fe": "bash scripts/buildcheck.sh --frontend",
    "buildcheck:deep": "bash scripts/buildcheck.sh --all --deep",
    "buildcheck:test": "bash scripts/buildcheck.sh --test",
    "buildcheck:reap": "bash scripts/buildcheck.sh --reap",
    "buildcheck:top": "bash scripts/buildcheck.sh --top",
    "// ----- CODE QUALITY -----": "",
    "lint": "npm run lint -ws",
    "format": "npm run format -ws",
    "zoneless:audit": "bash apps/frontend/scripts/zoneless-audit.sh",
    "tz:audit": "bash scripts/tz-audit.sh",
    "state-refresh:audit": "bash scripts/state-refresh-audit.sh",
    "industries:audit": "bash scripts/industry-parity-audit.sh",
    "symbols:audit": "node scripts/assert-imported-symbols.js",
    "dian:ubl-model": "node scripts/generate-dian-ubl-content-model.js",
    "dian:catalogs": "node scripts/generate-dian-catalogs.js",
    "dian:catalogs:check": "node scripts/generate-dian-catalogs.js --check",
    "// ----- DATABASE (Backend) -----": "",
    "db:reset-seed": "npm run db:reset -w apps/backend && npm run db:seed -w apps/backend",
    "// ----- DOCKER -----": "",
    "docker:up": "docker compose up -d",
    "docker:rebuild": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:down-v": "docker compose down --volumes"
  },
  "devDependencies": {
    "babel-plugin-module-resolver": "^5.0.3",
    "prettier": "^3.4.2"
  },
  "dependencies": {
    "@shopify/react-native-skia": "^2.6.2"
  }
}
