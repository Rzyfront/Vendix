# Core dumps (files only, not directories)
core
!core/
*.core

# Node
node_modules/
dist/
.env*
# Los .env.example son plantillas SIN secretos reales (flags + placeholders):
# se trackean para documentar variables requeridas (p.ej. REFRESH_TOKEN_HMAC_SECRET).
!.env.example
!**/.env.example
.DS_Store
npm-debug.log
# Docker
*.local
*.pid
*.seed
# VSCode
.vscode/
# Certificados locales
certs/
ssl/ca/
ssl/certs/
ssl/private/
ssl/cert.conf
# OS
Thumbs.db
*:Zone.Identifier

# Audit / report outputs (regenerated by scripts in repo)
.audit-*.json
# Documentation
docs/
.claude/
.agent/
.opencode/
# Engram: ignore local DB, but keep sync chunks (shared with the team)
.engram/*
!.engram/chunks/
!.engram/manifest.json
!.engram/.gitkeep
# Production keys and sensitive docs
keys/
vendix-production-key.pem
*_PRODUCTION_INFO.md
MIGRATION_COMPLETE.md
GITHUB_SECRET_INSTRUCTIONS.txt
# Linear dev cache (UUIDs, no secrets — but per-dev)
.linear/config.json
# Local-only planning and output artifacts
/plans/
/outputs/

# Local dev artifacts (scripts, screenshots de referencia, etc.)
# No deben commitearse — son temporales del dev local.
/capturar-pantalla.js
/referencia-*.png

# Playwright MCP session artifacts (snapshots, console, network logs)
.playwright-mcp/

# Compose override local. Es el nombre reservado que Compose fusiona solo, sin
# flag ni opt-in, así que commitearlo cambia el arranque de todo el equipo.
# Para compartir una variante usar `docker-compose.no-watch.yml` con -f.
docker-compose.override.yml

# Capturas de verificación local (QA, screenshots de referencia). El patrón es
# la raíz completa, no sólo `vendix-*`: no hay ningún PNG legítimo trackeado en
# la raíz del repo, y las capturas suelo dejarlas ahí sueltas, donde un
# `git add -A` las barre sin que nadie las note.
/*.png
apps/mobile/.captures/

# buildcheck logs (compile gate, scripts/buildcheck.sh)
.buildcheck/
test-results/

# Respaldos de saneamiento de datos (scripts/writeoff-*, backfills).
# Contienen una fotografía de datos productivos — nombre y SKU de producto,
# cantidades, costos y nombre de la organización — y el script los escribe
# ANTES de mover nada, así que existen justo cuando alguien va a commitear.
apps/backend/scripts/backups/

# El repo usa npm (package-lock.json). Estos archivos aparecen solo cuando
# alguien corre pnpm por error; versionarlos daria dos lockfiles en conflicto.
pnpm-lock.yaml
pnpm-workspace.yaml

# Bitácora acotada del `ng serve` nativo (scripts/dev-fe.sh). Se reescribe en
# cada ciclo de compilación; nunca crece. La lee `buildcheck.sh --watch`.
.dev/
